---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import { Image } from 'astro:assets';
import AeoSummary from '../components/AeoSummary.astro';
// Correct image path might be needed, assuming assets alias or relative path
import alexMorganImg from '../assets/images/alex-morgan.png'; 
import '../styles/blog-styles.css';

const { frontmatter } = Astro.props;
const { title, description, publishDate, author = "Alex Morgan", category, categoryUrl, readTime, toc = [], aeoSummary } = frontmatter;

// Fetch related articles
const allPosts = await getCollection('blog');
const relatedPosts = allPosts
    .filter(post => post.slug !== Astro.props.slug) // Use Astro.props.slug or pass slug in props
    .sort(() => Math.random() - 0.5)
    .slice(0, 3);
const articleSchema = {
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": title,
  "description": description,
  "datePublished": publishDate,
  "author": {
    "@type": "Person",
    "name": author,
    "url": "https://menspostdivorcecoaching.com/about"
  },
  "publisher": {
    "@type": "Organization",
    "name": "Men's Post-Divorce Coaching",
    "logo": {
      "@type": "ImageObject",
      "url": "https://menspostdivorcecoaching.com/images/social-preview.png"
    }
  },
  "mainEntityOfPage": {
    "@type": "WebPage",
    "@id": "https://menspostdivorcecoaching.com"
  },
  "image": {
    "@type": "ImageObject",
    "url": `https://menspostdivorcecoaching.com${frontmatter.image || "/images/blog/rebuild-life.png"}`
  },
  "abstract": aeoSummary
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [{
    "@type": "Question",
    "name": `How do you handle ${title}?`,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": aeoSummary
    }
  }]
};
---

<Layout title={`${title} | Men's Post-Divorce Coaching`} bodyClass="blog-page">
    <meta slot="head" content={description} name="description" />
    <script type="application/ld+json" slot="head" set:html={JSON.stringify(articleSchema)} />
    {aeoSummary && <script type="application/ld+json" slot="head" set:html={JSON.stringify(faqSchema)} />}

    <article class="blog-article">
        <header class="article-header split-hero">
            <div class="header-container">
                <div class="hero-content">
                    <div class="breadcrumb">
                        <a href="/learn">Resources</a> / <a href={categoryUrl}>{category}</a>
                    </div>
                    <h1>{title}</h1>
                    <p class="article-subtitle">{description}</p>

                    <div class="article-meta">
                        <div class="author-info">
                            <Image src={alexMorganImg} alt="Alex Morgan" width={100} height={100} class="author-avatar-small" style="width: 40px; height: 40px; border-radius: 50%; margin-right: 12px; border: 2px solid var(--color-accent);" />
                            <div>
                                <p class="author-name">By {author}</p>
                                <p class="publish-date">{publishDate} • {readTime}</p>
                            </div>
                        </div>
                        <div class="share-container">
                            <button class="share-btn">Share</button>
                        </div>
                    </div>
                </div>
                <div class="hero-image-side">
                    <Image 
                        src={frontmatter.image || "/images/blog/rebuild-life.png"} 
                        alt={title} 
                        width={600}
                        height={400}
                        class="hero-img-optimized"
                        loading="eager"
                        fetchpriority="high"
                    />
                </div>
            </div>
        </header>

        <div class="three-column-layout">
            <!-- Left Sidebar: Table of Contents -->
            <aside class="left-sidebar">
                <div class="toc-sticky">
                    <h3>Table of Contents</h3>
                    <div id="toc-container">
                        {toc.length > 0 ? (
                            <ul>
                                {toc.map((item) => (
                                    <li><a href={item.url}>{item.text}</a></li>
                                ))}
                            </ul>
                        ) : (
                            <p style="font-size: 0.8rem; color: var(--color-text-muted);">Guide contents below</p>
                        )}
                    </div>
                </div>
            </aside>

            <!-- Center Column: Article Content -->
            <div class="article-content">
                {aeoSummary && <AeoSummary text={aeoSummary} />}
                <slot />

                <div class="final-thoughts-spacer" style="margin-top: 4rem;"></div>

                <div class="cta-box">
                    <h3>Ready to Start Your Comeback?</h3>
                    <p>Get instant access to the Men's Divorce Mindset System—a proven 5-step framework to break the replay loop and rebuild your life.</p>
                    <a href="/join" class="cta-button">Get Started Now →</a>
                    <p class="cta-subtext">Instant Access • 100% Private</p>
                </div>
            </div>

            <!-- Right Sidebar: Author Bio & Sticky CTA -->
            <aside class="right-sidebar">
                <div class="sidebar-card author-bio-card">
                    <Image src={alexMorganImg} alt="Alex Morgan" width={120} height={120} class="author-bio-avatar" />
                    <h4>{author}</h4>
                    <p class="author-title">Co-Founder</p>
                    <p class="author-bio">Alex helps divorced men rebuild their confidence, purpose, and direction through proven frameworks and personalized coaching.</p>
                </div>

                <div class="sidebar-card sidebar-cta-card">
                    <h4>Start Your Comeback Today</h4>
                    <p>Get the Men's Divorce Mindset System—a proven 5-step framework to break the replay loop.</p>
                    <a href="/join" class="sidebar-cta-button" style="display: block; text-align: center; text-decoration: none;">GET STARTED</a>
                    <p class="sidebar-privacy">100% Private.</p>
                </div>
            </aside>
        </div>
    </article>

    <!-- Related Articles -->
    <section class="related-articles">
        <div class="related-container">
            <h2>Related Articles</h2>
            <div class="related-grid">
                {relatedPosts.map(post => (
                    <article class="related-card">
                        <div class="related-image">
                            <Image 
                                src={post.data.image || "/images/default-post.jpg"} 
                                alt={post.data.title}
                                width={300}
                                height={200}
                            />
                        </div>
                        <div class="related-content">
                            <h3>{post.data.title}</h3>
                            <p>{post.data.description.length > 120 ? post.data.description.substring(0, 120) + '...' : post.data.description}</p>
                            <a href={`/learn/${post.slug}`}>Read More →</a>
                        </div>
                    </article>
                ))}
            </div>
        </div>
    </section>
</Layout>
