---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/style.css';
import '../styles/nav.css';
import '../styles/mega-menu.css';
import '../styles/footer.css';
import '../styles/cookie.css';
import SEO from '../components/SEO.astro';

const { title = "Men's Post-Divorce Coaching - Rebuild Your Life", simpleHeader = false, simpleFooter = false, bodyClass = "" } = Astro.props;

// Conditionally load blog styles if on a blog page
if (bodyClass && bodyClass.includes('blog-page')) {
    import('../styles/blog-styles.css');
}
---

<!DOCTYPE html>
<html lang="en">

<head>
    <meta name="p:domain_verify" content="57dd46a805327939488e827ea7d046dd"/>
    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-T26PKTMJB1"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
    
      gtag('config', 'G-T26PKTMJB1');
    </script>
    <SEO title={title} description="Men's Post-Divorce Coaching - Rebuild Your Life" />

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link
        href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600;700;800;900&family=Open+Sans:wght@400;600;700&family=Bebas+Neue&display=swap"
        rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <slot name="head" />
</head>

<body class={bodyClass}>
    {!simpleHeader && <Header />}
    <slot />
    {!simpleFooter && <Footer />}
    
    <!-- Mobile Menu Script -->
    <script is:inline>
        const mobileToggle = document.getElementById('mobile-toggle');
        const mobileMenu = document.getElementById('mobile-menu');
        if(mobileToggle && mobileMenu){
            mobileToggle.addEventListener('click', () => {
                mobileToggle.classList.toggle('active');
                mobileMenu.classList.toggle('active');
            });
        }
    </script>
</body>
</html>
