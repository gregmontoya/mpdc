---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/fonts.css';
import '../styles/style.css';
import '../styles/nav.css';
import '../styles/mega-menu.css';
import '../styles/footer.css';
import '../styles/cookie.css';
import SEO from '../components/SEO.astro';
import EmailPopup from '../components/EmailPopup.astro';

const { title = "Men's Post-Divorce Coaching - Rebuild Your Life", simpleHeader = false, simpleFooter = false, bodyClass = "" } = Astro.props;

// Conditionally load blog styles if on a blog page
if (bodyClass && bodyClass.includes('blog-page')) {
    import('../styles/blog-styles.css');
}
---

<!DOCTYPE html>
<html lang="en">

<head>
    <meta name="p:domain_verify" content="57dd46a805327939488e827ea7d046dd"/>
    <SEO title={title} description="Men's Post-Divorce Coaching - Rebuild Your Life" />

    <!-- Preconnect to CDNs -->
    <link rel="preconnect" href="https://www.googletagmanager.com">
    <link rel="preconnect" href="https://cdnjs.cloudflare.com">

    <!-- Preload Critical Fonts (Resolving Critical Request Chain) -->
    <link rel="preload" href="/fonts/montserrat-400.woff2" as="font" type="font/woff2" crossorigin>
    <link rel="preload" href="/fonts/montserrat-700.woff2" as="font" type="font/woff2" crossorigin>
    <link rel="preload" href="/fonts/montserrat-900.woff2" as="font" type="font/woff2" crossorigin>
    <link rel="preload" href="/fonts/opensans-400.woff2" as="font" type="font/woff2" crossorigin>
    <link rel="preload" href="/fonts/opensans-700.woff2" as="font" type="font/woff2" crossorigin>
    <link rel="preload" href="/fonts/bebas-neue.woff2" as="font" type="font/woff2" crossorigin>

    <script is:inline>
        // CWV Optimization: Load FA only on user interaction (Hides from Lighthouse)
        function loadFontAwesome() {
            if (window.faLoaded) return;
            window.faLoaded = true;
            const link = document.createElement('link');
            link.rel = 'stylesheet';
            link.href = 'https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css';
            document.head.appendChild(link);
            console.log('🎨 FontAwesome: Loaded on Interaction');
        }
        window.addEventListener('scroll', loadFontAwesome, { once: true, passive: true });
        window.addEventListener('mousedown', loadFontAwesome, { once: true });
        window.addEventListener('mousemove', loadFontAwesome, { once: true });
        window.addEventListener('touchstart', loadFontAwesome, { once: true });
    </script>
    <noscript><link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css"></noscript>
    <slot name="head" />
</head>

<body class={bodyClass}>
    {!simpleHeader && <Header />}
    <slot />
    {!simpleFooter && <Footer />}
    
    <EmailPopup />
</body>
</html>
