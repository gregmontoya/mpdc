---
import { ViewTransitions } from 'astro:transitions';

import SEO from '../components/SEO.astro';
import EmailPopup from '../components/EmailPopup.astro';

import '../styles/fonts.css';
const { title = "Men's Post-Divorce Coaching", description = "Rebuild Your Life & Reclaim Your Identity." } = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
<head>
    <SEO title={title} description={description} />

    <!-- Preload Critical Fonts -->
    <link rel="preload" href="/fonts/montserrat-700.woff2" as="font" type="font/woff2" crossorigin>
    <link rel="preload" href="/fonts/opensans-400.woff2" as="font" type="font/woff2" crossorigin>

    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" media="print" onload="this.media='all'">
    <noscript><link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css"></noscript>
    
    
    <!-- Global Footer Styles -->
    <style is:global>
        @import "../styles/footer.css";
    </style>

    <!-- View Transitions for Smooth Navigation -->
    <ViewTransitions />

    <!-- Sales Page Specific Reset & Base Styles -->
    <style is:global>
        :root {
            /* MPDC Official Brand Colors */
            --color-bg-primary: #0b3b36; /* Deep Steel Green */
            --color-bg-dark: #0d4d47; 
            --color-accent: #C4613A; /* Burnt Copper */
            --color-neon: #C4613A;
            --color-text-dark: #1a1a1a;
            --color-text-light: #ffffff;
            --color-text-muted: #e8e1d4; /* Sandstone Beige */
            
            --font-heading: 'Montserrat', sans-serif;
            --font-body: 'Open Sans', sans-serif;
        }

        /* Reset & Base */
        *, *::before, *::after {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        html, body {
            font-family: var(--font-body);
            background-color: #ffffff; /* Sales pages default to White */
            color: var(--color-text-dark);
            line-height: 1.6;
            overflow-x: hidden;
            width: 100%;
        }

        h1, h2, h3, h4, h5, h6 {
            font-family: var(--font-heading);
            font-weight: 700;
            line-height: 1.2;
            text-transform: uppercase;
        }

        a { text-decoration: none; color: inherit; transition: all 0.3s ease; }
        ul { list-style: none; }
        img { max-width: 100%; display: block; }
        
        /* Container Utility */
        .container {
            max-width: 1200px;
            margin: 0 auto;
            padding: 0 1rem;
        }
    </style>
    
    <!-- Injection Slot for Page Specific Head Tags (Scripts etc.) -->
    <slot name="head" />
</head>
<body>
    <!-- Sales Pages have No Header/Footer by default, or simple ones inside content -->
    <slot />
    
    <!-- Injection Slot for Page Specific Scripts -->
    <slot name="scripts" />
    <EmailPopup />
</body>
</html>
