    <script is:inline>

        // 🔒 MPDC SECURE DATA LAYER
        async function fetchClients() {
            if (!checkAuth()) return; // Secure the page

            try {
                const response = await fetch('/api/clients', {
                    headers: {
                        'Authorization': `Bearer ${localStorage.getItem('mpdc_admin_auth_token') || 'local-dev-bypass'}`
                    }
                });

                if (!response.ok) throw new Error('Proxy error');
                const profiles = await response.json();

            // 2. Fetch from Firebase (The Real Source for Sam)
            let fbProfiles = [];
            try {
                const fbSnap = await fb_db.collection('profiles')
                    .orderBy('updatedAt', 'desc')
                    .get();
                
                fbSnap.forEach(doc => {
                    const d = doc.data();
                    fbProfiles.push({
                        ...d,
                        created_at: d.updatedAt ? d.updatedAt.toDate().toISOString() : new Date().toISOString(),
                    });
                });
            } catch (err) {
                console.warn("Firebase fetch error for clients:", err);
            }

            // Merge and Unique
            let allProfiles = fbProfiles;
            if (profiles) {
                profiles.forEach(p => {
                    if (!allProfiles.find(fp => fp.email === p.email)) {
                        allProfiles.push(p);
                    }
                });
            }

            // Sort by newest
            allProfiles.sort((a, b) => new Date(b.created_at) - new Date(a.created_at));

            const profilesToRender = allProfiles;

            const tbody = document.getElementById('clients-table-body');
            if (tbody) tbody.innerHTML = '';

            if (profilesToRender && profilesToRender.length > 0) {
                // Update header count
                const countHeader = document.getElementById('header-client-count');
                if (countHeader) countHeader.innerText = profilesToRender.length;

                profilesToRender.forEach(client => {
                    const joinDate = new Date(client.created_at).toLocaleDateString();
                    const initials = (client.name || '?').charAt(0).toUpperCase();

                    const row = `
                        <tr>
                            <td>
                                <div class="user-cell">
                                    <div class="avatar-sm" style="background:#10B981; color:white;">${initials}</div>
                                    <div>
                                        <div class="font-medium">${client.name || 'Unknown'}</div>
                                        <div class="text-muted">${client.email}</div>
                                    </div>
                                </div>
                            </td>
                            <td><span class="status-badge" style="background:#334155; color:#cbd5e1;">${client.access_level || 'Student'}</span></td>
                            <td>${joinDate}</td>
                            <td style="font-weight:bold; color:#10B981;">$97.00</td>
                            <td><span class="status-badge" style="background:rgba(16,185,129,0.2); color:#10B981;">Active</span></td>
                            <td><button class="action-btn"><i class="fa-solid fa-ellipsis-vertical"></i></button></td>
                        </tr>
                    `;
                    if (tbody) tbody.insertAdjacentHTML('beforeend', row);
                });
            } else {
                if (tbody) tbody.innerHTML = '<tr><td colspan="6" style="text-align:center; padding:20px;">No clients found.</td></tr>';
            }
        }

        document.addEventListener('DOMContentLoaded', fetchClients);
    </script>
