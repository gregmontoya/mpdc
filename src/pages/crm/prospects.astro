    <!-- Add Prospect Modal -->
    <div id="addProspectModal" class="modal-overlay hidden">
        <div class="modal">
            <div class="modal-header">
                <h3>Add New IG Prospect</h3>
                <button class="close-modal"><i class="fa-solid fa-xmark"></i></button>
            </div>
            <div class="modal-body">
                <form id="addProspectForm">
                    <div class="form-group">
                        <label>Instagram Handle</label>
                        <div class="input-icon">
                            <i class="fa-brands fa-instagram"></i>
                            <input type="text" id="inputHandle" placeholder="@username" required>
                        </div>
                    </div>

                    <div class="form-group">
                        <label>Name (Optional)</label>
                        <input type="text" id="inputName" placeholder="First Last">
                    </div>

                    <div class="form-row">
                        <div class="form-group">
                            <label>Status</label>
                            <select id="inputStatus">
                                <option value="new">New DM</option>
                                <option value="convo">In Conversation</option>
                                <option value="qualifying">Qualifying</option>
                                <option value="booked">Call Booked</option>
                                <option value="ghosted">Ghosted</option>
                            </select>
                        </div>
                        <div class="form-group">
                            <label>Pain Point</label>
                            <select id="inputPainPoint">
                                <option value="">Select...</option>
                                <option value="custody">Custody</option>
                                <option value="financial">Financial</option>
                                <option value="emotional">Emotional/Recovery</option>
                                <option value="other">Other</option>
                            </select>
                        </div>
                    </div>

                    <div class="form-group">
                        <label>Notes</label>
                        <textarea id="inputNotes" rows="3" placeholder="Conversation details..."></textarea>
                    </div>

                    <div class="modal-footer">
                        <button type="button" class="btn btn-outline close-modal-btn">Cancel</button>
                        <button type="submit" class="btn btn-primary">Save Prospect</button>
                    </div>
                </form>
            </div>
        </div>
