    <!-- Script.js for UI Toggles -->
    <script is:inline src="/crm/script.js"></script>

    <script is:inline>
        // Init Supabase securely using pattern from clients.astro
        const SUPABASE_URL = 'https://vobbqsipyyftscyvxuja.supabase.co';
        const SUPABASE_KEY = 'eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InZvYmJxc2lweXlmdHNjeXZ4dWphIiwicm9sZSI6ImFub24iLCJpYXQiOjE3NzAxMjQyNDgsImV4cCI6MjA4NTcwMDI0OH0.aSxwAUb-qWZBVPQJ-s5FiGIKtu8dBlHGnuV5i0H2QHc';
        
        let supabase;
        try {
            if (window.supabase) {
                supabase = window.supabase.createClient(SUPABASE_URL, SUPABASE_KEY);
            } else {
                console.error("Supabase SDK failed to load window.supabase");
            }
        } catch(e) {
            console.error('Supabase Init Failed:', e);
        }

        document.addEventListener('DOMContentLoaded', async () => {
             // ------------------------
            // Modal Logic
            // ------------------------
            const modal = document.getElementById('addProspectModal');
            const openBtn = document.getElementById('openAddModal');
            const closeBtns = document.querySelectorAll('.close-modal, .close-modal-btn');
            const form = document.getElementById('addProspectForm');

            if(openBtn) openBtn.addEventListener('click', () => modal.classList.remove('hidden'));
            closeBtns.forEach(btn => btn.addEventListener('click', () => modal.classList.add('hidden')));
            if(modal) modal.addEventListener('click', (e) => { if (e.target === modal) modal.classList.add('hidden'); });

            // ------------------------
            // Fetch Data
            // ------------------------
            if(supabase) {
                renderProspects();
            } else {
                document.getElementById('prospects-table-body').innerHTML = 
                    '<tr><td colspan="6" class="text-center" style="color:red;">Error: Database connection failed. Adblocker?</td></tr>';
            }

            // ------------------------
            // Handle Form Submit
            // ------------------------
            if (form) {
                form.addEventListener('submit', async (e) => {
                    e.preventDefault();
                    if(!supabase) return;

                    const handle = document.getElementById('inputHandle').value;
                    const name = document.getElementById('inputName').value;
                    const status = document.getElementById('inputStatus').value;
                    const painPoint = document.getElementById('inputPainPoint').value;
                    const notes = document.getElementById('inputNotes').value;

                    // Adapt to schema (store handle in email, omit missing cols)
                    const { data, error } = await supabase
                        .from('leads')
                        .insert([{
                            email: handle, // Store handle in email field
                            name: name,
                            status: status,
                            // pain_point: painPoint, // Column missing
                            // notes: notes, // Column missing
                            source: 'instagram_manual',
                            created_at: new Date().toISOString()
                        }])
                        .select();

                    if (!error) {
                        form.reset();
                        modal.classList.add('hidden');
                        renderProspects();
                    } else {
                        alert('Error saving: ' + error.message);
                    }
                });
            }
        });

        async function renderProspects() {
            const tbody = document.getElementById('prospects-table-body');
            const countHeader = document.getElementById('header-count');
            
            // Fetch leads
            const { data: leads, error } = await supabase
                .from('leads')
                .select('*')
                .order('created_at', { ascending: false });

            if (error) {
                console.error(error);
                tbody.innerHTML = '<tr><td colspan="6" class="text-center">Error fetching data.</td></tr>';
                return;
            }

            // Filter for IG leads only (source starts with 'instagram' or is manual). 
            // In our new schema adaptation, we check email for handle-like strings or source.
            const prospectLeads = leads.filter(l => l.source === 'instagram_manual' || (l.email && l.email.startsWith('@')));

            if (countHeader) countHeader.innerText = prospectLeads.length;

            if (prospectLeads.length === 0) {
                tbody.innerHTML = '<tr><td colspan="6" style="text-align:center; padding:20px;">No prospects found. Add one!</td></tr>';
                return;
            }

            tbody.innerHTML = '';
            prospectLeads.forEach(lead => {
                const date = new Date(lead.created_at).toLocaleDateString();
                // Map 'email' to handle for display
                const handle = lead.email || 'No Handle'; 
                const initials = (lead.name || handle || '?').charAt(0).toUpperCase(); // Define initials
                const cleanHandle = handle.replace('@', '');
                
                // Status Badge Color
                let statusColor = 'gray';
                let statusBg = '#e2e8f0';
                if(lead.status === 'new') { statusColor = '#3b82f6'; statusBg = '#dbeafe'; }
                if(lead.status === 'convo') { statusColor = '#8b5cf6'; statusBg = '#ede9fe'; }
                if(lead.status === 'qualifying') { statusColor = '#f59e0b'; statusBg = '#fef3c7'; }
                if(lead.status === 'booked') { statusColor = '#10b981'; statusBg = '#d1fae5'; }

                const row = `
                    <tr>
                        <td>
                            <div class="user-cell">
                                <div class="avatar-sm" style="background:#E1306C; color:white;">
                                    <i class="fa-brands fa-instagram"></i>
                                </div>
                                <div>
                                    <div class="font-medium">${lead.name || 'Unknown'}</div>
                                    <a href="https://instagram.com/${cleanHandle}" target="_blank" class="text-muted" style="color:#E1306C; hover:underline;">${handle}</a>
                                </div>
                            </div>
                        </td>
                        <td>
                            <span class="status-badge" style="background:${statusBg}; color:${statusColor}; text-transform:capitalize;">
                                ${lead.status === 'convo' ? 'In Conversation' : lead.status}
                            </span>
                        </td>
                        <td><span style="color:#ccc;">-</span></td>
                        <td style="max-width:250px;"><div style="white-space:nowrap; overflow:hidden; text-overflow:ellipsis;" title="Notes not available">-</div></td>
                        <td>${date}</td>
                        <td>
                            <button class="action-btn"><i class="fa-solid fa-pen"></i></button>
                        </td>
                    </tr>
                `;
                tbody.insertAdjacentHTML('beforeend', row);
            });
        }
    </script>
