                ['Lead Capture (Firebase)', 'Completed', 'Critical', 'Dev', 'Stripe Stack', 'Stripe Checkout Fix', 'mpdc-crm', 'Captures before checkout'],
                ['CRM Analytics Page', 'Completed', 'Medium', 'Dev', 'GA4 Tracking', 'GA4 Funnel Strategy', 'mpdc-crm', 'Live at /crm/analytics'],
                ['Stealth Mode Implementation', 'Completed', 'High', 'Dev', 'Infra Tuning', 'Monitoring/Stealth', 'mpdc-crm', 'Exclude admin traffic'],
                ['First/Last Touch Attribution', 'Completed', 'High', 'Dev', 'GA4 Tracking', 'Attribution Setup', 'mpdc-crm', 'Library integrated'],
                ['Schema Injector Tool', 'Completed', 'Medium', 'Dev', 'Tools', 'Schema Manager Enhancements', 'mpdc-crm', 'CRM Tool'],
                ['SEO Manager Tool', 'Completed', 'Medium', 'Dev', 'Tools', 'SEO Dashboard Integration', 'mpdc-crm', 'CRM Tool'],
                ['"Identity Bridge" Data Arch', 'Proposed', 'Critical', 'Dev', 'Identity Bridge', 'Identity Bridge Strategy', 'mpdc-crm', 'Design/Implement "anonymous_leads" Event Stream (IDs keyed by Cookie UUID).', true],
                ['Identity Stitching "Brain"', 'Proposed', 'Critical', 'Dev', 'Identity Bridge', 'Identity Bridge Strategy', 'mpdc-crm', 'Cloud Function: Stitch guest_id history to official User Profile on form submit.', true],
                ['BigQuery Event Streaming', 'Proposed', 'High', 'Dev', 'Identity Bridge', 'Identity Bridge Strategy', 'mpdc-crm', 'Move high-frequency logs to BigQuery to avoid Firestore query costs/latency.', true]
            ],
            cro: [
                ['Exit Intent Popup', 'Completed', 'High', 'Dev', 'CRO Experiment', 'Website Strategy', 'mpdc-crm', 'Live Exit-Intent trigger + 7-Minute Fog-Clearance Lead Magnet. (v2.1.11)'],
                ['Social Proof Ticker', 'Pending', 'Low', 'Greg', 'One-Off', 'Website Strategy', 'mpdc-crm', 'Toast notification: "Person X in [City] just joined" (Simulated).'],
                ['Revenue by Source Dashboard', 'Backlog', 'Medium', 'Greg', 'Tools', 'TODO List', 'mpdc-crm', 'Visualize attribution data'],
                ['Offline Conversions Upload', 'Backlog', 'Low', 'Greg', 'One-Off', 'TODO List', 'mpdc-crm', 'Sync Stripe to Ads manually']
            ],
            legal: [
                ['Formal Disclaimer Implementation', 'Completed', 'Critical', 'Greg', 'Compliance', 'Legal Sump', 'mpdc-crm', 'Added to bottom of all blog posts: "Athens NLP Studies, LLC and MPDC do not provide formal financial or legal advice..."', true],
                ['GDPR/CCPA Cookie Consent', 'Proposed', 'Critical', 'Dev', 'Compliance', 'Legal Sump', 'mpdc-crm', 'Implement "CookieYes" or custom banner. Block GA4 until consent given (EU Only).'],
                ['Privacy Policy Update', 'Proposed', 'High', 'Greg', 'Compliance', 'Legal Sump', 'mpdc-crm', 'Add clause: "We use AI to process data". Transparency builds trust with modern users.'],
                ['Terms of Service Audit', 'Backlog', 'Medium', 'Greg', 'Compliance', 'Legal Sump', 'mpdc-crm', 'Ensure "No Guarantee of Results" clause is prominent for Coaching protection.'],
                ['GDPR ID Stitching Privacy', 'Proposed', 'Critical', 'Dev', 'Identity Bridge', 'Identity Bridge Strategy', 'mpdc-crm', 'Privacy Gate: Block tracker pings until cookie consent is confirmed. No PII logging.', true]
            ],
            context: [
                ['Chatbot Implementation', 'Proposed', 'High', 'Greg', 'Chat', 'Antigravity', 'mpdc-crm', 'Add a new chatbot task to do', true]
            ],
        };

        const COL_HEADERS = ['Item Name', 'Status', 'Priority', 'Owner', 'Project', 'Category', 'Conversation Source', 'Workspace', 'Tactical Instructions (Notes)', 'H'];

        function getHeaderRow(title) {
            return [`${title}`, '', '', '', '', '', '', '', '', 'SECTION_HEADER', false];
        }

        function getTableData(tab) {
            let rows = [COL_HEADERS]; // Start with column headers

            // Helper to inject Category
            const process = (dbRows, catName) => {
                return dbRows.map(r => {
                    const highlight = r.length > 8 ? r[r.length - 1] : (typeof r[r.length - 1] === 'boolean' ? r[r.length - 1] : false);
                    // Raw: [Name, Status, Priority, Owner, Project, Source, Workspace, Notes]
                    // Target: [Name, Status, Priority, Owner, Project, Cat, Source, Workspace, Notes, Highlight]
                    return [r[0], r[1], r[2], r[3], r[4], catName, r[5], r[6], r[7], highlight];
                });
            };

            const sections = {
                analytics: 'Analytics', seo: 'SEO', vitals: 'Vitals', aeo: 'AEO',
                entity: 'Entity', experiments: 'Experiments', infra: 'Infra',
                cro: 'CRO', legal: 'Compliance', context: 'Context'
            };

            if (tab === 'master') {
                rows.push(getHeaderRow('📂 WORKSPACE CONTEXT'), ...process(STRATEGY_DB.context, 'Context'));
                rows.push(getHeaderRow('📊 ANALYTICS & VISIBILITY'), ...process(STRATEGY_DB.analytics, 'Analytics'));
                rows.push(getHeaderRow('🔍 SEO MASTERY'), ...process(STRATEGY_DB.seo, 'SEO'));
                rows.push(getHeaderRow('⚡️ CORE WEB VITALS'), ...process(STRATEGY_DB.vitals, 'Vitals'));
                rows.push(getHeaderRow('🤖 AEO & AI VISIBILITY'), ...process(STRATEGY_DB.aeo, 'AEO'));
                rows.push(getHeaderRow('🌐 ENTITY & LOCAL AUTHORITY'), ...process(STRATEGY_DB.entity, 'Entity'));
                rows.push(getHeaderRow('🚀 EXPERIMENTATION & TESTING'), ...process(STRATEGY_DB.experiments, 'Experiments'));
                rows.push(getHeaderRow('🛠️ INFRASTRUCTURE & CRM'), ...process(STRATEGY_DB.infra, 'Infra'));
                rows.push(getHeaderRow('💡 STRATEGIC IDEAS (CRO)'), ...process(STRATEGY_DB.cro, 'CRO'));
                rows.push(getHeaderRow('🛡️ COMPLIANCE & SECURITY'), ...process(STRATEGY_DB.legal, 'Compliance'));
            } else if (tab === 'search') {
                rows.push(getHeaderRow('🔍 SEO MASTERY'), ...process(STRATEGY_DB.seo, 'SEO'));
                rows.push(getHeaderRow('⚡️ CORE WEB VITALS'), ...process(STRATEGY_DB.vitals, 'Vitals'));
                rows.push(getHeaderRow('🤖 AEO & AI VISIBILITY'), ...process(STRATEGY_DB.aeo, 'AEO'));
                rows.push(getHeaderRow('🌐 ENTITY & LOCAL AUTHORITY'), ...process(STRATEGY_DB.entity, 'Entity'));
            } else if (tab === 'growth') {
                rows.push(getHeaderRow('📊 ANALYTICS & VISIBILITY'), ...process(STRATEGY_DB.analytics, 'Analytics'));
                rows.push(getHeaderRow('🚀 EXPERIMENTATION & TESTING'), ...process(STRATEGY_DB.experiments, 'Experiments'));
                rows.push(getHeaderRow('💡 STRATEGIC IDEAS (CRO)'), ...process(STRATEGY_DB.cro, 'CRO'));
            } else if (tab === 'projects') {
                let allItems = [];
                Object.keys(STRATEGY_DB).forEach(key => {
                    allItems = allItems.concat(process(STRATEGY_DB[key], sections[key]));
                });

                const groups = {};
                allItems.forEach(item => {
                    const project = item[4] || 'One-Off';
                    if (!groups[project]) groups[project] = [];
                    groups[project].push(item);
                });

                const projectNames = Object.keys(groups).sort((a, b) => {
                    if (a === 'Identity Bridge') return -1;
                    if (b === 'Identity Bridge') return 1;
                    if (a === 'One-Off') return 1;
                    if (b === 'One-Off') return -1;
                    return a.localeCompare(b);
                });

                projectNames.forEach(name => {
                    rows.push(getHeaderRow(`📁 PROJECT: ${name.toUpperCase()}`), ...groups[name]);
                });
            } else if (tab === 'systems') {
                rows.push(getHeaderRow('🛠️ INFRASTRUCTURE & CRM'), ...process(STRATEGY_DB.infra, 'Infra'));
                rows.push(getHeaderRow('🛡️ COMPLIANCE & SECURITY'), ...process(STRATEGY_DB.legal, 'Compliance'));
                rows.push(getHeaderRow('📂 WORKSPACE CONTEXT'), ...process(STRATEGY_DB.context, 'Context'));
            }
            
            // Normalize to 10 elements (Just in case)
            return rows.map(r => {
                const newRow = [...r];
                while (newRow.length < 10) newRow.push(false);
                return newRow;
            });
        }

        // Initialize Handsontable
        function initGrid(data) {
            const container = document.getElementById('strategy-sheet');
            container.innerHTML = ''; // Clear previous

            // Calculate where merge cells should go based on the data
            let mergeCells = [];
            // We need to scan the data for "SECTION_HEADER" to create merges dynamically
            data.forEach((row, index) => {
                if (row[9] === 'SECTION_HEADER') {
                    mergeCells.push({ row: index, col: 0, rowspan: 1, colspan: 10 });
                }
            });

            hot = new Handsontable(container, {
                data: data,
                rowHeaders: true,
                colHeaders: false,
                fixedRowsTop: 1,
                contextMenu: true,
                columnSorting: false, // Sorting breaks our section headers
                licenseKey: 'non-commercial-and-evaluation',
                stretchH: 'all',
                manualColumnResize: true,
                colWidths: [250, 100, 80, 80, 140, 100, 150, 120, 450, 1], // Fixed 10 column distribution
                rowHeights: 23, 
                autoRowSize: false,
                className: 'htMiddle',
                mergeCells: mergeCells,
                cells: function(row, col) {
                    const cellProperties = {};
                    const rowData = this.instance.getData()[row];
                    
                    // define common style enforcer
                    const forceStyle = (td) => {
                        td.style.height = '22px';
                        td.style.lineHeight = '20px';
                        td.style.padding = '1px 4px';
                        td.style.fontSize = '12px';
                        td.style.verticalAlign = 'middle';
                        td.style.whiteSpace = 'nowrap';
                        td.style.overflow = 'hidden';
                        td.style.textOverflow = 'ellipsis';
                        td.style.boxSizing = 'border-box';
                    };

                    // Main Table Header
                    if (row === 0) {
                        cellProperties.renderer = function(instance, td, row, col, prop, value, cellProperties) {
                            Handsontable.renderers.TextRenderer.apply(this, arguments);
                            forceStyle(td);
                            td.style.fontWeight = 'bold';
                            td.style.background = '#f1f5f9';
                            td.style.color = '#334155';
                            td.style.borderBottom = '1px solid #cbd5e1';
                        };
                        cellProperties.readOnly = true;
                    }
                    // Section Headers
                    else if (rowData && (rowData[9] === 'SECTION_HEADER' || (typeof rowData[0] === 'string' && rowData[0].match(/^[📂📊🔍⚡️🤖🌐🚀🛠️💡🛡️📁]/)))) {
                        cellProperties.renderer = function(instance, td, row, col, prop, value, cellProperties) {
                            Handsontable.renderers.TextRenderer.apply(this, arguments);
                            forceStyle(td); 
                            
                            // OVERRIDE for High Contrast Header
                            td.style.fontWeight = '900';
                            td.style.setProperty('background-color', '#dbeafe', 'important'); // Blue 100
                            td.style.setProperty('color', '#0f172a', 'important');      // Slate 900
                            td.style.textTransform = 'uppercase';
                            td.style.letterSpacing = '1.2px';
                            td.style.paddingLeft = '15px';
                            
                            // Remove bottom border from forceStyle default if conflicting
                            td.style.setProperty('border-bottom', '1px solid #93c5fd', 'important');
                        };
                        cellProperties.readOnly = true;
                    }
                    // Status coloring
                    else if (col === 1 && row > 0) {
                        cellProperties.renderer = function(instance, td, row, col, prop, value, cellProperties) {
                            Handsontable.renderers.TextRenderer.apply(this, arguments);
                            forceStyle(td);
                            if (value === 'Completed') { td.style.color = '#10B981'; td.style.fontWeight = 'bold'; }
                            else if (value === 'Pending') { td.style.color = '#F59E0B'; }
                            else if (value === 'Critical') { td.style.color = '#EF4444'; }
                            else if (value === 'Proposed') { td.style.color = '#8b5cf6'; td.style.fontStyle = 'italic'; }
                            else if (value === 'MPDC-CRM') { td.style.color = '#3b82f6'; td.style.fontWeight = 'bold'; }
                        };
                    }
                    // Project Column - Styling
                    else if (col === 4 && row > 0) {
                        cellProperties.renderer = function(instance, td, row, col, prop, value, cellProperties) {
                            Handsontable.renderers.TextRenderer.apply(this, arguments);
                            forceStyle(td);
                            if (value !== 'One-Off') {
                                td.style.color = '#6366f1';
                                td.style.fontWeight = '600';
                            } else {
                                td.style.color = '#94a3b8';
                            }
                        };
                    }
                    // Notes column (Index 8)
                    else if (col === 8) { 
                         cellProperties.renderer = function(instance, td, row, col, prop, value, cellProperties) {
                            Handsontable.renderers.TextRenderer.apply(this, arguments);
                            forceStyle(td);
                            td.style.color = '#475569';
                        };
                    }
                    // Default fallback
                    else {
                         cellProperties.renderer = function(instance, td, row, col, prop, value, cellProperties) {
                            Handsontable.renderers.TextRenderer.apply(this, arguments);
                            forceStyle(td);
                        };
                    }

                    // HIGHLIGHT Logic (Yellow for New/Updated)
                    if (rowData && rowData[9] === true) { 
                        const originalRenderer = cellProperties.renderer || Handsontable.renderers.TextRenderer;
                        cellProperties.renderer = function(instance, td, row, col, prop, value, cellProperties) {
                            originalRenderer.apply(this, arguments);
                            // Highlight Item Name (0), Project (4), Notes (8), Category (5)
                            if (col === 0 || col === 4 || col === 8 || col === 5) { 
                                td.style.setProperty('background-color', '#fef9c3', 'important'); 
                                td.style.setProperty('color', '#1e293b', 'important');
                            }
                        };
                    }

                    return cellProperties;
                }
            });
        }

        function switchTab(tabName) {
            // Update buttons
            document.querySelectorAll('.tab-btn').forEach(btn => btn.classList.remove('active'));
            // Find the button that called this (hacky but works if passed 'this' or we just match by onclick text or something)
            // Easier: just query by onclick attribute we set
            const buttons = document.querySelectorAll('.tab-btn');
            buttons.forEach(b => {
                if(b.getAttribute('onclick').includes(tabName)) b.classList.add('active');
            });

            // Load Data
            const newData = getTableData(tabName);
            
            // Re-render
            // Ideally hot.loadData(newData) but we need to update mergeCells too
            // Destroying and re-creating is safer for mergeCells dynamics
            if(hot) hot.destroy();
            initGrid(newData);
        }

        function renderTopPriorities() {
            const listEl = document.getElementById('top-priority-list');
            let allTasks = [];
            
            // Collect all tasks from all sections WITH Category Context
            Object.keys(STRATEGY_DB).forEach(key => {
                if(key !== 'context') { // Skip context section
                    // Map key to readable name
                    let catName = key.toUpperCase();
                    if(key === 'vitals') catName = 'VITALS';
                    if(key === 'aeo') catName = 'AEO';
                    if(key === 'infra') catName = 'INFRA';
                    if(key === 'legal') catName = 'LEGAL';
                    if(key === 'experiments') catName = 'TEST';

                    // Add category to task data for sorting/display
                    const tasksWithCat = STRATEGY_DB[key].map(t => {
                        // Ensure we know where the category is. 
                        // Target format for priority widget: [Name, Status, Priority, Owner, Project, Source, Workspace, Notes, Highlight, Category]
                        const highlight = t.length > 7 ? t[7] : false;
                        const project = t.length > 4 ? t[4] : 'One-Off';
                        return [t[0], t[1], t[2], t[3], project, t[4], t[5], t[6], highlight, catName];
                    });
                    allTasks = allTasks.concat(tasksWithCat);
                }
            });

            // Filter: Not Completed
            const activeTasks = allTasks.filter(task => task[1] !== 'Completed');

            // Sort: Critical (1) -> High (2) -> Medium (3) -> Low (4)
            const priorityMap = { 'Critical': 1, 'High': 2, 'Medium': 3, 'Low': 4 };
            
            activeTasks.sort((a, b) => {
                const pA = priorityMap[a[2]] || 99;
                const pB = priorityMap[b[2]] || 99;
                return pA - pB;
            });

            // Top 5
            const top5 = activeTasks.slice(0, 5);

            // Render
            listEl.innerHTML = '';

            top5.forEach(task => {
                const name = task[0];
                const status = task[1];
                const owner = task[3];
                const category = task[9]; // Category is now at index 9
                
                // Truncate name for small widget
                const displayName = name.length > 45 ? name.substring(0, 42) + '...' : name;

                const item = document.createElement('div');
                item.className = 'priority-item';
                
                // Grid: Category | Name | Status | Owner
                item.style.display = 'grid';
                item.style.gridTemplateColumns = '80px 1fr 70px 70px';
                item.style.gap = '8px';
                item.style.alignItems = 'center';
                item.style.padding = '8px 16px';

                // Status Badge Color logic
                let statusColor = '#94a3b8';
                let statusBg = 'rgba(148, 163, 184, 0.1)';
                if (status === 'Proposed') { statusColor = '#8b5cf6'; statusBg = 'rgba(139, 92, 246, 0.15)'; }
                if (status === 'Pending') { statusColor = '#f59e0b'; statusBg = 'rgba(245, 158, 11, 0.15)'; }
                if (status === 'Critical') { statusColor = '#ef4444'; statusBg = 'rgba(239, 68, 68, 0.15)'; }

                item.innerHTML = `
                    <div style="font-size:9px; color:#64748b; font-weight:700;">${category}</div>
                    <div style="color:#f1f5f9; font-weight:500; font-size:12px; white-space:nowrap; overflow:hidden; text-overflow:ellipsis;" title="${name}">${displayName}</div>
                    <div style="text-align:center;">
                        <span style="font-size:9px; font-weight:700; color:${statusColor}; background:${statusBg}; padding:2px 6px; border-radius:4px; text-transform:uppercase;">${status[0]}</span>
                    </div>
                    <div style="display:flex; align-items:center; gap:6px; color:#94a3b8; font-size:11px; justify-content:flex-end;">
                        <div style="width:18px; height:18px; border-radius:50%; background:${owner === 'Greg' ? '#8b5cf6' : '#3b82f6'}; color:white; font-size:8px; display:flex; align-items:center; justify-content:center; text-transform:uppercase; font-weight:bold;">${owner[0]}</div>
                    </div>
                `;
                listEl.appendChild(item);
            });

            if(top5.length === 0) {
                listEl.innerHTML = '<div style="padding:15px; text-align:center; color:#10b981; font-size:12px;">🎉 All Critical Tasks Complete!</div>';
            }
        }

        // Initialize
        window.addEventListener('DOMContentLoaded', () => {
            initGrid(getTableData('master'));
            renderTopPriorities();

            // AI Console Sync Logic
            const aiBtn = document.getElementById('ai-submit-btn');
            const aiInput = document.getElementById('ai-input');

            aiBtn.addEventListener('click', () => {
                    const rawInput = aiInput.value.trim();
                    if(!rawInput) return;

                    aiBtn.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> ANALYZING...';
                    aiBtn.style.opacity = '0.7';
                    aiBtn.disabled = true;

                    // Simulate AI Analysis & Parsing
                    setTimeout(() => {
                        // 1. Extract Project First
                        let projectName = 'One-Off'; 
                        let cleanInput = rawInput;
                        
                        // Regex consumes "add to a new project X", "for project X"
                        // Captures the actual project name in group 1
                        const projectMatch = rawInput.match(/(?:(?:add|move)\s+it\s+to\s+|in\s+|for\s+|to\s+)?(?:a\s+new\s+)?(?:Project|prj|project\s+name)[:\s]+([^\n,.]+)/i);
                        
                        if (projectMatch) {
                            projectName = projectMatch[1].trim(); 
                            // Remove the entire matched phrase (including "add it to a new project...")
                            cleanInput = rawInput.replace(projectMatch[0], '').trim();
                            // Clean up trailing connectors
                            cleanInput = cleanInput.replace(/(\s+(and|with|for|in)\s*|\s*[,.-]\s*)$/i, '').trim();
                        }

                        // 2. Generate Smart Item Name
                        let itemName = '';
                        
                        // Check for explicit "call it X", "name it X", "task named X"
                        const nameMatch = cleanInput.match(/(?:call\s+it|name\s+it|name\s+is|named)\s+([^\s,.]+)/i);
                        if (nameMatch) {
                             itemName = nameMatch[1].trim();
                        } else {
                            // Fallback: Use cleanInput
                            itemName = cleanInput.split('\n')[0]; 
                            if (itemName.length > 55) {
                                const firstSentence = cleanInput.match(/.*?[.?!]/);
                                if (firstSentence && firstSentence[0].length < 55) itemName = firstSentence[0];
                                else itemName = cleanInput.substring(0, 45) + '...';
                            }
                        }
                        
                        // Capitalize & Format
                        itemName = itemName.charAt(0).toUpperCase() + itemName.slice(1);
                        itemName = itemName.replace(/^and\s+/i, ''); // Extra cleanup

                        console.log("AI PARSED:", itemName, "| Project:", projectName);
                        
                        // Add to DB (Context Section - Top)
                        const newItem = [itemName, 'Proposed', 'High', 'Greg', projectName, 'AI Command', 'mpdc-crm', rawInput, true];
                        STRATEGY_DB.context.unshift(newItem); 
                        
                        setTimeout(() => {
                            aiBtn.innerHTML = '<i class="fa-solid fa-bolt"></i> Sync to Strategy';
                            aiBtn.style.background = '';
                            aiBtn.style.opacity = '1';
                            aiBtn.disabled = false;
                            aiInput.value = '';
                            
                            switchTab('master');
                            renderTopPriorities();
                            
                            if(hot) hot.scrollViewportTo(0, 0);
                            
                            alert(`AI Created Task:\n"${itemName}"\n\nProject: ${projectName}\n(Row 2)`);
                        }, 500);
                    }, 1000);
            });

            document.getElementById('save-btn').addEventListener('click', () => {
                const currentData = hot.getData();
                localStorage.setItem('mpdc_strategy_data', JSON.stringify(currentData));
                alert('Snapshot Saved locally!');
            });
        });
    </script>
</body>
