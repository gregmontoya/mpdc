            padding: 0;
            display: flex;
            flex-direction: column;
        }
        .priority-item {
            padding: 10px 16px;
            border-bottom: 1px solid #334155;
            font-size: 12px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            background: #1e293b;
            transition: background 0.2s;
        }
        .priority-item:last-child { border-bottom: none; }
        .priority-item:hover { background: #334155; cursor: pointer; }
        
