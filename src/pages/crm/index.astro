        async function fetchDashboardData() {
            if (!checkAuth()) return; // Secure Page
            if (!supabase) return;

            // 1. Get Counts
            const { count: leadCount } = await supabase.from('leads').select('*', { count: 'exact', head: true });
            const { count: studentCount } = await supabase.from('profiles').select('*', { count: 'exact', head: true });

            // 2. Update Stats
            document.getElementById('stat-total-leads') && (document.getElementById('stat-total-leads').innerText = leadCount || 0);
            document.getElementById('stat-active-students') && (document.getElementById('stat-active-students').innerText = studentCount || 0);

            const revenue = (studentCount || 0) * 97;
            document.getElementById('stat-revenue') && (document.getElementById('stat-revenue').innerText = '$' + revenue.toLocaleString());

            // 3. Fetch Recent Leads & Students (Unified Feed)
            const { data: recentLeads } = await supabase
                .from('leads')
                .select('*')
                .order('created_at', { ascending: false })
                .limit(5);

            const { data: recentStudents } = await supabase
                .from('profiles')
                .select('*')
                .order('created_at', { ascending: false })
                .limit(5);

            // Merge and Sort
            let activity = [];
            if (recentLeads) activity = activity.concat(recentLeads.map(i => ({ ...i, type: 'lead' })));
            if (recentStudents) activity = activity.concat(recentStudents.map(i => ({ ...i, type: 'student' })));

            // Sort by newest first
            activity.sort((a, b) => new Date(b.created_at) - new Date(a.created_at));

            // Take top 7 events
            activity = activity.slice(0, 7);

            const tableBody = document.getElementById('dashboard-leads-body');
            if (tableBody) {
                tableBody.innerHTML = '';

                if (activity.length === 0) {
                    tableBody.innerHTML = '<tr><td colspan="6" style="text-align:center; padding:20px; color:#666;">No recent activity found.</td></tr>';
                }

                activity.forEach(item => {
                    const timeAgo = new Date(item.created_at).toLocaleDateString() + ' ' + new Date(item.created_at).toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });

                    let badge, value, sourceIcon, avatarColor, statusLabel;

                    if (item.type === 'student') {
                        badge = '<span class="status-badge" style="background:rgba(16, 185, 129, 0.2); color:#10B981;">Enrolled</span>';
                        value = '<span style="color:#10B981; font-weight:bold;">+$97.00</span>';
                        sourceIcon = '<i class="fa-solid fa-credit-card" style="color:#10B981;"></i> Stripe';
                        avatarColor = '#10B981'; // Green
                        statusLabel = 'Student';
                    } else {
                        badge = '<span class="status-badge new">Abandoned</span>';
                        value = '<span style="color:#999;">$0.00</span>';
                        sourceIcon = '<i class="fa-solid fa-cart-shopping" style="color:#C4613A;"></i> Checkout';
                        avatarColor = '#C4613A'; // Orange
                        statusLabel = 'Lead';
                    }

                    const row = `
                        <tr>
                            <td>
                                <div class="user-cell">
                                    <div class="avatar-sm" style="background:${avatarColor}; color:white;">${(item.name || 'U').charAt(0).toUpperCase()}</div>
                                    <div>
                                        <div class="font-medium">${item.name || 'Visitor'}</div>
                                        <div class="text-muted" style="font-size:11px;">${item.email}</div>
                                    </div>
                                </div>
                            </td>
                            <td>${sourceIcon}</td>
                            <td>${badge}</td>
                            <td>${value}</td>
                            <td style="font-size:12px; color:#888;">${timeAgo}</td>
                            <td><button class="action-btn"><i class="fa-solid fa-chevron-right"></i></button></td>
                        </tr>
                    `;
                    tableBody.insertAdjacentHTML('beforeend', row);
                });
            }
        }

        // Initialize Stealth Mode
        function initStealthMode() {
            const toggle = document.getElementById('stealth-mode-toggle');
            const status = document.getElementById('stealth-status');
            
            if (!toggle) return;

            const isActive = localStorage.getItem('mpdc_disable_tracking') === 'true';
            toggle.checked = isActive;
            
            const updateUI = (active) => {
                status.innerText = active ? 'ACTIVE' : 'INACTIVE';
                status.style.color = active ? '#10B981' : '#888';
            };
            
            updateUI(isActive);

            toggle.addEventListener('change', (e) => {
                const active = e.target.checked;
                localStorage.setItem('mpdc_disable_tracking', active ? 'true' : 'false');
                updateUI(active);
                if (active) {
                    alert('🕵️ Stealth Mode Active\n\nGoogle Analytics is now disabled for this browser. This will persist until you turn it off.');
                }
            });
        }

        document.addEventListener('DOMContentLoaded', () => {
            waitForSupabase();
            initStealthMode();
            fetchVideoStats();

            // Test Signal Handler
            const testBtn = document.getElementById('btn-test-vsl');
            if (testBtn) {
                testBtn.addEventListener('click', async () => {
                    if (!confirm('Push a live test signal to the database?')) return;
                    try {
                        await fb_db.collection('video_events').add({
                            video_id: 'join_vsl',
                            milestone: 'play_start',
                            percent: 0,
                            timestamp: firebase.firestore.FieldValue.serverTimestamp(),
                            url: '/crm-manual-test',
                            is_test: true
                        });
                        alert('✅ Test signal sent! Refreshing stats...');
                        fetchVideoStats();
                    } catch (e) {
                        alert('❌ Signal failed: ' + e.message);
                    }
                });
            }
        });
    </script>
    <!-- Supabase SDK -->
    <script is:inline src="https://unpkg.com/@supabase/supabase-js@2"></script>
    <script is:inline src="/crm/supabase-client.js"></script>
    <script is:inline src="/crm/script.js"></script>
</body>

</html>