    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>MPDC CRM | Leads Pipeline</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/crm/styles.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <script src="https://cdn.jsdelivr.net/npm/sortablejs@1.15.0/Sortable.min.js"></script>
</head>

<body>
    <div class="app-container">
        <!-- Sidebar -->
        <aside class="sidebar">
            <div class="logo-container">
                <div class="logo-icon">M</div>
                <h1 class="logo-text">MPDC<span>CRM</span></h1>
            </div>

            <nav class="main-nav">
                <a href="/crm" class="nav-item">
                    <i class="fa-solid fa-grid-2"></i>
                    <span>Dashboard</span>
                </a>
                <a href="/crm/analytics" class="nav-item">
                    <i class="fa-solid fa-chart-pie"></i>
                    <span>Analytics</span>
                </a>
                <a href="/crm/strategy" class="nav-item">
                    <i class="fa-solid fa-chess"></i>
                    <span>Strategy</span>
                </a>
                <a href="/crm/analytics" class="nav-item">
                    <i class="fa-solid fa-chart-pie"></i>
                    <span>Analytics</span>
                </a>
                <a href="/crm/strategy" class="nav-item">
                    <i class="fa-solid fa-chess"></i>
                    <span>Strategy</span>
                </a>
                <a href="/crm/clients" class="nav-item">
                    <i class="fa-solid fa-users"></i>
                    <span>Clients</span>
                </a>
                <a href="/crm/leads" class="nav-item active">
                    <i class="fa-solid fa-bullseye"></i>
                    <span>Leads</span>
                </a>
                <a href="/crm/roi" class="nav-item">
                    <i class="fa-solid fa-chart-line"></i>
                    <span>Campaign ROI</span>
                </a>
                <a href="/crm/prospects" class="nav-item">
                    <i class="fa-brands fa-instagram"></i>
                    <span>IG Prospects</span>
                </a>
                <a href="#" class="nav-item">
                    <i class="fa-solid fa-chart-line"></i>
                    <span>Deals</span>
                </a>
                <a href="#" class="nav-item">
                    <i class="fa-solid fa-envelope"></i>
                    <span>Inbox</span>
                    <span class="badge">3</span>
                </a>
                <div class="pt-4 pb-2 text-xs font-bold text-white/40 uppercase tracking-widest px-4" style="margin-top: 15px; font-size: 10px; letter-spacing: 1px;">Marketing</div>
                <a href="/crm/seo" class="nav-item">
                    <i class="fa-solid fa-search"></i>
                    <span>SEO Manager</span>
                </a>
                <a href="/crm/schema" class="nav-item">
                    <i class="fa-solid fa-code"></i>
                    <span>Schema Injector</span>
                </a>
                <a href="/crm/cro" class="nav-item">
                    <i class="fa-solid fa-chart-column"></i>
                    <span>CRO Analysis</span>
                </a>
                <a href="/crm/cro" class="nav-item">
                    <i class="fa-solid fa-chart-column"></i>
                    <span>CRO Analysis</span>
                </a>
            </nav>

            <div class="secondary-nav">
                <a href="#" class="nav-item">
                    <i class="fa-solid fa-gear"></i>
                    <span>Settings</span>
                </a>
                <a href="#" class="nav-item">
                    <i class="fa-solid fa-circle-question"></i>
                    <span>Help Center</span>
                </a>
            </div>

            <div class="user-profile">
                <img src="https://ui-avatars.com/api/?name=Greg+Montoya&background=3b82f6&color=fff" alt="User"
                    class="avatar">
                <div class="user-info">
                    <p class="user-name">Greg Montoya</p>
                    <p class="user-role">Admin</p>
                </div>
                <i class="fa-solid fa-chevron-right"></i>
            </div>
        </aside>

        <!-- Main Content -->
        <main class="main-content">
            <header class="top-header">
                <div class="header-left">
                    <h1>Leads Pipeline</h1>
                    <p>Total Revenue Pipeline: <span id="pipeline-total"
                            style="font-weight:700; color:#42B395;">$0</span></p>
                </div>
                <div class="header-right">
                    <div class="search-bar">
                        <i class="fa-solid fa-magnifying-glass"></i>
                        <input type="text" placeholder="Search prospects...">
                    </div>
                    <button class="btn" id="bulkEnrichBtn"
                        style="background:#f2f5ff; color:#6d83a3; border:1px solid #cbd6e2;"><i class="fa-solid fa-bolt"
                            style="color:#f5c26b;"></i> Auto-Enrich List</button>
                    <button class="btn btn-primary" id="addLeadBtn"><i class="fa-solid fa-plus"></i> Add Lead</button>
                </div>
            </header>

            <div class="kanban-board">
                <!-- Columns -->
                <div class="kanban-column">
                    <div class="column-header">
                        <div class="col-info"><span class="col-name" style="color:#C4613A;">Cart
                                Abandonments</span><span class="col-count" id="count-web-leads">0</span></div>
                        <span class="col-value" id="value-web-leads">$0</span>
                    </div>
                    <div class="kanban-cards" id="col-web-leads"></div>
                </div>
                <div class="kanban-column">
                    <div class="column-header">
                        <div class="col-info">
                            <span class="col-name" style="color:#2E6EDF;">Email Prospects</span>
                            <span class="col-count" id="count-email-leads">0</span>
                        </div>
                        <span class="col-value" id="value-email-leads">$0</span>
                    </div>
                    <!-- Source Detail Breakdown -->
                    <div class="column-filter-bar" style="padding: 0 16px 10px 16px; display:flex; gap:5px;">
                        <button class="btn-xs active filter-btn" data-filter="all" data-col="col-email"
                            style="font-size:0.6rem;">All</button>
                        <button class="btn-xs filter-btn" data-filter="Manychat" data-col="col-email"
                            style="font-size:0.6rem;">Manychat</button>
                        <button class="btn-xs filter-btn" data-filter="legacy" data-col="col-email"
                            style="font-size:0.6rem;">Imports</button>
                    </div>
                    <div class="kanban-cards" id="col-email"></div>
                </div>
                <div class="kanban-column">
                    <div class="column-header">
                        <div class="col-info"><span class="col-name" style="color:#42B395;">New DMs</span><span
                                class="col-count" id="count-new">0</span></div>
                        <span class="col-value" id="value-new">$0</span>
                    </div>
                    <div class="kanban-cards" id="col-new"></div>
                </div>
                <div class="kanban-column">
                    <div class="column-header">
                        <div class="col-info"><span class="col-name">In Conversation</span><span class="col-count"
                                id="count-convo">0</span></div>
                        <span class="col-value" id="value-convo">$0</span>
                    </div>
                    <div class="kanban-cards" id="col-convo"></div>
                </div>
                <div class="kanban-column">
                    <div class="column-header">
                        <div class="col-info"><span class="col-name" style="color:#F5C26B;">Qualifying</span><span
                                class="col-count" id="count-qualifying">0</span></div>
                        <span class="col-value" id="value-qualifying">$0</span>
                    </div>
                    <div class="kanban-cards" id="col-qualifying"></div>
                </div>
                <div class="kanban-column">
                    <div class="column-header">
                        <div class="col-info"><span class="col-name" style="color:#00a4bd;">Course Sent 🎁</span><span
                                class="col-count" id="count-course-sent">0</span></div>
                        <span class="col-value" id="value-course-sent">$0</span>
                    </div>
                    <div class="kanban-cards" id="col-course-sent"></div>
                </div>
                <div class="kanban-column">
                    <div class="column-header">
                        <div class="col-info"><span class="col-name" style="color:#8168B1;">Call Booked</span><span
                                class="col-count" id="count-booked">0</span></div>
                        <span class="col-value" id="value-booked">$0</span>
                    </div>
                    <div class="kanban-cards" id="col-booked"></div>
                </div>
            </div>
        </main>
    </div>

    <!-- Side Panel -->
    <div class="side-panel-overlay" id="sidePanelOverlay"></div>
    <aside class="side-panel" id="leadSidePanel">
        <div class="side-panel-header">
            <button class="close-panel" id="closeSidePanel"><i class="fa-solid fa-xmark"></i></button>
            <div class="user-profile">
                <div class="avatar" id="panelAvatar">U</div>
                <div class="user-info">
                    <span class="user-name" id="panelNameTitle"
                        style="color:#33475b; font-size:1.1rem;">Loading...</span>
                    <span class="user-role" id="panelStatus" style="color:#516f90;">Prospect</span>
                </div>
            </div>
        </div>

        <div class="tab-container">
            <div class="tab active" data-tab="activity">Details</div>
            <div class="tab" data-tab="ai">AI Outreach</div>
            <div class="tab" data-tab="notes">Notes</div>
            <div class="tab" data-tab="sequences">Sequences</div>
        </div>

        <div class="side-panel-body">
            <!-- Details Section -->
            <div class="panel-section active" id="activitySection">
                <span class="section-title">Edit Deal Info</span>
                <div class="info-grid">
                    <div class="info-item">
                        <label>Deal Value ($)</label>
                        <input type="number" id="editDealValue"
                            style="width:100%; padding:8px; border:1px solid #cbd6e2; border-radius:4px; font-weight:700; color:#42B395;">
                        <button class="btn-xs" id="saveValueBtn" style="margin-top:8px; width:100%;">Update
                            Deal</button>
                    </div>
                    <div class="info-item">
                        <label>Pain Point</label>
                        <select id="editPainPoint"
                            style="width:100%; padding:8px; border:1px solid #cbd6e2; border-radius:4px;">
                            <option value="Custody">Custody Battle</option>
                            <option value="Divorce">Rough Divorce</option>
                            <option value="Finances">Financial Split</option>
                            <option value="Co-parenting">Co-parenting Stress</option>
                            <option value="General">General Support</option>
                        </select>
                    </div>
                </div>

                <span class="section-title" style="margin-top:24px;">Lead Foundation</span>
                <div class="info-grid">
                    <div class="info-item"><label>Full Name</label>
                        <p id="panelLeadName">--</p>
                    </div>
                    <div class="info-item"><label>Email/IG</label>
                        <p id="panelHandle">--</p>
                    </div>
                </div>

                <div style="margin-top:24px;">
                    <button class="btn btn-primary" id="markCourseSentBtn" style="width:100%; background:#2E6EDF;"><i
                            class="fa-solid fa-gift"></i> Mark Course Sent</button>
                </div>

                <!-- CLAY STYLE ENRICHMENT -->
                <span class="section-title" style="margin-top:24px;"><i class="fa-solid fa-bolt"
                        style="color:#f5c26b;"></i> Web Enrichment</span>

                <div id="enrichmentStatus" style="font-size:0.8rem; color:#7c98b6; text-align:center; padding:10px;">
                    Ready to extract public data.</div>

                <div id="enrichedDataBlock"
                    style="display:none; background:#f9fafb; border:1px solid #cbd6e2; border-radius:6px; padding:12px; margin-bottom:12px;">
                    <div style="margin-bottom:8px;"><label
                            style="font-size:0.7rem; color:#516f90; font-weight:700;">LOCATION</label><br><span
                            id="eLocation" style="font-size:0.85rem; font-weight:600;">--</span></div>
                    <div style="margin-bottom:8px;"><label style="font-size:0.7rem; color:#516f90; font-weight:700;">BIO
                            KEYWORDS</label><br><span id="eBio" style="font-size:0.85rem; font-style:italic;">--</span>
                    </div>
                    <div><label style="font-size:0.7rem; color:#516f90; font-weight:700;">LAST POSTED</label><br><span
                            id="eTopic" style="font-size:0.85rem;">--</span></div>
                </div>

                <button class="btn" id="runEnrichmentBtn"
                    style="width:100%; background:#f2f5ff; color:#6d83a3; border:1px solid #cbd6e2;"><i
                        class="fa-solid fa-radar"></i> Run Data Scrape</button>
            </div>

            <!-- AI Section -->
            <div class="ai-box" id="aiSection" style="display:none;">
                <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:12px;">
                    <span style="font-weight:700; color:#33475b; font-size:0.8rem;"><i
                            class="fa-solid fa-wand-magic-sparkles" style="color:#ff7a59;"></i> GENERATED HOOK</span>
                    <button class="btn-xs" id="generateAIHook">Regenerate</button>
                </div>
                <p id="aiHookOutput" style="font-style:italic; color:#516f90; font-size:0.9rem; line-height:1.6;">Click
                    generate to create outreach...</p>
                <button class="btn btn-primary" id="copyHookBtn"
                    style="width:100%; margin-top:16px; font-size:0.8rem;">Copy to Clipboard</button>
            </div>

            <!-- Notes Section -->
            <div class="panel-section" id="notesSection" style="display:none;">
                <span class="section-title">Timeline & Notes</span>
                <textarea id="noteInput"
                    style="width:100%; height:100px; padding:12px; border:1px solid #cbd6e2; border-radius:4px; margin-bottom:12px;"
                    placeholder="Add a note..."></textarea>
                <button class="btn btn-primary" id="saveNoteBtn" style="width:100%;">Save Note</button>
                <div class="timeline" id="leadTimeline" style="margin-top:20px;"></div>
            </div>
            <!-- Sequences Section -->
            <div class="panel-section" id="sequencesSection" style="display:none;">
                <span class="section-title">Email Sequences</span>
                <div style="background:#f9fafb; border:1px solid #e5e7eb; border-radius:6px; padding:16px;">
                    <div style="margin-bottom:16px;">
                        <label style="display:block; font-size:0.75rem; color:#6b7280; margin-bottom:4px;">Select
                            Sequence</label>
                        <select id="sequenceSelect"
                            style="width:100%; padding:10px; border:1px solid #d1d5db; border-radius:4px;">
                            <option value="">-- Choose a Campaign --</option>
                            <option value="new_follower">New Follower Welcome (5 Days)</option>
                            <option value="abandoned_cart">Abandoned Cart Recovery (3 Days)</option>
                            <option value="re_engagement">90-Day Re-engagement</option>
                        </select>
                    </div>
                    <button class="btn btn-primary" id="enrollBtn" style="width:100%;">Enroll Lead in Sequence</button>
                </div>

                <div style="margin-top:24px;">
                    <span class="section-title">Active Enrollment</span>
                    <div id="activeSequenceStatus"
                        style="padding:12px; border:1px dashed #cbd6e2; border-radius:4px; text-align:center; color:#7c98b6; font-size:0.85rem;">
                        No active sequence enrollment.
                    </div>
                </div>
            </div>
        </div>
    </aside>

    <!-- Social Quick-Add Modal -->
    <div class="modal-overlay" id="addLeadModalOverlay">
        <div class="modal">
            <div class="modal-header">
                <h3><i class="fa-solid fa-user-plus"></i> Social Quick-Add</h3>
                <button class="close-panel" id="closeAddLeadModal"><i class="fa-solid fa-xmark"></i></button>
            </div>
            <div class="modal-body">
                <div class="form-group">
                    <label>Instagram Handle</label>
                    <input type="text" id="newLeadHandle" placeholder="@username">
                </div>
                <div class="form-group">
                    <label>Full Name (Optional)</label>
                    <input type="text" id="newLeadName" placeholder="Lead Name">
                </div>
                <div class="form-group">
                    <label>Primary Pain Point</label>
                    <select id="newLeadPainPoint">
                        <option value="Custody">Custody Battle</option>
                        <option value="Divorce">Rough Divorce</option>
                        <option value="Finances">Financial Split</option>
                        <option value="Co-parenting">Co-parenting Stress</option>
                        <option value="General" selected>General Support</option>
                    </select>
                </div>
                <div class="form-group">
                    <label>Initial Note</label>
                    <textarea id="newLeadNote" rows="3" placeholder="e.g. In DMs, wants the free product..."></textarea>
                </div>
            </div>
            <div class="modal-footer">
                <button class="btn" id="cancelAddLead" style="background:#eaf0f6; color:#516f90;">Cancel</button>
                <button class="btn btn-primary" id="saveNewLeadBtn">Save to CRM</button>
            </div>
        </div>
    </div>


    <!-- Secure Auth Gate -->
    <script is:inline src="/crm/auth-gate.js"></script>
        <!--Supabase SDK-- >
    <!-- Supabase SDK -->
    <script is:inline src="https://unpkg.com/@supabase/supabase-js@2"></script>
    <script is:inline src="/crm/supabase-client.js"></script>
    <script is:inline src="/crm/script.js"></script>
</body>

</html>