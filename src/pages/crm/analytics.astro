                <div class="pt-4 pb-2 text-xs font-bold text-white/40 uppercase tracking-widest px-4" style="margin-top: 15px; font-size: 10px; letter-spacing: 1px;">Marketing</div>
                <a href="/crm/seo" class="nav-item">
                    <i class="fa-solid fa-search"></i>
                    <span>SEO Manager</span>
                </a>
                <a href="/crm/schema" class="nav-item">
                    <i class="fa-solid fa-code"></i>
                    <span>Schema Injector</span>
                </a>
                <a href="/crm/cro" class="nav-item">
                    <i class="fa-solid fa-chart-column"></i>
                    <span>CRO Analysis</span>
                </a>
            </nav>

            <div class="secondary-nav">
                <a href="#" class="nav-item">
                    <i class="fa-solid fa-gear"></i>
                    <span>Settings</span>
                </a>
                <a href="#" class="nav-item">
                    <i class="fa-solid fa-circle-question"></i>
                    <span>Help Center</span>
                </a>
            </div>

            <div class="user-profile">
                <img src="https://ui-avatars.com/api/?name=Greg+Montoya&background=3b82f6&color=fff" alt="User"
                    class="avatar">
                <div class="user-info">
                    <p class="user-name">Greg Montoya</p>
                    <p class="user-role">Admin</p>
                </div>
                <i class="fa-solid fa-chevron-right"></i>
            </div>
