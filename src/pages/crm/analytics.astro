                </a>
                <a href="/crm/prospects" class="nav-item">
                    <i class="fa-brands fa-instagram"></i>
                    <span>IG Prospects</span>
                </a>
                <a href="#" class="nav-item">
                    <i class="fa-solid fa-chart-line"></i>
                    <span>Deals</span>
                </a>
                <a href="#" class="nav-item">
                    <i class="fa-solid fa-envelope"></i>
