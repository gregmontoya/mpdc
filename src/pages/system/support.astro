---
import SystemLayout from '../../layouts/SystemLayout.astro';
---

<SystemLayout title="Technical Support" activePage="course">
    <div class="support-container">
        <div class="support-header">
            <h1>Technical Support</h1>
            <p>Having trouble accessing materials or navigating the system? Fill out the form below and our team will get back to you within 24 hours.</p>
        </div>

        <div class="support-card">
            <form id="support-form" class="premium-form">
                <div class="form-group">
                    <label for="subject">What do you need help with?</label>
                    <select id="subject" required>
                        <option value="">Select an issue...</option>
                        <option value="login">Login / Password Issues</option>
                        <option value="video">Video Playback Issues</option>
                        <option value="downloads">Downloadable Resources</option>
                        <option value="billing">Billing / Account Questions</option>
                        <option value="other">Other Technical Issue</option>
                    </select>
                </div>

                <div class="form-group">
                    <label for="message">Details</label>
                    <textarea id="message" rows="5" placeholder="Please describe the issue in detail..." required></textarea>
                </div>

                <button type="submit" class="btn-submit">
                    <span>Submit Request</span>
                    <i class="fas fa-paper-plane"></i>
                </button>
            </form>

            <div id="success-message" class="hidden">
                <div class="success-icon"><i class="fas fa-check-circle"></i></div>
                <h3>Request Sent</h3>
                <p>We've received your support ticket. Check your email for a confirmation shortly.</p>
                <a href="/system/dashboard" class="btn-back">Back to Dashboard</a>
            </div>
        </div>
    </div>

    <style>
        .support-container {
            max-width: 600px;
            margin: 0 auto;
            padding: 2rem 0;
        }

        .support-header {
            text-align: center;
            margin-bottom: 3rem;
        }

        .support-header h1 {
            font-size: 2.5rem;
            font-weight: 800;
            color: #1a1f24;
            margin-bottom: 1rem;
        }

        .support-header p {
            color: #64748b;
            line-height: 1.6;
        }

        .support-card {
            background: #fff;
            padding: 3rem;
            border-radius: 24px;
            border: 1px solid #e2e8f0;
            box-shadow: 0 20px 50px rgba(0,0,0,0.05);
        }

        .premium-form {
            display: flex;
            flex-direction: column;
            gap: 1.5rem;
        }

        .form-group {
            display: flex;
            flex-direction: column;
            gap: 0.5rem;
        }

        .form-group label {
            font-size: 0.85rem;
            font-weight: 700;
            color: #1a1f24;
            text-transform: uppercase;
            letter-spacing: 1px;
        }

        .form-group select, .form-group textarea {
            padding: 1rem;
            border-radius: 12px;
            border: 1px solid #e2e8f0;
            font-family: inherit;
            font-size: 1rem;
            transition: all 0.2s;
            background: #f8fafc;
        }

        .form-group select:focus, .form-group textarea:focus {
            outline: none;
            border-color: #C4613A;
            background: #fff;
            box-shadow: 0 0 0 4px rgba(196, 97, 58, 0.1);
        }

        .btn-submit {
            background: #C4613A;
            color: #fff;
            padding: 1.25rem;
            border: none;
            border-radius: 12px;
            font-weight: 800;
            font-size: 1rem;
            text-transform: uppercase;
            letter-spacing: 1px;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 12px;
            transition: all 0.3s;
            margin-top: 1rem;
        }

        .btn-submit:hover {
            background: #1a1f24;
            transform: translateY(-2px);
            box-shadow: 0 10px 20px rgba(0,0,0,0.1);
        }

        #success-message {
            text-align: center;
            padding: 2rem 0;
        }

        .success-icon {
            font-size: 4rem;
            color: #22c55e;
            margin-bottom: 1.5rem;
        }

        .btn-back {
            display: inline-block;
            margin-top: 2rem;
            color: #C4613A;
            text-decoration: none;
            font-weight: 700;
        }

        .hidden { display: none; }
    </style>

    <script>
        import { db } from '../../lib/firebase';
        import { collection, addDoc, serverTimestamp } from 'firebase/firestore';

        const form = document.getElementById('support-form');
        const successMessage = document.getElementById('success-message');

        form.onsubmit = async (e) => {
            e.preventDefault();
            const btn = form.querySelector('button');
            btn.disabled = true;
            btn.textContent = 'Sending...';

            const user = (localStorage.getItem('firebase_dev_bypass') ? JSON.parse(localStorage.getItem('firebase_dev_bypass')) : null);

            try {
                await addDoc(collection(db, 'support_tickets'), {
                    userId: user?.uid || 'anonymous',
                    userEmail: user?.email || 'unknown',
                    subject: document.getElementById('subject').value,
                    message: document.getElementById('message').value,
                    timestamp: serverTimestamp(),
                    status: 'open'
                });

                form.classList.add('hidden');
                successMessage.classList.remove('hidden');
            } catch (err) {
                console.error(err);
                alert('Submit failed. Please try again or email hello@menspostdivorcecoaching.com');
                btn.disabled = false;
                btn.textContent = 'Submit Request';
            }
        };
    </script>
</SystemLayout>
