---
import SystemLayout from '../../layouts/SystemLayout.astro';
---

<SystemLayout title="Dashboard" activePage="dashboard">
        <div class="dashboard-header">
            <h1 id="welcome-greeting">Welcome back.</h1>
            <div class="quote-container">
                <span class="quote-label">QUOTE OF THE WEEK</span>
                <p id="quote-text">"Focus on the step in front of you, not the whole staircase."</p>
            </div>
        </div>

    <script is:inline>
        const MINSET_QUOTES = [
            "Focus on the step in front of you, not the whole staircase.",
            "The man who moves a mountain begins by carrying away small stones.",
            "Discipline is doing what needs to be done, even if you don't want to do it.",
            "Your current situation is not your final destination.",
            "The best revenge is massive success.",
            "Hard times create strong men. Strong men create good times.",
            "You did not come this far to only come this far.",
            "Amateurs wait for inspiration. Professionals get to work.",
            "Your ex-wife's frame is a cage. Your future is the key.",
            "Silence the noise. Reclaim your center."
        ];

        function setWeeklyQuote() {
            const now = new Date();
            const start = new Date(now.getFullYear(), 0, 1);
            const diff = now - start;
            const oneDay = 1000 * 60 * 60 * 24;
            const dayOfYear = Math.floor(diff / oneDay);
            const weekOfYear = Math.floor(dayOfYear / 7);
            
            const quoteIndex = weekOfYear % MINSET_QUOTES.length;
            const quoteEl = document.getElementById('quote-text');
            if(quoteEl) quoteEl.textContent = `"${MINSET_QUOTES[quoteIndex]}"`;
        }

        async function updateWelcomeGreeting() {
            const greetingEl = document.getElementById('welcome-greeting');
            if (!greetingEl) return;

            // Check if Firebase is initialized (from SystemLayout)
            if (typeof firebase === 'undefined' || !firebase.auth) {
                greetingEl.textContent = 'Welcome back.';
                return;
            }

            const auth = firebase.auth();
            const user = auth.currentUser;

            if (!user) {
                greetingEl.textContent = 'Welcome back.';
                return;
            }

            try {
                const db = firebase.firestore();
                const doc = await db.collection('profiles').doc(user.uid).get();
                
                if (doc.exists && doc.data().name) {
                    const fullName = doc.data().name;
                    // Extract first name (everything before first space)
                    const firstName = fullName.split(' ')[0];
                    greetingEl.textContent = `Welcome back, ${firstName}.`;
                } else if (user.displayName) {
                    const firstName = user.displayName.split(' ')[0];
                    greetingEl.textContent = `Welcome back, ${firstName}.`;
                } else {
                    greetingEl.textContent = 'Welcome back.';
                }
            } catch (error) {
                console.error('Error fetching user name:', error);
                greetingEl.textContent = 'Welcome back.';
            }
        }

        function updateProgress() {
            if (typeof firebase === 'undefined' || !firebase.auth) return;
            const user = firebase.auth().currentUser;
            if (!user) return;

            const progressKey = `mpdc_progress_${user.uid}`;
            const completed = JSON.parse(localStorage.getItem(progressKey) || '[]');
            const totalModules = 6; // Intro + 5 Modules
            const progress = (completed.length / totalModules) * 100;

            const percentEl = document.getElementById('progress-percent');
            const modulesEl = document.getElementById('progress-modules');
            const ringEl = document.getElementById('progress-ring');
            const textEl = document.getElementById('progress-text');

            if (percentEl) percentEl.textContent = `${Math.round(progress)}%`;
            if (modulesEl) modulesEl.textContent = `${completed.length}/${totalModules}`;
            if (textEl) textEl.textContent = `${Math.round(progress)}%`;
            if (ringEl) ringEl.setAttribute('stroke-dasharray', `${progress}, 100`);
        }

        document.addEventListener('DOMContentLoaded', () => {
            setWeeklyQuote();
            // Wait a bit for Firebase to initialize from SystemLayout
            setTimeout(() => {
                updateWelcomeGreeting();
                updateProgress();
            }, 800);
        });
    </script>

        <!-- Hero Progress Card -->
        <div class="hero-progress-card">
            <div class="card-glow"></div>
            <div class="progress-content">
                <div class="progress-left">
                    <span class="eyebrow">CONTINUE TRAINING</span>
                    <h2>Men's Divorce<br/>Mindset System</h2>
                    <div class="progress-stats">
                        <div class="stat">
                            <span class="stat-value" id="progress-percent">0%</span>
                            <span class="stat-label">Complete</span>
                        </div>
                        <div class="stat-divider"></div>
                        <div class="stat">
                            <span class="stat-value" id="progress-modules">0/6</span>
                            <span class="stat-label">Modules</span>
                        </div>
                    </div>
                </div>
                <div class="progress-right">
                    <div class="circular-progress">
                        <svg viewBox="0 0 36 36" class="circular-chart">
                            <path class="circle-bg" d="M18 2.0845 a 15.9155 15.9155 0 0 1 0 31.831 a 15.9155 15.9155 0 0 1 0 -31.831" />
                            <path class="circle" id="progress-ring" stroke-dasharray="0, 100" d="M18 2.0845 a 15.9155 15.9155 0 0 1 0 31.831 a 15.9155 15.9155 0 0 1 0 -31.831" />
                        </svg>
                        <div class="percentage" id="progress-text">0%</div>
                    </div>
                    <a href="/system/course" class="btn-resume">
                        RESUME COURSE <i class="fas fa-play"></i>
                    </a>
                </div>
            </div>
        </div>

        <div class="section-divider">
            <span>UPCOMING & MODULES</span>
        </div>

        <div class="cards-grid">
            <!-- Hypnosis Bundle Card (Conditional) -->
            <div class="action-card" id="hypnosis-card" style="display: none; border-color: #C4613A; background: #fffcfb;">
                <div class="card-icon" style="background: #C4613A; color: #fff;"><i class="fas fa-star"></i></div>
                <h3>Hypnosis Audio Bundle</h3>
                <p>Access your premium subconscious reprogramming tracks and guided mindset audio.</p>
                <a href="/system/hypnosis" class="card-btn" style="color: #C4613A;">Open Audio Portal →</a>
            </div>

            <div class="action-card">
                <div class="card-icon"><i class="fas fa-users"></i></div>
                <h3>The Post Divorce Advantage</h3>
                <p>A structured path to clarity, confidence, and control for men after divorce.</p>
                <a href="https://www.skool.com/the-post-divorce-advantage-8284" target="_blank" class="card-btn">Open Community</a>
            </div>

            <div class="action-card">
                <div class="card-icon"><i class="fas fa-user-tie"></i></div>
                <h3>1-on-1 Assessment Call</h3>
                <p>Identify the programs in your mind keeping you stuck and assess the best way to move forward.</p>
                <a href="/clarity-call" target="_blank" class="card-btn">Book Free 30-Minute Assessment</a>
            </div>

            <div class="action-card">
                <div class="card-icon"><i class="fas fa-life-ring"></i></div>
                <h3>Technical Support</h3>
                <p>Having trouble? Our team is here to help you get back on track.</p>
                <a href="/system/support" class="card-btn">Submit Ticket</a>
            </div>
        </div>


    <style>
        .dashboard-header {
            margin-bottom: 3.5rem;
        }

        .dashboard-header h1 {
            font-size: 2.8rem;
            color: #1a1f24;
            margin-bottom: 0.5rem;
            font-weight: 800;
            letter-spacing: -0.5px;
            text-transform: none;
        }

        .dashboard-header p {
            color: #64748b;
            font-size: 1.1rem;
        }

        .quote-container {
            margin-top: 1.5rem;
            display: flex;
            flex-direction: column;
            gap: 0.25rem;
        }

        .quote-label {
            font-size: 0.65rem;
            font-weight: 900;
            color: #C4613A;
            letter-spacing: 2px;
            text-transform: uppercase;
        }

        #quote-text {
            font-style: italic;
            font-weight: 500;
            max-width: 600px;
        }

        /* HERO CARD */
        .hero-progress-card {
            background: #ffffff;
            border: 1px solid #e2e8f0;
            border-radius: 24px;
            padding: 3.5rem;
            position: relative;
            overflow: hidden;
            box-shadow: 0 10px 40px rgba(0, 0, 0, 0.03);
            margin-bottom: 4rem;
        }

        .card-glow {
            position: absolute;
            top: -50%;
            right: -10%;
            width: 500px;
            height: 500px;
            background: radial-gradient(circle, rgba(196, 97, 58, 0.05) 0%, transparent 70%);
            pointer-events: none;
        }

        .progress-content {
            display: flex;
            justify-content: space-between;
            align-items: center;
            position: relative;
            z-index: 1;
        }

        .eyebrow {
            font-size: 0.75rem;
            font-weight: 800;
            color: #C4613A;
            letter-spacing: 2px;
            text-transform: uppercase;
            display: block;
            margin-bottom: 1rem;
        }

        .progress-left h2 {
            font-size: 2.5rem;
            line-height: 1.1;
            color: #1a1f24;
            margin-bottom: 2rem;
            text-transform: none;
        }

        .progress-stats {
            display: flex;
            gap: 2.5rem;
            align-items: center;
        }

        .stat-value {
            display: block;
            font-size: 1.5rem;
            font-weight: 800;
            color: #1a1f24;
        }

        .stat-label {
            font-size: 0.8rem;
            color: #64748b;
            font-weight: 600;
            text-transform: uppercase;
        }

        .stat-divider {
            width: 1px;
            height: 30px;
            background: #e2e8f0;
        }

        .progress-right {
            text-align: right;
            display: flex;
            flex-direction: column;
            align-items: flex-end;
            gap: 2rem;
        }

        .circular-progress {
            position: relative;
            width: 120px;
            height: 120px;
        }

        .circular-chart {
            display: block;
            margin: 10px auto;
            max-width: 100%;
            max-height: 250px;
        }

        .circle-bg {
            fill: none;
            stroke: #f1f5f9;
            stroke-width: 2.8;
        }

        .circle {
            fill: none;
            stroke: #C4613A;
            stroke-width: 2.8;
            stroke-linecap: round;
        }

        .percentage {
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            font-size: 1.2rem;
            font-weight: 800;
            color: #1a1f24;
        }

        .btn-resume {
            background: #1a1f24;
            color: #fff;
            padding: 1rem 2rem;
            border-radius: 12px;
            font-weight: 800;
            font-size: 0.85rem;
            letter-spacing: 1px;
            display: flex;
            align-items: center;
            gap: 0.75rem;
            transition: all 0.2s;
        }

        .btn-resume:hover {
            background: #C4613A;
            transform: translateY(-2px);
            box-shadow: 0 5px 15px rgba(196, 97, 58, 0.3);
        }

        /* GRID SECTION */
        .section-divider {
            display: flex;
            align-items: center;
            gap: 1.5rem;
            margin-bottom: 2.5rem;
        }

        .section-divider span {
            font-size: 0.75rem;
            font-weight: 800;
            color: #94a3b8;
            letter-spacing: 2px;
            white-space: nowrap;
        }

        .section-divider::after {
            content: '';
            flex: 1;
            height: 1px;
            background: #e2e8f0;
        }

        .cards-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
            gap: 2rem;
        }

        .action-card {
            background: #fff;
            padding: 2.5rem;
            border-radius: 20px;
            border: 1px solid #e2e8f0;
            transition: all 0.3s;
        }

        .action-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 20px 40px rgba(0, 0, 0, 0.05);
            border-color: #cbd5e1;
        }

        .card-icon {
            width: 50px;
            height: 50px;
            background: #fff1eb;
            color: #C4613A;
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.5rem;
            margin-bottom: 1.5rem;
        }

        .action-card h3 {
            font-size: 1.25rem;
            margin-bottom: 1rem;
            color: #1a1f24;
            text-transform: none;
        }

        .action-card p {
            font-size: 0.95rem;
            color: #64748b;
            line-height: 1.6;
            margin-bottom: 2rem;
        }

        .card-btn {
            display: inline-block;
            font-weight: 700;
            font-size: 0.9rem;
            color: #C4613A;
            text-decoration: none;
            transition: color 0.2s;
        }

        .card-btn:hover {
            color: #a54f2f;
        }

        .action-card.locked {
            background: #f8fafc;
            opacity: 0.8;
            pointer-events: none;
        }

        .badge {
            background: #e2e8f0;
            color: #64748b;
            padding: 4px 10px;
            border-radius: 6px;
            font-size: 0.65rem;
            font-weight: 800;
            letter-spacing: 0.5px;
        }

        @media (max-width: 768px) {
            .progress-content { flex-direction: column; align-items: flex-start; gap: 2.5rem; }
            .progress-right { align-items: flex-start; }
            .hero-progress-card { padding: 2rem; }
        }
    </style>
</SystemLayout>
