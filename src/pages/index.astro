---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Men's Post-Divorce Coaching - Rebuild Your Life">
    <!-- HERO SECTION -->
    <header id="hero" class="section hero-section" style="position: relative; padding: 6rem 0;">
        <div style="max-width: 1100px; width: 100%; margin: 0 auto; padding: 0 2rem; text-align: center;">
            <p
                style="font-size: 1rem; margin-bottom: 2rem; letter-spacing: 3px; text-transform: uppercase; color: var(--color-text-muted);">
                The #1 Resource for Men Reclaiming Their Edge</p>
            <h1 style="font-size: 4rem; line-height: 1.15; margin-bottom: 2.5rem; color: #fff;">
                Your Marriage Ended.<br>
                <span
                    style="color: var(--color-text-muted); border-bottom: 4px solid var(--color-accent); padding-bottom: 0.25rem;">Your
                    Comeback Starts Now.</span>
            </h1>
            <p style="font-size: 1.25rem; line-height: 1.6; margin-bottom: 1rem; color: var(--color-text-muted);">Stop
                the "replay" loop. The problem isn't logical—it's biological.</p>
            <p style="font-size: 1.25rem; line-height: 1.6; margin-bottom: 2.5rem; color: #fff; font-weight: 600;">Get
                the 5-step system to break the cycle and start your comeback.</p>
            <a href="#" class="mpdc-btn mpdc-btn-lg">Explore The System →</a>
            <p
                style="font-size: 0.85rem; margin-top: 1.5rem; letter-spacing: 1px; text-transform: uppercase; color: var(--color-text-muted);">
                Free Instant Access • 100% Private</p>
        </div>
    </header>

    <!-- COMMUNITY SECTION -->
    <section class="section community-block-section" style="background-color: var(--color-text-muted);">
        <div class="container">
            <div class="module-box" style="margin-bottom: 0; background: #fff; border: 1px solid #d4c5a9;">
                <div class="module-content-left" style="padding: 4rem;">
                    <h2 style="margin-bottom: 2rem; color: var(--color-accent); line-height: 1.1;">
                        <span style="font-size: 3.5rem; font-weight: 900; text-transform: uppercase;">JOIN</span><br>
                        <span style="font-size: 1.75rem; font-weight: 700; color: var(--color-bg-primary);">The Post
                            Divorce Advantage</span>
                    </h2>
                    <p
                        style="font-size: 1.25rem; line-height: 1.6; margin-bottom: 2rem; color: var(--color-text-dark); font-weight: 600;">
                        The Only Community Built Specifically for Divorced Men Who Want to Rebuild Stronger (Not Just
                        Survive)
                    </p>
                    <ul class="benefit-bullets" style="margin-bottom: 2.5rem;">
                        <li style="color: var(--color-text-dark); margin-bottom: 1rem; font-weight: 500;"><strong>Weekly
                                live Q&A sessions</strong> with Alex</li>
                        <li style="color: var(--color-text-dark); margin-bottom: 1rem; font-weight: 500;">
                            <strong>Private forum</strong> for men who’ve been where you are
                        </li>
                        <li style="color: var(--color-text-dark); margin-bottom: 1rem; font-weight: 500;">
                            <strong>Exclusive hypnosis recordings</strong> & frameworks
                        </li>
                        <li style="color: var(--color-text-dark); margin-bottom: 1rem; font-weight: 500;">
                            <strong>Accountability partners</strong> who actually understand
                        </li>
                    </ul>
                    <div style="text-align: center;">
                        <a href="#" class="mpdc-btn" style="padding: 1.25rem 3rem; font-size: 1.1rem; width: 100%;">Join
                            The Advantage →</a>
                        <p style="margin-top: 1rem; font-size: 0.85rem; color: var(--color-text-dark); opacity: 0.7;">
                            Secure Access • Cancel Anytime • 100% Confidential</p>
                    </div>
                </div>
                <div class="module-content-right" style="padding: 0; background-color: #000;">
                    <img src="/images/community-lounge.png" alt="MPDC Community"
                        style="width: 100%; height: 100%; object-fit: cover;">
                </div>
            </div>
        </div>
    </section>

    <!-- Content moved to blocks.html -->
</Layout>
