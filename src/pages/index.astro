---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Men's Post-Divorce Coaching - Rebuild Your Life">
    <!-- HERO SECTION -->
    <header id="hero" class="section hero-section" style="position: relative; padding: 6rem 0;">
        <div style="max-width: 1100px; width: 100%; margin: 0 auto; padding: 0 2rem; text-align: center;">
            <p
                style="font-size: 1rem; margin-bottom: 2rem; letter-spacing: 3px; text-transform: uppercase; color: var(--color-text-muted);">
                The #1 Resource for Men Reclaiming Their Edge</p>
            <h1 style="font-size: 4rem; line-height: 1.15; margin-bottom: 2.5rem; color: #fff;">
                THE SYSTEM FOR MEN WHO REFUSE TO LET<br>
                <span class="text-gradient">DIVORCE DEFINE THEM</span>
            </h1>

            <p class="hero-subtitle"
                style="font-size: 1.35rem; margin-bottom: 3.5rem; max-width: 800px; margin-left: auto; margin-right: auto; color: var(--color-text-light);">
                Stop reacting to her chaos. Start building your empire. The <span
                    style="color: var(--color-accent); font-weight: 600;">Men's Divorce Mindset System</span> bridges the
                gap between emotional devastation and tactical dominance.
            </p>

            <div class="hero-cta-group">
                <a href="/join/" class="cta-btn cta-primary">Start The System</a>
                <a href="/about" class="cta-btn cta-secondary">Read Our Mission</a>
            </div>
        </div>
    </header>


    <!-- SOCIAL PROOF / AS SEEN IN -->
    <div class="logo-cloud-section">
        <p class="logo-cloud-title">TRUSTED BY MEN FROM</p>
        <div class="logo-cloud-grid">
            <!-- Simple text placeholders for logos -->
            <div class="logo-item">FORTUNE 500</div>
            <div class="logo-item">MILITARY</div>
            <div class="logo-item">FIRST RESPONDERS</div>
            <div class="logo-item">C-SUITE EXEC</div>
            <div class="logo-item">ENTREPRENEURS</div>
        </div>
    </div>


    <!-- PROBLEM AWARENESS -->
    <section class="section">
        <div class="container">
            <div class="grid-2">
                <div class="content-col">
                    <h2 class="section-title">The Game Has Changed.<br>Have You?</h2>
                    <p style="margin-bottom: 1.5rem;">
                        Society tells you to "be vulnerable," "do the work," and "just move on." Meanwhile, the legal
                        system, your ex, and your own nervous system are conspiring to keeping you stuck in a loop of
                        guilt and reaction.
                    </p>
                    <p style="margin-bottom: 2rem;">
                        Most "divorce recovery" is just therapy-lite: talking about your feelings until you're exhausted.
                        <b>MPDC is different.</b> We don't just talk. We install a new operating system for your life.
                    </p>
                    <a href="/join/" class="text-link">See the Difference &rarr;</a>
                </div>
                <div class="image-col">
                    <!-- Placeholder for High-Impact Image -->
                    <div
                        style="width: 100%; height: 400px; background: #222; border-left: 4px solid var(--color-accent); display: flex; align-items: center; justify-content: center; color: #555;">
                        [ IMAGE: A man standing confident looking at horizon ]
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- CORE PILLARS -->
    <section class="section bg-dark">
        <div class="container">
            <div class="section-header text-center">
                <h2 class="section-title">The 3 Pillars of Rebuilding</h2>
                <p class="section-subtitle">A tactical approach to reclaiming your power.</p>
            </div>

            <div class="features-grid">
                <div class="feature-card">
                    <div class="feature-icon">🛡️</div>
                    <h3 class="feature-title">Unshakeable Frame</h3>
                    <p>Learn to control your nervous system so her chaos bounces off you like water off a rock.</p>
                </div>
                <div class="feature-card">
                    <div class="feature-icon">🚀</div>
                    <h3 class="feature-title">Strategic Vision</h3>
                    <p>Stop putting out fires. Start architectural planning for a life that excites you again.</p>
                </div>
                <div class="feature-card">
                    <div class="feature-icon">⚡</div>
                    <h3 class="feature-title">Action Protocols</h3>
                    <p>Specific, step-by-step tactics for dating, co-parenting, and finance.</p>
                </div>
            </div>
            
            <div class="text-center" style="margin-top: 4rem;">
               <a href="/join/" class="cta-btn cta-primary">Join The System</a>
            </div>
        </div>
    </section>
</Layout>
