---
import Layout from '../layouts/Layout.astro';
import { Image } from 'astro:assets';
import alexMorganImg from '../assets/images/alex-morgan.png';
import communityLoungeImg from '../assets/images/community-lounge.png';
export const prerender = true;
---

<Layout title="Men's Post-Divorce Coaching - Rebuild Your Life">
    <!-- HERO SECTION -->
    <header id="hero" class="section hero-section" style="position: relative; padding: 6rem 0;">
        <div style="max-width: 1100px; width: 100%; margin: 0 auto; padding: 0 2rem; text-align: center;">
            <p
                style="font-size: 1rem; margin-bottom: 2rem; letter-spacing: 3px; text-transform: uppercase; color: var(--color-text-muted);">
                The #1 Resource for Men Reclaiming Their Edge</p>
            
            <h1 style="font-size: 4rem; line-height: 1.15; margin-bottom: 2.5rem; color: #fff;">
                Your Marriage Ended.<br>
                <span
                    style="color: var(--color-text-muted); border-bottom: 4px solid var(--color-accent); padding-bottom: 0.25rem;">Your
                    Comeback Starts Now.</span>
            </h1>
            <p style="font-size: 1.25rem; line-height: 1.6; margin-bottom: 1rem; color: var(--color-text-muted);">Stop
                the "replay" loop. The problem isn't logical—it's biological.</p>
            <p style="font-size: 1.25rem; line-height: 1.6; margin-bottom: 2.5rem; color: #fff; font-weight: 600;">Get
                the 5-step system to break the cycle and start your comeback.</p>
            <a href="/join" class="mpdc-btn mpdc-btn-lg">Build Your Future →</a>
            <p
                style="font-size: 0.85rem; margin-top: 1.5rem; letter-spacing: 1px; text-transform: uppercase; color: var(--color-text-muted);">
                Free Instant Access • 100% Private</p>
        </div>
    </header>

    <!-- COMMUNITY SECTION (Extracted from Live) -->
    <section class="section community-block-section" style="background-color: var(--color-text-muted);">
        <div class="container">
            <div class="module-box" style="margin-bottom: 0; background: #fff; border: 1px solid #d4c5a9;">
                <div class="module-content-left" style="padding: 4rem;">
                    <h2 style="margin-bottom: 2rem; color: var(--color-accent); line-height: 1.1;">
                        <span style="font-size: 3.5rem; font-weight: 900; text-transform: uppercase;">JOIN</span><br>
                        <span style="font-size: 1.75rem; font-weight: 700; color: var(--color-bg-primary);">The Post
                            Divorce Advantage</span>
                    </h2>
                    <p
                        style="font-size: 1.25rem; line-height: 1.6; margin-bottom: 2rem; color: var(--color-text-dark); font-weight: 600;">
                        The Only Community Built Specifically for Divorced Men Who Want to Rebuild Stronger (Not Just
                        Survive)
                    </p>
                    <ul class="benefit-bullets" style="margin-bottom: 2.5rem;">
                        <li style="color: var(--color-text-dark); margin-bottom: 1rem; font-weight: 500;"><strong>Weekly
                                live Q&A sessions</strong> with Alex</li>
                        <li style="color: var(--color-text-dark); margin-bottom: 1rem; font-weight: 500;">
                            <strong>Private forum</strong> for men who’ve been where you are
                        </li>
                        <li style="color: var(--color-text-dark); margin-bottom: 1rem; font-weight: 500;">
                            <strong>Exclusive hypnosis recordings</strong> & frameworks
                        </li>
                        <li style="color: var(--color-text-dark); margin-bottom: 1rem; font-weight: 500;">
                            <strong>Accountability partners</strong> who actually understand
                        </li>
                    </ul>
                    <div style="text-align: center;">
                        <a href="https://www.skool.com/the-post-divorce-advantage-8284" target="_blank" class="mpdc-btn" style="padding: 1.25rem 3rem; font-size: 1.1rem; width: 100%;">Join
                            The Advantage →</a>
                        <p style="margin-top: 1rem; font-size: 0.85rem; color: var(--color-text-dark); opacity: 0.7;">
                            Secure Access • Cancel Anytime • 100% Confidential</p>
                    </div>
                </div>
                <div class="module-content-right" style="padding: 0; background-color: #000; overflow: hidden; display: flex;">
                    <Image 
                        src={communityLoungeImg} 
                        alt="MPDC Community"
                        width={600}
                        height={600}
                        class="optimized-img"
                        style="width: 100%; height: 100%; object-fit: cover;"
                        loading="eager"
                        fetchpriority="high"
                    />
                </div>
            </div>
        </div>
    </section>

    <!-- ABOUT SECTION (Extracted from Live) -->
    <section id="about" class="section" style="background-color: #fff; color: var(--color-text-dark); padding: 6rem 2rem;">
        <div class="container" style="max-width: 1100px;">
            <div class="founder-grid" style="display: grid; grid-template-columns: 1fr 1fr; gap: 4rem; align-items: start;">
                <!-- Left Col: Image + Button -->
                <div style="position: relative;" class="founder-image-container">
                    <!-- Image Placeholder (Dark Green Box) -->
                    <div style="width: 100%; aspect-ratio: 3/4; background-color: var(--color-bg-dark); border-radius: 8px; position: relative; overflow: hidden; display: flex; align-items: center; justify-content: center;">
                        <Image 
                            src={alexMorganImg} 
                            alt="Alex Morgan" 
                            width={600}
                            height={800}
                            class="optimized-img"
                            style="width: 100%; height: 100%; object-fit: cover; opacity: 0.8;"
                        />
                    </div>
                    <!-- Floating Button -->
                    <div style="position: absolute; bottom: -20px; right: -20px; z-index: 10;" class="floating-cta-btn">
                        <a href="/join" style="background-color: var(--color-accent); color: #fff; padding: 1rem 2rem; font-weight: 700; text-transform: uppercase; letter-spacing: 1px; border-radius: 4px; box-shadow: 0 10px 20px rgba(196, 97, 58, 0.4); text-decoration: none; display: inline-block;">
                            I'll Show You How.
                        </a>
                    </div>
                </div>
                <!-- Right Col: Copy + Box -->
                <div style="text-align: left;">
                    <p style="color: var(--color-accent); font-weight: 700; letter-spacing: 2px; text-transform: uppercase; font-size: 0.9rem; margin-bottom: 0.5rem;" class="about-intro-text">ABOUT THE FOUNDER</p>
                    <h1 style="font-family: var(--font-heading); font-size: 3.5rem; color: var(--color-bg-primary); margin-bottom: 0.5rem; line-height: 1.15;">I'M ALEX MORGAN.</h1>
                    <p style="font-weight: 700; color: #666; font-size: 1.1rem; margin-bottom: 2rem;">Certified Mental Programmer & Founder, MPDC</p>
                    <p style="font-size: 1.1rem; line-height: 1.7; color: var(--color-text-dark); margin-bottom: 1.5rem;">
                        I haven't just "seen" the patterns—I've decoded exactly how divorce reprograms a man's mind for failure.
                    </p>
                    <p style="font-size: 1.1rem; line-height: 1.7; color: var(--color-text-dark); margin-bottom: 1.5rem;">
                        Most men think their problem is "heartbreak" or "stress." It's not. Your problem is that your subconscious identity is still attached to a life that no longer exists. No amount of "working harder" will fix a software error in your mind.
                    </p>
                    <p style="font-size: 1.1rem; line-height: 1.7; color: var(--color-text-dark); margin-bottom: 2.5rem;">
                        <strong>You don't need time. You need a system.</strong>
                    </p>
                    <!-- Tan Box -->
                    <div style="background-color: var(--color-text-muted); padding: 2.5rem; border-radius: 8px; border-left: 4px solid var(--color-accent);">
                        <p style="color: var(--color-bg-primary); font-weight: 800; font-size: 1.1rem; margin-bottom: 1.5rem;">As your guide, I give you the code to:</p>
                        <ul style="list-style: none; padding: 0;">
                            <li style="margin-bottom: 1rem; display: flex; align-items: start; gap: 0.75rem; color: var(--color-text-dark);">
                                <span style="font-weight: 900; color: var(--color-accent);">✓</span>
                                <span><strong>Delete the "Ex-Wife Frame"</strong> so you stop reacting and start leading.</span>
                            </li>
                            <li style="margin-bottom: 1rem; display: flex; align-items: start; gap: 0.75rem; color: var(--color-text-dark);">
                                <span style="font-weight: 900; color: var(--color-accent);">✓</span>
                                <span><strong>Reprogram Your Value</strong> so you never look for validation outside yourself again.</span>
                            </li>
                            <li style="margin-bottom: 0; display: flex; align-items: start; gap: 0.75rem; color: var(--color-text-dark);">
                                <span style="font-weight: 900; color: var(--color-accent);">✓</span>
                                <span><strong>Install Unshakeable Clarity</strong> so your next chapter is your best chapter—guaranteed.</span>
                            </li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- PROCESS SECTION (The System) -->
    <section class="section" style="background-color: var(--color-text-light); padding: 4rem 2rem;">
        <div style="max-width: 1100px; margin: 0 auto; text-align: center;">
            <p style="font-size: 1rem; margin-bottom: 0.5rem; letter-spacing: 3px; text-transform: uppercase; color: var(--color-accent); font-weight: 700;">WHAT YOU'LL LEARN</p>
            <h1 style="font-family: var(--font-heading); font-size: 3.5rem; line-height: 1.15; margin-bottom: 2rem; color: var(--color-bg-primary);">
                The Syllabus
            </h1>
            
            <div style="text-align: center; margin-bottom: 4rem;">
                <p style="font-size: 1.25rem; max-width: 700px; margin: 0 auto; color: var(--color-text-dark);">
                    The comprehensive 5-step protocol to move from pain to purpose.
                </p>
            </div>

            <!-- Professional Stacked Syllabus -->
            <div style="max-width: 1000px; margin: 0 auto; display: flex; flex-direction: column; gap: 2rem; text-align: left;">
                <!-- Card 1 -->
                <div class="syllabus-card" style="background-color: #ffffff; padding: 0; border-radius: 16px; display: flex; overflow: hidden; border: 2px solid var(--color-accent); box-shadow: 0 4px 20px rgba(0,0,0,0.03);">
                    <!-- Tall Branding Sidebar -->
                    <div style="width: 120px; background-color: var(--color-bg-primary); display: flex; flex-direction: column; align-items: center; justify-content: center; color: #fff; flex-shrink: 0; position: relative; overflow: hidden; background-image: linear-gradient(rgba(255, 255, 255, 0.02) 1px, transparent 1px), linear-gradient(90deg, rgba(255, 255, 255, 0.02) 1px, transparent 1px); background-size: 20px 20px;">
                        <span style="font-size: 0.75rem; font-weight: 800; letter-spacing: 2px; opacity: 0.6; margin-bottom: 0.5rem; text-transform: uppercase;">MODULE</span>
                        <span style="font-size: 3rem; font-weight: 900; line-height: 1;">01</span>
                    </div>
                    <!-- Content Area -->
                    <div style="padding: 3.5rem; flex: 1;">
                        <div style="margin-bottom: 1rem;">
                            <span style="background: rgba(196, 97, 58, 0.12); color: var(--color-accent); font-size: 0.75rem; font-weight: 900; padding: 6px 14px; border-radius: 4px; letter-spacing: 2px; text-transform: uppercase; display: inline-block;">PHASE 1: THE FOUNDATION</span>
                        </div>
                        <h3 style="font-family: var(--font-heading); font-size: 2.25rem; font-weight: 900; color: var(--color-bg-primary); margin-bottom: 1.25rem; line-height: 1.2;">A Memory In Your Future</h3>
                        <p style="font-size: 1.15rem; line-height: 1.8; color: var(--color-text-dark); margin-bottom: 0; font-weight: 400; max-width: 650px;">The foundational shift required to change your trajectory. You cannot build a new life looking in the rearview mirror. This module installs the 'Future Memory' protocol—reframing your mindset to focus on creation rather than reaction.</p>
                    </div>
                </div>

                <!-- Card 2 -->
                <div class="syllabus-card" style="background-color: #ffffff; padding: 0; border-radius: 16px; display: flex; overflow: hidden; border: 2px solid var(--color-accent); box-shadow: 0 4px 20px rgba(0,0,0,0.03);">
                    <div style="width: 120px; background-color: var(--color-bg-primary); display: flex; flex-direction: column; align-items: center; justify-content: center; color: #fff; flex-shrink: 0; position: relative; overflow: hidden;">
                        <span style="font-size: 0.75rem; font-weight: 800; letter-spacing: 2px; opacity: 0.6; margin-bottom: 0.5rem; text-transform: uppercase;">MODULE</span>
                        <span style="font-size: 3rem; font-weight: 900; line-height: 1;">02</span>
                    </div>
                    <div style="padding: 3.5rem; flex: 1;">
                        <div style="margin-bottom: 1rem;">
                            <span style="background: rgba(196, 97, 58, 0.12); color: var(--color-accent); font-size: 0.75rem; font-weight: 900; padding: 6px 14px; border-radius: 4px; letter-spacing: 2px; text-transform: uppercase; display: inline-block;">PHASE 2: RESOLUTION</span>
                        </div>
                        <h3 style="font-family: var(--font-heading); font-size: 2.25rem; font-weight: 900; color: var(--color-bg-primary); margin-bottom: 1.25rem; line-height: 1.2;">Resolving Your Past</h3>
                        <p style="font-size: 1.15rem; line-height: 1.8; color: var(--color-text-dark); margin-bottom: 0; font-weight: 400; max-width: 650px;">Making peace with what happened so you can move forward. When you close the negative and limiting loops in your mind you change the whole meaning of your future.</p>
                    </div>
                </div>

                <!-- Card 3 -->
                <div class="syllabus-card" style="background-color: #ffffff; padding: 0; border-radius: 16px; display: flex; overflow: hidden; border: 2px solid var(--color-accent); box-shadow: 0 4px 20px rgba(0,0,0,0.03);">
                    <div style="width: 120px; background-color: var(--color-bg-primary); display: flex; flex-direction: column; align-items: center; justify-content: center; color: #fff; flex-shrink: 0; position: relative; overflow: hidden;">
                        <span style="font-size: 0.75rem; font-weight: 800; letter-spacing: 2px; opacity: 0.6; margin-bottom: 0.5rem; text-transform: uppercase;">MODULE</span>
                        <span style="font-size: 3rem; font-weight: 900; line-height: 1;">03</span>
                    </div>
                    <div style="padding: 3.5rem; flex: 1;">
                        <div style="margin-bottom: 1rem;">
                            <span style="background: rgba(196, 97, 58, 0.12); color: var(--color-accent); font-size: 0.75rem; font-weight: 900; padding: 6px 14px; border-radius: 4px; letter-spacing: 2px; text-transform: uppercase; display: inline-block;">PHASE 3: CONSTRUCTION</span>
                        </div>
                        <h3 style="font-family: var(--font-heading); font-size: 2.25rem; font-weight: 900; color: var(--color-bg-primary); margin-bottom: 1.25rem; line-height: 1.2;">Rebuilding Your Reality Chain</h3>
                        <p style="font-size: 1.15rem; line-height: 1.8; color: var(--color-text-dark); margin-bottom: 0; font-weight: 400; max-width: 650px;">Constructing a new narrative for your life and identity. Rewiring your belief systems for success.</p>
                    </div>
                </div>

                <!-- Card 4 -->
                <div class="syllabus-card" style="background-color: #ffffff; padding: 0; border-radius: 16px; display: flex; overflow: hidden; border: 2px solid var(--color-accent); box-shadow: 0 4px 20px rgba(0,0,0,0.03);">
                    <div style="width: 120px; background-color: var(--color-bg-primary); display: flex; flex-direction: column; align-items: center; justify-content: center; color: #fff; flex-shrink: 0; position: relative; overflow: hidden;">
                        <span style="font-size: 0.75rem; font-weight: 800; letter-spacing: 2px; opacity: 0.6; margin-bottom: 0.5rem; text-transform: uppercase;">MODULE</span>
                        <span style="font-size: 3rem; font-weight: 900; line-height: 1;">04</span>
                    </div>
                    <div style="padding: 3.5rem; flex: 1;">
                        <div style="margin-bottom: 1rem;">
                            <span style="background: rgba(196, 97, 58, 0.12); color: var(--color-accent); font-size: 0.75rem; font-weight: 900; padding: 6px 14px; border-radius: 4px; letter-spacing: 2px; text-transform: uppercase; display: inline-block;">PHASE 4: DESIGN</span>
                        </div>
                        <h3 style="font-family: var(--font-heading); font-size: 2.25rem; font-weight: 900; color: var(--color-bg-primary); margin-bottom: 1.25rem; line-height: 1.2;">Designing Your Ideal Future</h3>
                        <p style="font-size: 1.15rem; line-height: 1.8; color: var(--color-text-dark); margin-bottom: 0; font-weight: 400; max-width: 650px;">Architecting the life you actually want to live. Moving from drifting to designing.</p>
                    </div>
                </div>

                <!-- Card 5 -->
                <div class="syllabus-card" style="background-color: #ffffff; padding: 0; border-radius: 16px; display: flex; overflow: hidden; border: 2px solid var(--color-accent); box-shadow: 0 4px 20px rgba(0,0,0,0.03);">
                    <div style="width: 120px; background-color: var(--color-bg-primary); display: flex; flex-direction: column; align-items: center; justify-content: center; color: #fff; flex-shrink: 0; position: relative; overflow: hidden;">
                        <span style="font-size: 0.75rem; font-weight: 800; letter-spacing: 2px; opacity: 0.6; margin-bottom: 0.5rem; text-transform: uppercase;">MODULE</span>
                        <span style="font-size: 3rem; font-weight: 900; line-height: 1;">05</span>
                    </div>
                    <div style="padding: 3.5rem; flex: 1;">
                        <div style="margin-bottom: 1rem;">
                            <span style="background: rgba(196, 97, 58, 0.12); color: var(--color-accent); font-size: 0.75rem; font-weight: 900; padding: 6px 14px; border-radius: 4px; letter-spacing: 2px; text-transform: uppercase; display: inline-block;">PHASE 5: ABUNDANCE</span>
                        </div>
                        <h3 style="font-family: var(--font-heading); font-size: 2.25rem; font-weight: 900; color: var(--color-bg-primary); margin-bottom: 1.25rem; line-height: 1.2;">Scarcity to Abundance</h3>
                        <p style="font-size: 1.15rem; line-height: 1.8; color: var(--color-text-dark); margin-bottom: 0; font-weight: 400; max-width: 650px;">Flipping the script on how you view resources and relationships. Moving out of the fear state.</p>
                    </div>
                </div>

                <div style="text-align: center; margin-top: 4rem;">
                    <a href="/join" class="mpdc-btn mpdc-btn-lg">Start The System Now →</a>
                </div>
            </div>
        </div>
    </section>
</Layout>
