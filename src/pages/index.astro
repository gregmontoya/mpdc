---
import Layout from '../layouts/Layout.astro';
import { Image } from 'astro:assets';
import alexMorganImg from '../assets/images/alex-morgan.png';
import communityLoungeImg from '../assets/images/community-lounge.png';
export const prerender = true;

const homeFaqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "How do I stop overthinking after divorce?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Stopping the 'replay loop' post-divorce requires shifting from an emotional state to a biological logic-first framework. By auditing your 'Reality Chain' and using grounding techniques, you can manually override the ruminative loops that keep you stuck in the past."
      }
    },
    {
      "@type": "Question",
      "name": "Can a man rebuild his life after 40?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Statistically, the age range of 40-55 is a man's peak window for authority and market value. Starting over after 40 is not a handicap; it is a tactical advantage when you leverage your built-in patterns of success and experience."
      }
    },
    {
      "@type": "Question",
      "name": "What is the ‘Ex-Wife Frame’?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "The 'Ex-Wife Frame' is a reactive psychological state where a man's decisions and self-worth are still being dictated by his former partner's opinions or actions. Breaking this frame is the first step in reclaiming masculine autonomy."
      }
    }
  ]
};

const howToSchema = {
  "@context": "https://schema.org",
  "@id": "https://menspostdivorcecoaching.com/#how-to-rebuild",
  "@type": "HowTo",
  "name": "How to Rebuild Stronger After Divorce",
  "description": "A 5-step tactical protocol for men to move from emotional pain to a purpose-driven life after marriage ends.",
  "publisher": { "@id": "https://menspostdivorcecoaching.com/#organization" },
  "step": [
    {
      "@type": "HowToStep",
      "name": "Phase 1: Installation of Future Memory",
      "text": "Reframing your mindset to focus on creation rather than reaction. Installing the 'Future Memory' protocol.",
      "url": "https://menspostdivorcecoaching.com/#module-01"
    },
    {
      "@type": "HowToStep",
      "name": "Phase 2: Resolution of the Past",
      "text": "Closing the negative loops and limiting beliefs to change the meaning of your future.",
      "url": "https://menspostdivorcecoaching.com/#module-02"
    },
    {
      "@type": "HowToStep",
      "name": "Phase 3: Construction of Reality Chain",
      "text": "Rebuilding a new narrative for your life and identity. Rewiring belief systems for success.",
      "url": "https://menspostdivorcecoaching.com/#module-03"
    },
    {
      "@type": "HowToStep",
      "name": "Phase 4: Design of Ideal Future",
      "text": "Architecting the life you want to live. Strategic life design.",
      "url": "https://menspostdivorcecoaching.com/#module-04"
    },
    {
      "@type": "HowToStep",
      "name": "Phase 5: Transition to Abundance",
      "text": "Flipping the script from scarcity to abundance in resources and relationships.",
      "url": "https://menspostdivorcecoaching.com/#module-05"
    }
  ]
};

const terminologySchema = {
  "@context": "https://schema.org",
  "@type": "DefinedTermSet",
  "@id": "https://menspostdivorcecoaching.com/#glossary",
  "name": "MPDC Branded Terminology",
  "hasDefinedTerm": [
    {
      "@type": "DefinedTerm",
      "name": "Ex-Wife Frame",
      "description": "A psychological state of reactivity where one's identity is anchored to their former spouse's actions."
    },
    {
      "@type": "DefinedTerm",
      "name": "Biological Replay Loop",
      "description": "A somatic state where the body repeatedly triggers stress responses based on past divorce trauma."
    },
    {
      "@type": "DefinedTerm",
      "name": "Reality Chain",
      "description": "A structural mindset framework used to rebuild identity from internal values rather than external loss."
    },
    {
      "@type": "DefinedTerm",
      "name": "No-Reaction Protocol",
      "description": "A tactical communication strategy for handling high-conflict interactions with stoic clarity."
    }
  ]
};
---

<Layout title="Men's Post-Divorce Coaching - Rebuild Your Life">
    <script type="application/ld+json" is:inline set:html={JSON.stringify(homeFaqSchema)} />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(howToSchema)} />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(terminologySchema)} />
    <!-- HERO SECTION -->
    <header id="hero" class="section hero-section" style="position: relative; padding: 6rem 0;">
        <div style="max-width: 1100px; width: 100%; margin: 0 auto; padding: 0 2rem; text-align: center;">
            <p
                style="font-size: 1rem; margin-bottom: 2rem; letter-spacing: 3px; text-transform: uppercase; color: var(--color-text-muted);">
                The #1 Resource for Men Reclaiming Their Edge</p>
            
            <h1 style="font-size: 4rem; line-height: 1.15; margin-bottom: 2.5rem; color: #fff;">
                Your Marriage Ended.<br>
                <span
                    style="color: var(--color-text-muted); border-bottom: 4px solid var(--color-accent); padding-bottom: 0.25rem;">Your
                    Comeback Starts Now.</span>
            </h1>
            <p style="font-size: 1.25rem; line-height: 1.6; margin-bottom: 1rem; color: var(--color-text-muted);">Stop
                the "replay" loop. The problem isn't logical—it's biological.</p>
            <p style="font-size: 1.25rem; line-height: 1.6; margin-bottom: 2.5rem; color: #fff; font-weight: 600;">Get
                the 5-step system to break the cycle and start your comeback.</p>
            <a href="/join" class="mpdc-btn mpdc-btn-lg">Build Your Future →</a>
            <p
                style="font-size: 0.85rem; margin-top: 1.5rem; letter-spacing: 1px; text-transform: uppercase; color: var(--color-text-muted);">
                Free Instant Access • 100% Private</p>
        </div>
    </header>

    <!-- COMMUNITY SECTION (Extracted from Live) -->
    <section class="section community-block-section" style="background-color: var(--color-text-muted);">
        <div class="container">
            <div class="module-box" style="margin-bottom: 0; background: #fff; border: 1px solid #d4c5a9;">
                <div class="module-content-left" style="padding: 4rem;">
                    <h2 style="margin-bottom: 2rem; color: var(--color-accent); line-height: 1.1;">
                        <span style="font-size: 3.5rem; font-weight: 900; text-transform: uppercase;">JOIN</span><br>
                        <span style="font-size: 1.75rem; font-weight: 700; color: var(--color-bg-primary);">The Post
                            Divorce Advantage</span>
                    </h2>
                    <p
                        style="font-size: 1.25rem; line-height: 1.6; margin-bottom: 2rem; color: var(--color-text-dark); font-weight: 600;">
                        The Only Community Built Specifically for Divorced Men Who Want to Rebuild Stronger (Not Just
                        Survive)
                    </p>
                    <ul class="benefit-bullets" style="margin-bottom: 2.5rem;">
                        <li style="color: var(--color-text-dark); margin-bottom: 1rem; font-weight: 500;"><strong>Weekly
                                live Q&A sessions</strong> with Alex</li>
                        <li style="color: var(--color-text-dark); margin-bottom: 1rem; font-weight: 500;">
                            <strong>Private forum</strong> for men who’ve been where you are
                        </li>
                        <li style="color: var(--color-text-dark); margin-bottom: 1rem; font-weight: 500;">
                            <strong>Exclusive hypnosis recordings</strong> & frameworks
                        </li>
                        <li style="color: var(--color-text-dark); margin-bottom: 1rem; font-weight: 500;">
                            <strong>Accountability partners</strong> who actually understand
                        </li>
                    </ul>
                    <div style="text-align: center;">
                        <a href="https://www.skool.com/the-post-divorce-advantage-8284" target="_blank" class="mpdc-btn" style="padding: 1.25rem 3rem; font-size: 1.1rem; width: 100%;">Join
                            The Advantage →</a>
                        <p style="margin-top: 1rem; font-size: 0.85rem; color: var(--color-text-dark); opacity: 0.7;">
                            Secure Access • Cancel Anytime • 100% Confidential</p>
                    </div>
                </div>
                <div class="module-content-right" style="padding: 0; background-color: #000; overflow: hidden; display: flex;">
                    <Image 
                        src={communityLoungeImg} 
                        alt="MPDC Community"
                        width={525}
                        height={525}
                        class="optimized-img"
                        style="width: 100%; height: 100%; object-fit: cover;"
                        loading="eager"
                        fetchpriority="high"
                    />
                </div>
            </div>
        </div>
    </section>

    <!-- ABOUT SECTION (Extracted from Live) -->
    <section id="about" class="section" style="background-color: #fff; color: var(--color-text-dark); padding: 6rem 2rem;">
        <div class="container" style="max-width: 1100px;">
            <div class="founder-grid" style="display: grid; grid-template-columns: 1fr 1fr; gap: 4rem; align-items: start;">
                <!-- Left Col: Image + Button -->
                <div style="position: relative;" class="founder-image-container">
                    <!-- Image Placeholder (Dark Green Box) -->
                    <div style="width: 100%; aspect-ratio: 3/4; background-color: var(--color-bg-dark); border-radius: 8px; position: relative; overflow: hidden; display: flex; align-items: center; justify-content: center;">
                        <Image 
                            src={alexMorganImg} 
                            alt="Alex Morgan" 
                            width={800}
                            height={1000}
                            class="optimized-img"
                            style="width: 100%; height: 100%; object-fit: cover;"
                            loading="eager"
                        />
                    </div>
                    <!-- Floating Button -->
                    <div style="position: absolute; bottom: -20px; right: -20px; z-index: 10;" class="floating-cta-btn">
                        <a href="/join" style="background-color: var(--color-accent); color: #fff; padding: 1rem 2rem; font-weight: 700; text-transform: uppercase; letter-spacing: 1px; border-radius: 4px; box-shadow: 0 10px 20px rgba(196, 97, 58, 0.4); text-decoration: none; display: inline-block;">
                            I'll Show You How.
                        </a>
                    </div>
                </div>
                <!-- Right Col: Copy + Box -->
                <div style="text-align: left;">
                    <p style="color: var(--color-accent); font-weight: 700; letter-spacing: 2px; text-transform: uppercase; font-size: 0.9rem; margin-bottom: 0.5rem;" class="about-intro-text">ABOUT THE FOUNDER</p>
                    <h2 style="font-family: var(--font-heading); font-size: 3.5rem; color: var(--color-bg-primary); margin-bottom: 0.5rem; line-height: 1.15;">I'M ALEX MORGAN.</h2>
                    <p style="font-weight: 700; color: #666; font-size: 1.1rem; margin-bottom: 2rem;">Certified Mental Programmer & Founder, MPDC</p>
                    <p style="font-size: 1.1rem; line-height: 1.7; color: var(--color-text-dark); margin-bottom: 1.5rem;">
                        I haven't just "seen" the patterns—I've decoded exactly how divorce reprograms a man's mind for failure.
                    </p>
                    <p style="font-size: 1.1rem; line-height: 1.7; color: var(--color-text-dark); margin-bottom: 1.5rem;">
                        Most men think their problem is "heartbreak" or "stress." It's not. Your problem is that your subconscious identity is still attached to a life that no longer exists. No amount of "working harder" will fix a software error in your mind.
                    </p>
                    <p style="font-size: 1.1rem; line-height: 1.7; color: var(--color-text-dark); margin-bottom: 2.5rem;">
                        <strong>You don't need time. You need a system.</strong>
                    </p>
                    <!-- Tan Box -->
                    <div style="background-color: var(--color-text-muted); padding: 2.5rem; border-radius: 8px; border-left: 4px solid var(--color-accent);">
                        <p style="color: var(--color-bg-primary); font-weight: 800; font-size: 1.1rem; margin-bottom: 1.5rem;">As your guide, I give you the code to:</p>
                        <ul style="list-style: none; padding: 0;">
                            <li style="margin-bottom: 1rem; display: flex; align-items: start; gap: 0.75rem; color: var(--color-text-dark);">
                                <span style="font-weight: 900; color: var(--color-accent);">✓</span>
                                <span><strong>Delete the "Ex-Wife Frame"</strong> so you stop reacting and start leading.</span>
                            </li>
                            <li style="margin-bottom: 1rem; display: flex; align-items: start; gap: 0.75rem; color: var(--color-text-dark);">
                                <span style="font-weight: 900; color: var(--color-accent);">✓</span>
                                <span><strong>Reprogram Your Value</strong> so you never look for validation outside yourself again.</span>
                            </li>
                            <li style="margin-bottom: 0; display: flex; align-items: start; gap: 0.75rem; color: var(--color-text-dark);">
                                <span style="font-weight: 900; color: var(--color-accent);">✓</span>
                                <span><strong>Install Unshakeable Clarity</strong> so your next chapter is your best chapter—guaranteed.</span>
                            </li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </section>
    
    <!-- STUDENT SUCCESS & REVIEWS SECTION -->
    <section id="authority" class="section" style="background-color: var(--color-bg-primary); padding: 8rem 2rem; color: #fff; border-top: 1px solid rgba(196, 97, 58, 0.2);">
        <div class="container" style="max-width: 1200px; margin: 0 auto; text-align: center;">
            <p style="color: var(--color-accent); font-weight: 700; letter-spacing: 3px; text-transform: uppercase; font-size: 1rem; margin-bottom: 1.5rem;">Student Success Stories</p>
            <h2 style="font-family: var(--font-heading); font-size: 3.5rem; color: #fff; margin-bottom: 4rem; line-height: 1.15;">Real Men. Real Results.<br><span style="color: var(--color-accent);">Real Transformation.</span></h2>

            <div style="max-width: 800px; margin: 0 auto; text-align: left;">
                <!-- Single Featured Testimonial -->
                <div style="background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.1); padding: 3rem; border-radius: 12px; position: relative;">
                    <div style="color: var(--color-accent); font-size: 1.5rem; margin-bottom: 1.5rem;">★★★★★</div>
                    <h3 style="font-size: 1.75rem; color: #fff; margin-bottom: 1.5rem; font-family: var(--font-heading);">"I highly recommend working with Alex"</h3>
                    <p style="font-size: 1.2rem; color: #ccc; line-height: 1.8; margin-bottom: 2.5rem; font-style: italic;">
                        "My connection with Alex started 3 years ago. His ability to understand my learning style led me to not only get better in sales but gained an appreciation for learning hypnosis and NLP. I now have my own business and my relationship with Alex as a mentor will remain for life. If you want to be the 'BEST' version of yourself I highly recommend working with Alex."
                    </p>
                    <div style="display: flex; align-items: center; gap: 16px;">
                        <div style="width: 60px; height: 60px; background-image: url('/images/mike_williams.png'); background-size: cover; background-position: center; border-radius: 50%; border: 3px solid var(--color-accent);"></div>
                        <div>
                            <p style="font-size: 1.1rem; font-weight: 700; color: #fff; margin: 0;">Michael Williams</p>
                            <p style="font-size: 0.9rem; color: var(--color-accent); margin: 0;">CEO & Founder • Mentee</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <script type="application/ld+json" is:inline>
        {
          "@context": "https://schema.org",
          "@type": "Review",
          "itemReviewed": {
            "@id": "https://menspostdivorcecoaching.com/#person"
          },
          "author": { "@type": "Person", "name": "Michael Williams" },
          "reviewRating": { "@type": "Rating", "ratingValue": "5", "bestRating": "5" },
          "reviewBody": "If you want to be the 'BEST' version of yourself I highly recommend working with Alex. I now have my own business and my relationship with Alex as a mentor will remain for life."
        }
        </script>
    </section>

    <div style="text-align: center; margin-top: 4rem; padding-bottom: 8rem; background: var(--color-bg-primary);">
        <a href="/join" class="mpdc-btn mpdc-btn-lg">Build Your Future Today →</a>
    </div>
</Layout>
</Layout>
