    <!-- INLINE SCRIPT FOR CHECKOUT LOGIC -->
    <script is:inline>
        async function proceedToStripeCheckout(source) {
            const nameField = source === 'hero' ? 'full-name-hero' : 'full-name';
            const emailField = source === 'hero' ? 'email-hero' : 'email';
            
            const name = document.getElementById(nameField).value.trim();
            const email = document.getElementById(emailField).value.trim();
            
            if (!name || !email) {
                alert('Please enter your name and email.');
                return;
            }
            
            const btn = document.getElementById(source + '-checkout-btn');
            const originalText = btn.innerText;
            btn.innerText = "Processing...";
            btn.disabled = true;
            
            try {
                // Get Real Attribution Data (Hyros-Lite)
                let trackingData = {};
                if (window.getAttributionData) {
                     trackingData = window.getAttributionData();
                }

                // Use localhost:3000 directly for dev to bypass proxy issues
                const apiBase = window.location.hostname === 'localhost' 
                    ? 'http://localhost:3000' 
                    : 'https://webhook-server-xi-nine.vercel.app'; // Use production URL directly if needed, or /api if proxied
                    
                const response = await fetch(`${apiBase}/create-checkout-session`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        name: name,
                        email: email,
                        plan: 'core',
                        guestId: localStorage.getItem('mpdc_guest_id'),
                        attribution: trackingData // Send the real captured UTMs
                    })
                });

                // 🔵 Trigger Identity & Conversion events (Elite Stack Bridge)
                if (window.posthog) {
                    posthog.identify(email, {
                        name: name,
                        email: email,
                        $set: { source: 'join_page_checkout' }
                    });
                }
                
                // 🔵 Trigger Facebook Lead Event (PRO Move)
                if (typeof fbq !== 'undefined') {
                    fbq('track', 'Lead', {
                        content_name: 'Core System Checkout',
                        value: 0.00,
                        currency: 'USD'
                    });
                }

                // 🔵 Trigger GA4 Enhanced Contact Event
                if (typeof gtag !== 'undefined') {
                    gtag('event', 'generate_lead', {
                        'user_email': email,
                        'user_name': name,
                        'event_category': 'engagement',
                        'event_label': 'Checkout Started'
                    });
                }
                
                const session = await response.json();
                if (session.id) {
                    const stripe = Stripe('pk_live_51OupkGEnV5y7Hgm1s8J4a8z7w93x6a5b4c3d2e1f0g'); 
                    stripe.redirectToCheckout({ sessionId: session.id });
                } else if (session.url) {
                    // Handle direct URL response if using webhook-server bypass
                    window.location.href = session.url;
                } else {
                    alert('Error creating session.');
                    btn.innerText = originalText;
                    btn.disabled = false;
                }
            } catch (e) {
                console.error(e);
                alert('Checkout error');
                btn.innerText = originalText;
                btn.disabled = false;
            }
        }
        
    </script>
