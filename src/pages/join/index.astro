---
import Layout from '../../layouts/Layout.astro';
import '../../styles/comparison.css';
import '../../styles/promo.css';
import '../../styles/modules.css';
---

<Layout title="Are You Stuck in Your Ex-Wife's Frame? | Men's Divorce Mindset System" simpleHeader={true}>
    

    <!-- Centered Title Header (Sales Page Style) -->
    <div style="text-align: center; padding: 2rem 2rem 1rem; max-width: 1200px; margin: 0 auto; position: relative; z-index: 10;">
        <h1
            style="font-family: var(--font-heading); font-size: 1.5rem; font-weight: 800; color: var(--color-text-light); letter-spacing: 2px; text-transform: uppercase; margin: 0; line-height: 1.2;">
            MEN'S DIVORCE MINDSET SYSTEM
        </h1>
        <p
            style="font-size: 0.85rem; margin-top: 0.25rem; margin-bottom: 0; letter-spacing: 3px; text-transform: uppercase; color: var(--color-neon); font-weight: 700;">
            ONLINE COURSE | INSTANT ACCESS
        </p>
    </div>

    <!-- Hero Section -->
    <header id="hero" class="section hero-section" style="min-height: auto; padding-top: 2rem; position: relative;">
        <div class="container">
            <div class="hero-content">
                <h1
                    style="font-size: 4rem; margin-bottom: 1.5rem; text-shadow: 0 2px 4px rgba(0,0,0,0.5); line-height: 1.15;">
                    Are You Stuck Living in<br>
                    <span style="color: var(--color-neon);">Your Ex-Wife's Frame?</span>
                </h1>
                <p
                    style="font-size: 1.5rem; margin-bottom: 2rem; color: var(--color-text-light); font-weight: 600; line-height: 1.4;">
                    Stop Reacting to Your Past. Start Building Your Future.<br>
                    <span style="color: var(--color-text-muted); font-size: 1.25rem; font-weight: 400;">The 6-Step
                        System to Rebuild Your Identity & Reclaim Your Edge</span>
                </p>


                <!-- Video Placeholder matching reference style -->
                <div class="hero-video-wrapper">
                    <div class="video-container">
                        <iframe id="vsl-video" width="100%" height="100%"
                            src="https://www.youtube.com/embed/YOUR_VIDEO_ID?rel=0&modestbranding=1"
                            title="Men's Post Divorce Mindset System VSL" frameborder="0"
                            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                            allowfullscreen
                            style="position: absolute; top: 0; left: 0; width: 100%; height: 100%;"></iframe>
                    </div>
                </div>
            </div>

            <!-- Hero Split Grid: Copy + Checkout (Checkout under Video) -->
            <div class="hero-split-grid">
                <!-- Left: Sales Copy -->
                <div class="hero-sales-copy">
                    <h3>The System Works. <span style="color: #fff;">Make the Decision.</span></h3>
                    <p>
                        You are one decision away from a completely new life. This isn't just a course; it's a protocol
                        for rebuilding your reality.
                    </p>
                    <ul class="benefit-bullets">
                        <li>Instant Access to All 6 Modules</li>
                        <li>The "Full Decision" Framework</li>
                        <li>Identity Reconstruction Tools</li>
                        <li>Lifetime Updates</li>
                    </ul>
                </div>

                <!-- Right: Checkout Form -->
                <div class="hero-checkout-wrapper">
                    <div class="checkout-container">
                        <h3 style="text-align: center; margin-bottom: 1.5rem; color: var(--color-neon);">Secure Your
                            Spot</h3>

                        <div class="order-summary" style="margin-bottom: 1.5rem;">
                            <div class="summary-row"><span>Men's Divorce Mindset System</span><span>$97.00</span></div>
                            <div class="summary-row summary-total"><span>Total:</span><span>$97.00</span></div>
                        </div>

                        <div class="form-group">
                            <label for="full-name-hero">Full Name</label>
                            <input type="text" id="full-name-hero" class="form-input" placeholder="Enter your full name"
                                required>
                        </div>
                        <div class="form-group">
                            <label for="email-hero">Email Address</label>
                            <input type="email" id="email-hero" class="form-input"
                                placeholder="Enter your email address" required>
                        </div>

                        <button class="btn btn-checkout" onclick="proceedToStripeCheckout('hero')">
                            Proceed to Secure Checkout →
                        </button>

                        <p style="text-align: center; color: #777; font-size: 0.8rem; margin-top: 1rem;">
                            <span style="color: #4CAF50;">🔒 Secure payment powered by Stripe</span>
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </header>

    <!-- Comparison Section -->
    <section class="section comparison-section">
        <div class="container">
            <h2 style="font-size: 2.5rem; margin-bottom: 3rem; text-align: center;">
                Here's what changes when you start <br>
                <span style="color: var(--color-neon);">The System</span>
            </h2>

            <div class="comparison-wrapper">
                <div class="comparison-grid">
                    <!-- Before Column -->
                    <div class="comparison-col col-before">
                        <h3>Before The System</h3>
                        <ul class="comparison-list">
                            <li class="comparison-item">
                                <div class="icon-box"><i class="fas fa-times">✕</i></div>
                                <span>Constantly stressed and reactive to her</span>
                            </li>
                            <li class="comparison-item">
                                <div class="icon-box"><i class="fas fa-times">✕</i></div>
                                <span>Endless "what ifs" with little progress</span>
                            </li>
                            <li class="comparison-item">
                                <div class="icon-box"><i class="fas fa-times">✕</i></div>
                                <span>Burned out and always behind</span>
                            </li>
                            <li class="comparison-item">
                                <div class="icon-box"><i class="fas fa-times">✕</i></div>
                                <span>Living by default (Her Frame)</span>
                            </li>
                            <li class="comparison-item">
                                <div class="icon-box"><i class="fas fa-times">✕</i></div>
                                <span>Struggling to find time for yourself</span>
                            </li>
                            <li class="comparison-item">
                                <div class="icon-box"><i class="fas fa-times">✕</i></div>
                                <span>Stuck in cycles of urgency and guilt</span>
                            </li>
                        </ul>
                    </div>

                    <!-- After Column -->
                    <div class="comparison-col col-after">
                        <h3>After The System</h3>
                        <ul class="comparison-list">
                            <li class="comparison-item">
                                <div class="icon-box"><i class="fas fa-check">✓</i></div>
                                <span>Calm, focused, and in control</span>
                            </li>
                            <li class="comparison-item">
                                <div class="icon-box"><i class="fas fa-check">✓</i></div>
                                <span>Clear outcomes and meaningful wins</span>
                            </li>
                            <li class="comparison-item">
                                <div class="icon-box"><i class="fas fa-check">✓</i></div>
                                <span>Energized and ahead of your priorities</span>
                            </li>
                            <li class="comparison-item">
                                <div class="icon-box"><i class="fas fa-check">✓</i></div>
                                <span>Living by design (Your Frame)</span>
                            </li>
                            <li class="comparison-item">
                                <div class="icon-box"><i class="fas fa-check">✓</i></div>
                                <span>Creating space for growth and fulfillment</span>
                            </li>
                            <li class="comparison-item">
                                <div class="icon-box"><i class="fas fa-check">✓</i></div>
                                <span>Operating from intention, not pressure</span>
                            </li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- About Section (Reverted to Dark Theme) -->
    <section id="about" class="section">
        <div class="container">
            <div style="max-width: 900px; margin: 0 auto; text-align: center; margin-bottom: 3rem;">
                <h2 style="color: var(--color-accent); margin-bottom: 1.5rem; line-height: 1.3;">
                    You CAN Rebuild a Strong, Purposeful Life and Enjoy a Clear, Forward-Moving Future. I'll Show You
                    How.
                </h2>
            </div>

            <div class="grid-2" style="align-items: center;">
                <!-- Left Col: Bio -->
                <div>
                    <!-- Small Image Placeholder -->
                    <div
                        style="width: 150px; height: 150px; background-color: #333; border-radius: 50%; margin-bottom: 2rem; display: flex; align-items: center; justify-content: center; overflow: hidden; border: 4px solid var(--color-accent);">
                        [Alex]
                    </div>

                    <h3 style="margin-bottom: 1.5rem; color: #fff;">I'm Alex Morgan.</h3>
                    <p style="margin-bottom: 1.5rem; color: var(--color-text-muted);">
                        I've worked with hundreds of men, and I've seen the same patterns over and over. I know what
                        it's like to feel like you're doing everything right on paper, but still feel hollow inside.
                    </p>
                    <p style="margin-bottom: 1.5rem; color: var(--color-text-muted);">
                        You work endlessly, thinking more effort will fix it. But the results never match the energy
                        you're putting in.
                    </p>
                    <p style="font-weight: 600; color: var(--color-text-light); font-style: italic;">
                        But it doesn't have to be this way.
                    </p>
                </div>

                <!-- Right Col: Success/Results (Dark Card) -->
                <div class="result-card">
                    <p style="font-size: 1.25rem; font-weight: 600; margin-bottom: 1.5rem; color: var(--color-accent);">
                        Learning how to rebuild from the inside out has helped me guide men to:
                    </p>
                    <ul class="success-list" style="color: var(--color-text-light);">
                        <li style="color: var(--color-text-light);">Rebuild their identity and confidence without
                            chasing external validation or numbing the pain</li>
                        <li style="color: var(--color-text-light);">Wake up every day with clarity and purpose — even
                            after years of feeling lost</li>
                        <li style="color: var(--color-text-light);">Create meaningful relationships and connections, and
                            still have time for the things that matter</li>
                        <li style="color: var(--color-text-light);">Build a life they're proud of — without guilt,
                            shame, or constantly looking back</li>
                        <li style="color: var(--color-text-light);">Move forward with confidence and momentum — without
                            repeating the same mistakes</li>
                    </ul>
                </div>
            </div>
        </div>
    </section>

    <!-- NEW SECTION: Introducing -->
    <section id="introducing" class="section"
        style="background-color: var(--color-bg-primary); color: white; text-align: center; padding: 6rem 2rem;">
        <div class="container">
            <p style="font-size: 1.2rem; margin-bottom: 1rem; opacity: 0.8;">INTRODUCING</p>
            <h2 style="font-size: 3.5rem; margin-bottom: 2rem; text-shadow: 0 4px 10px rgba(0,0,0,0.3);">
                The Men's Divorce <br><span style="color: var(--color-neon);">Mindset System</span>
            </h2>
            <div style="width: 80px; height: 4px; background-color: var(--color-accent); margin: 0 auto 2rem;"></div>
            <p style="font-size: 1.5rem; max-width: 700px; margin: 0 auto 4rem;">
                The comprehensive protocol to move from pain to purpose in 6 distinct steps.
            </p>

            <!-- Course Portal Preview -->
            <div style="position: relative; max-width: 1000px; margin: 0 auto;">
                <div
                    style="position: absolute; -inset: 1px; background: linear-gradient(to bottom right, var(--color-neon), transparent); opacity: 0.3; border-radius: 14px; z-index: 0;">
                </div>
                <img src="/images/course-portal-preview.png" alt="Course Portal Inside Look"
                    style="position: relative; width: 100%; border-radius: 12px; box-shadow: 0 20px 60px rgba(0,0,0,0.6); border: 1px solid rgba(255,255,255,0.1); z-index: 1; display: block;">

                <div
                    style="margin-top: 1.5rem; color: var(--color-text-muted); font-size: 0.9rem; letter-spacing: 1px;">
                    ▲ ACTUAL COURSE DASHBOARD
                </div>
            </div>
        </div>
    </section>

    <section id="outcomes" class="section">
        <div class="container">
            <p style="text-align: center; color: var(--color-accent); font-weight: 700; margin-bottom: 1rem;">WHAT
                YOU'LL LEARN</p>
            <h2 style="text-align: center; margin-bottom: 3rem; color: #fff;">The Syllabus</h2>

            <div style="display: flex; flex-direction: column; gap: 3rem; max-width: 900px; margin: 0 auto;">

                <!-- Module 1 -->
                <div class="module-box">
                    <div class="module-content-left">
                        <div class="module-meta">
                            <span class="module-label">MODULE 1</span>
                            <span class="module-line"></span>
                        </div>
                        <h3 class="module-title">A Memory In Your Future</h3>
                        <p class="module-description">The foundational shift required to change your trajectory. You
                            cannot build a new life looking in the rearview mirror. This module installs the 'Future
                            Memory' protocol—reframing your mindset to focus on creation rather than reaction.</p>

                    </div>
                    <div class="module-content-right">
                        <img src="/images/module_1.png" alt="A Memory in Your Future">
                    </div>
                </div>

                <!-- Module 2 -->
                <div class="module-box">
                    <div class="module-content-left">
                        <div class="module-meta">
                            <span class="module-label">MODULE 2</span>
                            <span class="module-line"></span>
                        </div>
                        <h3 class="module-title">Resolving Your Past</h3>
                        <p class="module-description">Making peace with what happened so you can move forward. Closing
                            the loops to stop the energy drain.</p>

                    </div>
                    <div class="module-content-right">
                        <img src="/images/module_2.png" alt="Resolving Your Past">
                    </div>
                </div>

                <!-- Module 3 -->
                <div class="module-box">
                    <div class="module-content-left">
                        <div class="module-meta">
                            <span class="module-label">MODULE 3</span>
                            <span class="module-line"></span>
                        </div>
                        <h3 class="module-title">Rebuilding Your Reality Chain</h3>
                        <p class="module-description">Constructing a new narrative for your life and identity. Rewiring
                            your belief systems for success.</p>

                    </div>
                    <div class="module-content-right">
                        <img src="/images/module_3.png" alt="Rebuilding Your Reality Chain">
                    </div>
                </div>

                <!-- Module 4 -->
                <div class="module-box">
                    <div class="module-content-left">
                        <div class="module-meta">
                            <span class="module-label">MODULE 4</span>
                            <span class="module-line"></span>
                        </div>
                        <h3 class="module-title">Designing Your Ideal Future</h3>
                        <p class="module-description">Architecting the life you actually want to live. Moving from
                            drifting to designing.</p>

                    </div>
                    <div class="module-content-right">
                        <img src="/images/module_4.png" alt="Designing Your Ideal Future">
                    </div>
                </div>

                <!-- Module 5 -->
                <div class="module-box">
                    <div class="module-content-left">
                        <div class="module-meta">
                            <span class="module-label">MODULE 5</span>
                            <span class="module-line"></span>
                        </div>
                        <h3 class="module-title">Scarcity to Abundance</h3>
                        <p class="module-description">Flipping the script on how you view resources and relationships.
                            Moving out of the fear state.</p>

                    </div>
                    <div class="module-content-right">
                        <img src="/images/module_5.png" alt="Scarcity to Abundance">
                    </div>
                </div>

                <!-- Module 6 -->
                <div class="module-box">
                    <div class="module-content-left">
                        <div class="module-meta">
                            <span class="module-label">MODULE 6</span>
                            <span class="module-line"></span>
                        </div>
                        <h3 class="module-title">She Ain't Nothing Special</h3>
                        <p class="module-description">This bonus module de-pedestalizes women and helps you realize your
                            true value in the marketplace.</p>

                        <div class="bonus-box">
                            <span class="bonus-label">BONUS CONTENT</span>
                            <span class="bonus-text">Advanced Dating Protocols Included</span>
                        </div>
                    </div>
                    <div class="module-content-right">
                        <img src="/images/module_6.png" alt="She Ain't Nothing Special">
                    </div>
                </div>
            </div>
        </div>
        </div>
    </section>

    <!-- NEW SECTION: Pricing & Timer -->
    <section id="pricing-timer" class="section"
        style="background-color: var(--color-bg-dark); color: white; text-align: center;">
        <div class="container" style="max-width: 600px;">
            <p
                style="color: var(--color-neon); font-weight: 700; letter-spacing: 1px; margin-bottom: 1rem; font-size: 1.25rem;">
                SPECIAL
                INTRODUCTORY OFFER</p>
            <p style="margin-bottom: 1rem; font-size: 1.5rem; color: #fff;">The full course price is <span
                    style="text-decoration: line-through;">$297</span>, but for the launch period, you can enroll for:
            </p>
            <p style="margin-bottom: 2rem; font-size: 1.5rem;">One Payment Of</p>
            <div style="color: var(--color-neon); font-size: 5rem; font-weight: 800; line-height: 1; margin-bottom: 2rem;">$97
            </div>

            <p style="margin-bottom: 1.5rem; font-size: 1.125rem; letter-spacing: 2px;">THIS OFFER EXPIRES IN</p>

            <!-- Countdown Timer Display -->
            <div id="countdown" style="display: flex; justify-content: center; gap: 1.5rem; margin-bottom: 2rem;">
                <div class="timer-block">
                    <span id="days" style="font-size: 2.5rem; font-weight: 700; color: var(--color-neon);">02</span>
                    <span style="display: block; font-size: 0.75rem; text-transform: uppercase;">Days</span>
                </div>
                <div class="timer-block">
                    <span id="hours" style="font-size: 2.5rem; font-weight: 700; color: var(--color-neon);">15</span>
                    <span style="display: block; font-size: 0.75rem; text-transform: uppercase;">Hours</span>
                </div>
                <div class="timer-block">
                    <span id="minutes" style="font-size: 2.5rem; font-weight: 700; color: var(--color-neon);">08</span>
                    <span style="display: block; font-size: 0.75rem; text-transform: uppercase;">Mins</span>
                </div>
                <div class="timer-block">
                    <span id="seconds" style="font-size: 2.5rem; font-weight: 700; color: var(--color-neon);">41</span>
                    <span style="display: block; font-size: 0.75rem; text-transform: uppercase;">Secs</span>
                </div>
            </div>
        </div>
    </section>

    <!-- Single-Step Order Form Section -->
    <section id="checkout" class="checkout-section">
        <div class="container">
            <h2 style="text-align: center; color: var(--color-neon); margin-bottom: 1rem;">Secure Your Spot Now</h2>
            <p style="text-align: center; color: var(--color-text-muted); margin-bottom: 3rem;">Enter your details and
                proceed to secure checkout</p>

            <div class="checkout-container">
                <div class="order-summary" style="margin-bottom: 2rem;">
                    <div class="summary-row">
                        <span>Men's Divorce Mindset System</span>
                        <span>$97.00</span>
                    </div>
                    <div class="summary-row summary-total">
                        <span>Total Today:</span>
                        <span>$97.00</span>
                    </div>
                </div>

                <div class="form-group">
                    <label for="full-name">Full Name</label>
                    <input type="text" id="full-name" class="form-input" placeholder="Enter your full name" required>
                </div>
                <div class="form-group">
                    <label for="email">Email Address</label>
                    <input type="email" id="email" class="form-input" placeholder="Enter your email address" required>
                </div>

                <button class="btn btn-checkout" onclick="proceedToStripeCheckout('main')">
                    Proceed to Secure Checkout - $97 →
                </button>

                <p style="text-align: center; color: #777; font-size: 0.8rem; margin-top: 1rem;">
                    <span style="color: #4CAF50;">🔒 256-Bit SSL Secure Payment powered by Stripe.</span><br>
                    Your detailed access information will be sent to your email immediately.
                </p>
            </div>
        </div>
    </section>

    <script src="/join/main.js" is:inline></script>
</Layout>
