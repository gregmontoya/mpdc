        };
        
        try {
            if (typeof firebase !== 'undefined' && !firebase.apps.length) {
                firebase.initializeApp(firebaseConfig);
            }
        } catch (e) {
            console.warn('Firebase init error (ignoring for UI):', e);
        }

        // Video Play Logic (FAILSAFE NATIVE MODE)
        function playVSL() {
            // 1. Hide Overlay INSTANTLY
            const overlay = document.getElementById('video-overlay');
            if (overlay) overlay.style.display = 'none';

            // 2. Try VideoJS first (if loaded)
            if (window.videojs) {
                try {
                    const player = videojs('vsl-video');
                    player.muted(false);
                    player.currentTime(0);
                    player.controls(true);
                    player.play().catch(e => console.log('VideoJS Play Error:', e));
                    return;
                } catch (e) {
                    console.log('VideoJS Init Error, falling back to native:', e);
                }
            }
            
            // 3. Native Fallback (Robust)
            const nativeVideo = document.querySelector('video');
            if (nativeVideo) {
                nativeVideo.muted = false;
                nativeVideo.currentTime = 0;
                nativeVideo.controls = true;
                nativeVideo.play().catch(e => console.log('Native Play Error:', e));
            }
        }

        // Init
        document.addEventListener('DOMContentLoaded', () => {
             // 🎯 PRE-FILL Logic (PRO Move)
             const params = new URLSearchParams(window.location.search);
             const emailParam = params.get('email');
             if (emailParam) {
                 ['email-hero', 'email'].forEach(id => {
                     const el = document.getElementById(id);
                     if (el) el.value = emailParam;
                 });
             }
        });
    </script>
    
