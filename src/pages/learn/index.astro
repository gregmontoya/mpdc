---
import { getCollection } from 'astro:content';
export const prerender = true;
import { db } from '../../lib/server-firebase';
import Layout from '../../layouts/Layout.astro';
import { Image } from 'astro:assets';

// 1. Fetch Local Posts (The "Old" Posts - Guaranteed to work)
const localPosts = await getCollection('blog');
const formattedLocalPosts = localPosts.map(post => ({
    id: post.slug,
    data: {
        title: post.data.title,
        description: post.data.description,
        summary: post.data.description, // field mapping
        image: post.data.image || post.data.heroImage || '/images/default-post.jpg',
        category: post.data.category,
        publishedDate: post.data.publishDate,
        slug: post.slug // local posts rely on slug
    },
    source: 'local'
}));

// 2. Fetch Firestore Posts (The "New" Dynamic Posts)
let firestorePosts = [];
try {
    const postsSnapshot = await db.collection('posts').orderBy('publishedDate', 'desc').get();
    firestorePosts = postsSnapshot.docs.map(doc => {
       const d = doc.data();
       return {
            id: doc.id,
            data: {
                ...d,
                summary: d.summary || d.description
            },
            source: 'firestore'
       };
    });
} catch (error) {
    console.warn("⚠️ Could not fetch Firestore posts (likely missing service account locally). This is expected in dev without keys. Serving local posts only.");
}

// 3. Merge & Sort
const allPosts = [...firestorePosts, ...formattedLocalPosts].sort((a, b) => {
    return new Date(b.data.publishedDate).getTime() - new Date(a.data.publishedDate).getTime();
});

const featuredPost = allPosts.length > 0 ? allPosts[0] : null;
const remainingPosts = allPosts.slice(1);

// Calculate category counts (Dynamic)
const categoryCounts = allPosts.reduce((acc, post) => {
    const cat = post.data.category || 'Uncategorized';
    acc[cat] = (acc[cat] || 0) + 1;
    return acc;
}, {});

---
<Layout title="Learn | Men's Post-Divorce Coaching" description="Strategies, insights, and mental models for rebuilding your life after divorce.">
    <!-- HERO SECTION -->
    <header class="section" style="padding: 6rem 0 4rem; background-color: var(--color-bg-light);">
        <div class="container" style="max-width: 1200px; text-align: center;">
            <p style="font-size: 1rem; letter-spacing: 3px; text-transform: uppercase; color: var(--color-accent); font-weight: 700; margin-bottom: 1rem;">
                THE ARCHIVE
            </p>
            <h1 style="font-family: var(--font-heading); font-size: 3.5rem; color: var(--color-bg-primary); margin-bottom: 1.5rem; line-height: 1.1;">
                Master Your Mindset.<br>Rebuild Your Life.
            </h1>
            <p style="font-size: 1.25rem; color: #555; max-width: 700px; margin: 0 auto 3rem;">
                Actionable advice on divorce recovery, masculinity, and mental reprogramming. No fluff. Just what works.
            </p>
        </div>
    </header>

    <!-- CONTENT SECTION -->
    <section class="section" style="padding: 4rem 0 6rem; background-color: #fff;">
        <div class="container" style="max-width: 1200px;">
            <div class="blog-grid-layout">
                <!-- SIDEBAR FILTERS -->
                <aside class="blog-sidebar">
                    <div class="filter-card">
                        <h3>Categories</h3>
                        <ul>
                            <li>
                                <a href="/learn" class="active" aria-label="View all articles">
                                    <span>All Articles</span>
                                    <span>({allPosts.length})</span>
                                </a>
                            </li>
                            {Object.entries(categoryCounts).map(([cat, count]) => (
                                <li>
                                    <a 
                                        href={`/category/${cat.toLowerCase().replace(/ & /g, '-').replace(/ /g, '-')}`}
                                        aria-label={`View articles in ${cat}`}
                                    >
                                        <span>{cat}</span>
                                        <span>({count})</span>
                                    </a>
                                </li>
                            ))}
                        </ul>
                    </div>
                </aside>

                <!-- POSTS GRID -->
                <div class="posts-column">
                    {featuredPost && (
                        <div class="featured-post-card">
                            <div class="featured-img">
                                <a href={featuredPost.source === 'local' ? `/learn/${featuredPost.id}` : `/posts/${featuredPost.id}`} aria-label={`Featured: ${featuredPost.data.title}`}>
                                    <img 
                                        src={featuredPost.data.image || '/images/default-post.jpg'} 
                                        alt={featuredPost.data.title}
                                        loading="eager"
                                        width={800}
                                        height={450}
                                    />
                                </a>
                            </div>
                            <div class="featured-content">
                                <span class="category-tag">
                                    {featuredPost.data.category || 'Featured'}
                                </span>
                                <h2>
                                    <a href={featuredPost.source === 'local' ? `/learn/${featuredPost.id}` : `/posts/${featuredPost.id}`} aria-label={`Read featured article: ${featuredPost.data.title}`}>
                                        {featuredPost.data.title}
                                    </a>
                                </h2>
                                <p>
                                    {featuredPost.data.summary || featuredPost.data.description}
                                </p>
                                <a href={featuredPost.source === 'local' ? `/learn/${featuredPost.id}` : `/posts/${featuredPost.id}`} class="read-more">
                                    Read Article →
                                </a>
                            </div>
                        </div>
                    )}

                    <div class="standard-posts-grid">
                        {remainingPosts.map(post => (
                            <div class="post-card">
                                <div class="card-img">
                                    <a href={post.source === 'local' ? `/learn/${post.id}` : `/posts/${post.id}`} aria-label={`Article: ${post.data.title}`}>
                                        <img 
                                            src={post.data.image || '/images/default-post.jpg'} 
                                            alt={post.data.title}
                                            loading="lazy"
                                            width={400}
                                            height={225}
                                        />
                                    </a>
                                </div>
                                <div class="card-content">
                                    <span class="category-tag">
                                        {post.data.category || 'Article'}
                                    </span>
                                    <h3>
                                        <a href={post.source === 'local' ? `/learn/${post.id}` : `/posts/${post.id}`} aria-label={`Read article: ${post.data.title}`}>
                                            {post.data.title}
                                        </a>
                                    </h3>
                                    <p>
                                        {post.data.summary || post.data.description}
                                    </p>
                                    <a href={post.source === 'local' ? `/learn/${post.id}` : `/posts/${post.id}`} class="read-more-link">
                                        Read More →
                                    </a>
                                </div>
                            </div>
                        ))}
                    </div>
                </div>
            </div>
        </div>
    </section>
</Layout>

<style>
    .blog-grid-layout {
        display: grid;
        grid-template-columns: 320px 1fr;
        gap: 4rem;
    }
    
    .blog-sidebar {
        position: sticky;
        top: 120px;
        height: fit-content;
    }

    .filter-card {
        background: var(--color-bg-primary);
        border: 1px solid rgba(255,255,255,0.1);
        padding: 2.5rem;
        border-radius: 12px;
        color: white;
        box-shadow: 0 15px 35px rgba(0,0,0,0.2);
    }

    .filter-card h3 {
        font-family: var(--font-heading);
        font-size: 0.9rem;
        text-transform: uppercase;
        letter-spacing: 2px;
        margin-bottom: 2rem;
        color: var(--color-accent);
        border-bottom: 1px solid rgba(255,255,255,0.1);
        padding-bottom: 1rem;
    }

    .filter-card ul {
        list-style: none;
        padding: 0;
    }

    .filter-card li {
        margin-bottom: 1rem;
    }

    .filter-card a {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        color: rgba(255,255,255,0.8);
        text-decoration: none;
        transition: all 0.3s ease;
        font-size: 1rem;
        gap: 1rem;
    }

    .filter-card a span:first-child {
        flex: 1;
        line-height: 1.4;
    }

    .filter-card a span:last-child {
        color: var(--color-accent);
        font-weight: 700;
        opacity: 0.8;
    }

    .filter-card a.active, .filter-card a:hover {
        color: var(--color-accent);
    }
    
    .filter-card a:hover {
        transform: translateX(5px);
    }

    /* Featured Post */
    .featured-post-card {
        margin-bottom: 5rem;
        display: grid;
        grid-template-columns: 1fr 1fr;
        min-height: 500px;
        gap: 0;
        align-items: stretch;
        background: #fff;
        border: 1px solid #f0f0f0;
        border-radius: 16px;
        overflow: hidden;
        box-shadow: 0 20px 40px rgba(0,0,0,0.08);
        transition: transform 0.3s ease;
    }

    .featured-post-card:hover {
        transform: translateY(-5px);
    }

    .featured-img {
        position: relative;
        overflow: hidden;
    }

    .featured-img img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        transition: transform 0.6s ease;
    }

    .featured-post-card:hover .featured-img img {
        transform: scale(1.05);
    }

    .featured-content {
        padding: 4rem;
        display: flex;
        flex-direction: column;
        justify-content: center;
    }

    .category-tag {
        font-size: 0.75rem;
        text-transform: uppercase;
        letter-spacing: 3px;
        color: var(--color-accent);
        font-weight: 800;
        display: block;
        margin-bottom: 1.5rem;
    }

    .featured-content h2 {
        font-family: var(--font-heading);
        font-size: 2.75rem;
        margin-bottom: 1.5rem;
        line-height: 1.1;
        color: var(--color-bg-primary);
    }

    .featured-content a {
        color: inherit;
        text-decoration: none;
    }

    .featured-content p {
        color: #555;
        margin-bottom: 2.5rem;
        line-height: 1.6;
        font-size: 1.1rem;
    }

    .read-more {
        display: inline-block;
        font-weight: 800;
        color: var(--color-accent);
        text-decoration: none;
        font-size: 1rem;
        letter-spacing: 1px;
        text-transform: uppercase;
        border-bottom: 2px solid var(--color-accent);
        padding-bottom: 4px;
        transition: all 0.3s ease;
    }

    .read-more:hover {
        color: var(--color-accent-hover);
        border-bottom-color: var(--color-accent-hover);
        padding-right: 10px;
    }

    /* Standard Grid */
    .standard-posts-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 3rem 2.5rem;
    }

    .post-card {
        background: #fff;
        border: 1px solid #f0f0f0;
        border-radius: 12px;
        overflow: hidden;
        transition: all 0.3s ease;
        display: flex;
        flex-direction: column;
    }

    .post-card:hover {
        transform: translateY(-10px);
        box-shadow: 0 20px 40px rgba(0,0,0,0.1);
    }

    .card-img {
        height: 250px;
        overflow: hidden;
    }

    .card-img img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        transition: transform 0.6s ease;
    }

    .post-card:hover .card-img img {
        transform: scale(1.1);
    }

    .card-content {
        padding: 2.5rem;
        flex-grow: 1;
        display: flex;
        flex-direction: column;
    }

    .card-content h3 {
        font-family: var(--font-heading);
        font-size: 1.5rem;
        margin-bottom: 1rem;
        line-height: 1.2;
        color: var(--color-bg-primary);
    }

    .card-content a {
        color: inherit;
        text-decoration: none;
    }

    .read-more-link {
        margin-top: auto;
        font-size: 0.85rem;
        font-weight: 800;
        color: var(--color-accent);
        text-decoration: none;
        text-transform: uppercase;
        letter-spacing: 1px;
        transition: color 0.3s ease;
    }

    .read-more-link:hover {
        color: var(--color-accent-hover);
    }

    /* Responsive */
    @media (max-width: 1100px) {
        .blog-grid-layout {
            grid-template-columns: 1fr;
            gap: 3rem;
        }
        .blog-sidebar {
            position: relative;
            top: 0;
            max-width: 400px;
        }
        .featured-content {
            padding: 3rem;
        }
    }
    
    @media (max-width: 850px) {
        .featured-post-card {
            grid-template-columns: 1fr;
        }
        .featured-img {
            height: 300px;
        }
    }

    @media (max-width: 650px) {
        .standard-posts-grid {
            grid-template-columns: 1fr;
        }
        .section {
            padding: 2rem 0 !important;
        }
        header h1 {
            font-size: 2.5rem !important;
        }
    }
</style>
