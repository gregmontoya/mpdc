---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import '../../styles/blog-styles.css';

// Fetch all blog posts and sort by date descending
const allPosts = await getCollection('blog');
const sortedPosts = allPosts.sort((a, b) => 
    new Date(b.data.publishDate).getTime() - new Date(a.data.publishDate).getTime()
);

const featuredPost = sortedPosts[0];
const remainingPosts = sortedPosts.slice(1);

// Calculate category counts
const categories = ['Mindset & Mental Health', 'Divorce Strategy', 'Relationships & Dating', 'Co-Parenting', 'Financial Recovery'];
const categoryCounts = allPosts.reduce((acc, post) => {
    const cat = post.data.category;
    acc[cat] = (acc[cat] || 0) + 1;
    return acc;
}, {});
---

<style is:global>
/* ========================================
   MPDC Blog Styles - Ahrefs-Inspired Design
   THREE COLUMN LAYOUT
   ======================================== */

:root {
    /* MPDC Brand Colors */
    --color-bg-primary: #0b3b36;
    /* Deep Steel Green */
    --color-bg-dark: #0d4d47;
    /* Darker Green */
    --color-accent: #C4613A;
    /* Burnt Copper */
    --color-accent-hover: #a54f2f;
    /* Darker Copper */
    --color-text-light: #ffffff;
    /* White */
    --color-text-muted: #e8e1d4;
    /* Sandstone Beige */
    --color-text-dark: #1A1F24;
    /* Charcoal Slate */
    --color-bg-light: #f8f9fa;
    /* Light Gray */
    --color-border: #e1e4e8;
    /* Border Gray */

    /* Typography */
    --font-heading: 'Montserrat', sans-serif;
    --font-body: 'Open Sans', sans-serif;
}

* {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
}

body.blog-page {
    font-family: var(--font-body);
    font-size: 18px;
    line-height: 1.7;
    color: var(--color-text-dark) !important;
    background-color: #ffffff !important;
    background-image: none !important;
    /* Remove grid pattern */
    -webkit-font-smoothing: antialiased;
}

/* ========================================
   ARTICLE HEADER - SPLIT HERO
   ======================================== */

.article-header.split-hero {
    background-color: #ffffff;
    padding: 0;
    margin-bottom: 3rem;
    overflow: hidden;
    border-bottom: 1px solid var(--color-border);
}

.header-container {
    display: grid;
    grid-template-columns: 1fr 1fr;
    /* 50/50 Split */
    min-height: 500px;
}

.hero-content {
    padding: 4rem 4rem 4rem calc((100vw - 1400px) / 2 + 2rem);
    display: flex;
    flex-direction: column;
    justify-content: center;
}

@media (max-width: 1400px) {
    .hero-content {
        padding-left: 2rem;
    }
}

.hero-image-side {
    position: relative;
    overflow: hidden;
}

.hero-image-side img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
}

.article-header h1 {
    font-family: var(--font-heading);
    font-size: 3.5rem;
    line-height: 1.1;
    color: var(--color-text-dark);
    margin-bottom: 1.5rem;
    font-weight: 800;
    letter-spacing: -1px;
}

.article-subtitle {
    font-size: 1.25rem;
    line-height: 1.6;
    color: #4b5563;
    margin-bottom: 2.5rem;
    max-width: 600px;
}

.article-meta {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-top: 2rem;
    border-top: 1px solid rgba(255, 255, 255, 0.15);
}

.breadcrumb {
    font-size: 0.875rem;
    color: #6b7280;
    margin-bottom: 1.5rem;
}

.breadcrumb a {
    color: var(--color-text-muted);
    text-decoration: none;
    transition: color 0.3s ease;
}

.breadcrumb a:hover {
    color: var(--color-accent);
}

.author-info {
    display: flex;
    align-items: center;
}

.author-name {
    font-weight: 700;
    color: var(--color-text-dark);
    font-size: 0.95rem;
    margin-bottom: 0.25rem;
}

.publish-date {
    font-size: 0.875rem;
    color: #6b7280;
}

.share-btn {
    background-color: transparent;
    border: 2px solid var(--color-bg-primary);
    color: var(--color-bg-primary);
    padding: 0.5rem 1.5rem;
    border-radius: 6px;
    font-weight: 600;
    font-size: 0.9rem;
    cursor: pointer;
    transition: all 0.3s ease;
}

.share-btn:hover {
    background-color: var(--color-bg-primary);
    color: white;
}

@media (max-width: 968px) {
    .header-container {
        grid-template-columns: 1fr;
    }

    .hero-image-side {
        height: 300px;
        order: -1;
    }

    .hero-content {
        padding: 3rem 2rem;
    }
}

/* ========================================
   THREE COLUMN LAYOUT
   ======================================== */

.three-column-layout {
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 2rem;
    display: grid;
    grid-template-columns: 260px 1fr 280px;
    gap: 3rem;
    position: relative;
}

/* ========================================
   LEFT SIDEBAR - TABLE OF CONTENTS
   ======================================== */

.left-sidebar {
    position: relative;
}

.toc-sticky {
    position: sticky;
    top: 20px;
    background-color: var(--color-bg-light);
    padding: 1.5rem;
    border-radius: 8px;
    border: 1px solid var(--color-border);
}

.toc-sticky h3 {
    font-family: var(--font-heading);
    font-size: 0.875rem;
    text-transform: uppercase;
    letter-spacing: 1px;
    color: var(--color-text-dark);
    margin-bottom: 1rem;
    font-weight: 700;
}

.toc-sticky ul {
    list-style: none;
}

.toc-sticky li {
    margin-bottom: 0.75rem;
}

.toc-sticky a {
    font-size: 0.875rem;
    color: var(--color-text-dark);
    text-decoration: none;
    line-height: 1.4;
    transition: color 0.3s ease;
    display: block;
}

.toc-sticky a:hover {
    color: var(--color-accent);
}

/* ========================================
   CENTER COLUMN - ARTICLE CONTENT
   ======================================== */

.article-content {
    max-width: 100%;
    padding-bottom: 4rem;
}

/* ========================================
   RIGHT SIDEBAR - AUTHOR & CTA
   ======================================== */

.right-sidebar {
    position: relative;
}

.sidebar-card {
    background-color: var(--color-bg-light);
    padding: 1.5rem;
    border-radius: 8px;
    border: 1px solid var(--color-border);
    margin-bottom: 1.5rem;
}

/* Author Bio Card */
.author-bio-card {
    text-align: center;
}

.author-bio-avatar {
    width: 80px;
    height: 80px;
    border-radius: 50%;
    margin: 0 auto 1rem;
    border: 3px solid var(--color-accent);
}

.author-bio-card h4 {
    font-family: var(--font-heading);
    font-size: 1.1rem;
    color: var(--color-bg-primary);
    margin-bottom: 0.25rem;
    font-weight: 700;
}

.author-title {
    font-size: 0.875rem;
    color: var(--color-accent);
    font-weight: 600;
    margin-bottom: 1rem;
}

.author-bio {
    font-size: 0.875rem;
    line-height: 1.6;
    color: #6c757d;
    margin-bottom: 1rem;
}

.author-social {
    display: flex;
    gap: 1rem;
    justify-content: center;
}

.social-link {
    font-size: 0.875rem;
    color: var(--color-accent);
    text-decoration: none;
    font-weight: 600;
    transition: color 0.3s ease;
}

.social-link:hover {
    color: var(--color-accent-hover);
}

/* Sticky CTA Card */
.sidebar-cta-card {
    background: linear-gradient(135deg, var(--color-bg-primary) 0%, var(--color-bg-dark) 100%);
    border: none;
    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.1);
    position: sticky;
    top: 20px;
}

.sidebar-cta-card h4 {
    font-family: var(--font-heading);
    font-size: 1.1rem;
    color: var(--color-text-light);
    margin-bottom: 0.75rem;
    font-weight: 700;
}

.sidebar-cta-card p {
    font-size: 0.875rem;
    line-height: 1.5;
    color: var(--color-text-muted);
    margin-bottom: 1.25rem;
}

.sidebar-optin-form {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
}

.sidebar-email-input {
    width: 100%;
    padding: 0.75rem;
    border: 1px solid rgba(255, 255, 255, 0.3);
    border-radius: 6px;
    font-size: 0.9rem;
    background-color: rgba(255, 255, 255, 0.1);
    color: var(--color-text-light);
    font-family: var(--font-body);
}

.sidebar-email-input::placeholder {
    color: rgba(255, 255, 255, 0.6);
}

.sidebar-email-input:focus {
    outline: none;
    border-color: var(--color-accent);
    background-color: rgba(255, 255, 255, 0.15);
}

.sidebar-cta-button {
    width: 100%;
    padding: 0.875rem;
    background-color: var(--color-accent);
    color: var(--color-text-light);
    border: none;
    border-radius: 6px;
    font-weight: 700;
    font-size: 0.95rem;
    cursor: pointer;
    transition: background-color 0.3s ease;
    font-family: var(--font-heading);
    text-transform: uppercase;
    letter-spacing: 0.5px;
}

.sidebar-cta-button:hover {
    background-color: var(--color-accent-hover);
}

.sidebar-privacy {
    font-size: 0.75rem;
    color: var(--color-text-muted);
    text-align: center;
    margin-top: 0.5rem;
    opacity: 0.8;
}

/* Popular Articles Card */
.popular-articles-card h4 {
    font-family: var(--font-heading);
    font-size: 0.95rem;
    color: var(--color-bg-primary);
    margin-bottom: 1rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.5px;
}

.popular-list {
    list-style: none;
}

.popular-list li {
    margin-bottom: 0.75rem;
}

.popular-list a {
    font-size: 0.875rem;
    color: var(--color-text-dark);
    text-decoration: none;
    line-height: 1.4;
    transition: color 0.3s ease;
    display: block;
}

.popular-list a:hover {
    color: var(--color-accent);
}

/* ========================================
   CONTENT BLOCKS
   ======================================== */

.content-block {
    margin-bottom: 3rem;
}

.lead-paragraph {
    font-size: 1.35rem;
    line-height: 1.7;
    color: var(--color-text-dark);
    margin-bottom: 1.5rem;
    font-weight: 400;
}

.content-block h2 {
    font-family: var(--font-heading);
    font-size: 2rem;
    line-height: 1.3;
    color: var(--color-bg-primary);
    margin-bottom: 1.25rem;
    margin-top: 2.5rem;
    font-weight: 800;
    letter-spacing: -0.5px;
}

.content-block h3 {
    font-family: var(--font-heading);
    font-size: 1.5rem;
    line-height: 1.3;
    color: var(--color-bg-primary);
    margin-bottom: 1rem;
    margin-top: 2rem;
    font-weight: 700;
}

.content-block h4 {
    font-family: var(--font-heading);
    font-size: 1.15rem;
    line-height: 1.4;
    color: var(--color-bg-primary);
    margin-bottom: 0.75rem;
    margin-top: 1.5rem;
    font-weight: 700;
}

.content-block p {
    margin-bottom: 1.5rem;
    color: var(--color-text-dark);
}

.content-block ul,
.content-block ol {
    margin-bottom: 1.5rem;
    padding-left: 1.5rem;
}

.content-block li {
    margin-bottom: 0.75rem;
    line-height: 1.7;
}

.content-block strong {
    font-weight: 700;
    color: var(--color-bg-primary);
}

/* ========================================
   SPECIAL CONTENT BLOCKS
   ======================================== */

.callout-box {
    background-color: var(--color-bg-primary);
    padding: 2rem;
    border-radius: 8px;
    margin: 2.5rem 0;
    border-left: 4px solid var(--color-accent);
}

.callout-box h4 {
    color: var(--color-text-light);
    margin-top: 0;
    margin-bottom: 1rem;
}

.callout-box p {
    color: var(--color-text-muted);
    margin-bottom: 1rem;
}

.callout-box ul {
    color: var(--color-text-muted);
    margin-bottom: 1.5rem;
}

.callout-cta {
    display: inline-block;
    background-color: var(--color-accent);
    color: var(--color-text-light);
    padding: 0.75rem 1.5rem;
    border-radius: 6px;
    font-weight: 700;
    text-decoration: none;
    transition: background-color 0.3s ease;
}

.callout-cta:hover {
    background-color: var(--color-accent-hover);
}

.tip-box {
    background-color: #fff9f0;
    border-left: 4px solid var(--color-accent);
    padding: 1.5rem;
    border-radius: 6px;
    margin: 2rem 0;
}

.tip-box p {
    margin-bottom: 0;
    color: var(--color-text-dark);
}

.quote-block {
    margin: 2.5rem 0;
    padding: 2rem;
    background-color: var(--color-bg-light);
    border-left: 4px solid var(--color-accent);
    border-radius: 6px;
}

.quote-block blockquote {
    margin: 0;
}

.quote-block p {
    font-size: 1.25rem;
    line-height: 1.6;
    color: var(--color-text-dark);
    font-style: italic;
    margin-bottom: 1rem;
}

.quote-author {
    font-size: 0.95rem;
    color: var(--color-accent);
    font-weight: 700;
    font-style: normal;
}

.image-block {
    margin: 2.5rem 0;
}

.image-block img {
    width: 100%;
    border-radius: 8px;
    margin-bottom: 0.75rem;
}

.image-caption {
    font-size: 0.875rem;
    color: #6c757d;
    text-align: center;
    font-style: italic;
}

.cta-box {
    background: linear-gradient(135deg, var(--color-bg-primary) 0%, var(--color-bg-dark) 100%);
    padding: 3rem;
    border-radius: 12px;
    text-align: center;
    margin: 3rem 0;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.1);
}

.cta-box h3 {
    color: var(--color-text-light);
    margin-top: 0;
    margin-bottom: 1rem;
    font-size: 2rem;
}

.cta-box p {
    color: var(--color-text-muted);
    margin-bottom: 2rem;
    font-size: 1.1rem;
}

.cta-button {
    display: inline-block;
    background-color: var(--color-accent);
    color: var(--color-text-light);
    padding: 1rem 2.5rem;
    border-radius: 6px;
    font-weight: 700;
    font-size: 1.1rem;
    text-decoration: none;
    transition: all 0.3s ease;
    box-shadow: 0 4px 15px rgba(196, 97, 58, 0.3);
}

.cta-button:hover {
    background-color: var(--color-accent-hover);
    transform: translateY(-2px);
    box-shadow: 0 6px 20px rgba(196, 97, 58, 0.4);
}

.cta-subtext {
    font-size: 0.875rem;
    color: var(--color-text-muted);
    margin-top: 1rem;
    opacity: 0.8;
}

/* ========================================
   RELATED ARTICLES
   ======================================== */

.related-articles {
    background-color: var(--color-bg-light);
    padding: 4rem 2rem;
    border-top: 1px solid var(--color-border);
}

.related-container {
    max-width: 1200px;
    margin: 0 auto;
}

.related-container h2 {
    font-family: var(--font-heading);
    font-size: 2rem;
    color: var(--color-bg-primary);
    margin-bottom: 2rem;
    font-weight: 800;
}

.related-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2rem;
}

.related-card {
    background-color: #ffffff;
    border-radius: 8px;
    overflow: hidden;
    border: 1px solid var(--color-border);
    transition: transform 0.3s ease, box-shadow 0.3s ease;
}

.related-card:hover {
    transform: translateY(-5px);
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.1);
}

.related-image img {
    width: 100%;
    height: 200px;
    object-fit: cover;
}

.related-content {
    padding: 1.5rem;
}

.related-content h3 {
    font-family: var(--font-heading);
    font-size: 1.25rem;
    color: var(--color-bg-primary);
    margin-bottom: 0.75rem;
    font-weight: 700;
    line-height: 1.3;
}

.related-content p {
    font-size: 0.95rem;
    color: #6c757d;
    margin-bottom: 1rem;
    line-height: 1.5;
}

.related-content a {
    color: var(--color-accent);
    font-weight: 700;
    text-decoration: none;
    font-size: 0.9rem;
    transition: color 0.3s ease;
}

.related-content a:hover {
    color: var(--color-accent-hover);
}

/* ========================================
   RESPONSIVE DESIGN
   ======================================== */

@media (max-width: 1200px) {
    .three-column-layout {
        grid-template-columns: 1fr;
        gap: 2rem;
    }

    .left-sidebar,
    .right-sidebar {
        display: none;
    }

    .article-content {
        max-width: 800px;
        margin: 0 auto;
    }
}

@media (max-width: 768px) {
    .article-header h1 {
        font-size: 2rem;
    }

    .article-subtitle {
        font-size: 1.1rem;
    }

    .article-meta {
        flex-direction: column;
        align-items: flex-start;
        gap: 1rem;
    }

    .content-block h2 {
        font-size: 1.5rem;
    }

    .content-block h3 {
        font-size: 1.25rem;
    }

    .related-grid {
        grid-template-columns: 1fr;
    }

    .footer-links {
        grid-template-columns: 1fr;
    }

    .nav-links {
        display: none;
    }

    .lead-paragraph {
        font-size: 1.15rem;
    }
}

/* ========================================
   Additional Styles from blog-styles.css
   ======================================== */

/* Blog Index Header */
.blog-index-header {
    background-color: var(--color-bg-primary);
    color: var(--color-text-light);
    padding: 6rem 1rem 4rem;
    text-align: center;
    position: relative;
    overflow: hidden;
}

.blog-index-header::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background-image: 
        radial-gradient(circle at 10% 20%, rgba(196, 97, 58, 0.1) 0%, transparent 20%),
        radial-gradient(circle at 90% 80%, rgba(196, 97, 58, 0.1) 0%, transparent 20%);
    pointer-events: none;
}

.blog-index-header-content h1 {
    font-family: var(--font-heading);
    font-size: 3.5rem;
    margin-bottom: 1rem;
    font-weight: 800;
    letter-spacing: -1px;
}

.blog-index-subtitle {
    font-size: 1.25rem;
    color: var(--color-text-muted);
    max-width: 600px;
    margin: 0 auto;
    font-weight: 400;
}

/* Flex Container for Sidebar + Feed */
.blog-index-container {
    display: grid;
    grid-template-columns: 280px 1fr;
    gap: 3rem;
    max-width: 1400px;
    margin: 3rem auto;
    padding: 0 2rem;
}

/* Sidebar Styles */
.category-sidebar {
    position: relative;
}

.category-sticky {
    position: sticky;
    top: 2rem;
    background: #fff;
    padding: 1.5rem;
    border-radius: 8px;
    border: 1px solid var(--color-border);
    box-shadow: 0 4px 6px rgba(0,0,0,0.02);
}

.category-sticky h3 {
    font-family: var(--font-heading);
    font-size: 1rem;
    text-transform: uppercase;
    letter-spacing: 1px;
    margin-bottom: 1rem;
    color: var(--color-bg-primary);
    border-bottom: 2px solid var(--color-accent);
    padding-bottom: 0.5rem;
    display: inline-block;
}

.category-list {
    list-style: none;
}

.category-list li {
    margin-bottom: 0.5rem;
}

.category-link {
    display: flex;
    justify-content: space-between;
    padding: 0.75rem 1rem;
    text-decoration: none;
    color: var(--color-text-dark);
    font-weight: 600;
    border-radius: 6px;
    transition: all 0.2s ease;
    font-size: 0.95rem;
}

.category-link:hover, .category-link.active {
    background-color: #f0f7f6; /* Very light green tint */
    color: var(--color-bg-primary);
}

.category-link .count {
    background: #e1e4e8;
    color: #4b5563;
    padding: 0.1rem 0.5rem;
    border-radius: 12px;
    font-size: 0.75rem;
}

.category-link.active .count {
    background: var(--color-accent);
    color: #fff;
}

/* Featured Article */
.featured-article {
    display: grid;
    grid-template-columns: 1.2fr 0.8fr;
    background: #fff;
    border: 1px solid var(--color-border);
    border-radius: 12px;
    overflow: hidden;
    margin-bottom: 3rem;
    box-shadow: 0 10px 30px rgba(0,0,0,0.05);
    transition: transform 0.3s ease;
}

.featured-article:hover {
    transform: translateY(-5px);
    box-shadow: 0 15px 40px rgba(0,0,0,0.1);
}

.featured-image {
    position: relative;
    height: 100%;
    min-height: 400px;
}

.featured-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
}

.featured-badge {
    position: absolute;
    top: 1.5rem;
    left: 1.5rem;
    background: var(--color-accent);
    color: #fff;
    padding: 0.5rem 1rem;
    border-radius: 4px;
    font-weight: 700;
    text-transform: uppercase;
    font-size: 0.75rem;
    letter-spacing: 1px;
}

.featured-content {
    padding: 3rem;
    display: flex;
    flex-direction: column;
    justify-content: center;
}

.featured-content h2 a {
    font-family: var(--font-heading);
    font-size: 2.5rem;
    line-height: 1.1;
    color: var(--color-text-dark);
    text-decoration: none;
    transition: color 0.2s;
    display: block;
    margin-bottom: 1rem;
}

.featured-content h2 a:hover {
    color: var(--color-accent);
}

.featured-content p {
    color: #4b5563;
    font-size: 1.1rem;
    line-height: 1.6;
    margin-bottom: 1.5rem;
}

/* Grid Layout */
.blog-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 2rem;
}

.blog-card {
    background: #fff;
    border: 1px solid var(--color-border);
    border-radius: 8px;
    overflow: hidden;
    transition: all 0.3s ease;
    display: flex;
    flex-direction: column;
}

.blog-card:hover {
    transform: translateY(-5px);
    box-shadow: 0 10px 25px rgba(0,0,0,0.08);
}

.blog-card-image {
    height: 200px;
    overflow: hidden;
}

.blog-card-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s ease;
}

.blog-card:hover .blog-card-image img {
    transform: scale(1.05);
}

.blog-card-content {
    padding: 1.5rem;
    flex-grow: 1;
    display: flex;
    flex-direction: column;
}

.article-category {
    text-transform: uppercase;
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--color-accent);
    margin-bottom: 0.5rem;
    display: block;
    text-decoration: none;
}

.blog-card-content h3 a {
    font-family: var(--font-heading);
    font-size: 1.35rem;
    line-height: 1.3;
    color: var(--color-text-dark);
    text-decoration: none;
    margin-bottom: 0.75rem;
    display: block;
    transition: color 0.2s;
}

.blog-card-content h3 a:hover {
    color: var(--color-accent);
}

.blog-card-content p {
    font-size: 0.95rem;
    color: #6b7280;
    line-height: 1.5;
    margin-bottom: 1rem;
    flex-grow: 1;
}

.article-meta-small {
    font-size: 0.8rem;
    color: #9ca3af;
    border-top: 1px solid #f3f4f6;
    padding-top: 1rem;
    display: flex;
    gap: 1rem;
}

/* Load More Button */
.load-more-container {
    text-align: center;
    margin-top: 4rem;
}

.load-more-btn {
    background: transparent;
    border: 2px solid var(--color-bg-primary);
    color: var(--color-bg-primary);
    padding: 1rem 3rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 1px;
    cursor: pointer;
    transition: all 0.3s;
}

.load-more-btn:hover {
    background: var(--color-bg-primary);
    color: #fff;
}

@media (max-width: 1024px) {
    .blog-index-container {
        grid-template-columns: 1fr;
    }
    
    .category-sidebar {
        display: none; /* Hide sidebar on tablet/mobile for MVP */
    }
}

@media (max-width: 768px) {
    .featured-article {
        grid-template-columns: 1fr;
    }
    
    .featured-image {
        min-height: 250px;
    }
    
    .featured-content {
        padding: 1.5rem;
    }
    
    .blog-index-header h1 {
        font-size: 2.5rem;
    }
}
</style>

<Layout title="Learn | Men's Post-Divorce Coaching" bodyClass="blog-page">
    <meta slot="head"
        content="Expert guidance and actionable strategies for men rebuilding their lives after divorce. Browse our library of articles by category."
        name="description" />

    <!-- Blog Index Header -->
    <header class="blog-index-header">
        <div class="blog-index-header-content">
            <h1>Learn</h1>
            <p class="blog-index-subtitle">Actionable strategies and proven frameworks to help you rebuild your life
                after divorce.</p>
        </div>
    </header>
    <!-- Blog Index Container -->
    <div class="blog-index-container">
        <!-- Category Filter Sidebar -->
        <aside class="category-sidebar">
            <div class="category-sticky">
                <h3>Categories</h3>
                <ul class="category-list">
                    <li><a class="category-link active" data-category="all" href="/learn">All Articles
                            <span class="count">({allPosts.length})</span></a></li>
                    {categories.map(cat => {
                        const slug = cat.toLowerCase().replace(/ & /g, '-').replace(/ /g, '-');
                        return (
                            <li>
                                <a class="category-link" data-category={cat.toLowerCase().split(' ')[0]} href={`/learn/category/${slug}`}>
                                    {cat} <span class="count">({categoryCounts[cat] || 0})</span>
                                </a>
                            </li>
                        );
                    })}
                </ul>
            </div>
        </aside>
        <!-- Blog Roll Grid -->
        <main class="blog-roll-main">
            {featuredPost && (
                <article class="featured-article">
                    <div class="featured-image">
                        <img alt={featuredPost.data.title} src={featuredPost.data.image || "/images/blog/featured-change.png"} />
                        <span class="featured-badge">Featured</span>
                    </div>
                    <div class="featured-content">
                        <a class="article-category" href={featuredPost.data.categoryUrl}>{featuredPost.data.category}</a>
                        <h2><a href={`/learn/${featuredPost.slug}`}>{featuredPost.data.title}</a></h2>
                        <p>{featuredPost.data.description}</p>
                        <div class="article-meta-small">
                            <span class="author-small">By {featuredPost.data.author}</span>
                            <span class="date-small">{featuredPost.data.publishDate}</span>
                            <span class="read-time">{featuredPost.data.readTime}</span>
                        </div>
                    </div>
                </article>
            )}

            <!-- Article Grid -->
            <div class="blog-grid">
                {remainingPosts.map(post => (
                    <article class="blog-card" data-category={post.data.category.toLowerCase()}>
                        <div class="blog-card-image">
                            <img alt={post.data.title} src={post.data.image || "/images/blog/rebuild-life.png"} />
                        </div>
                        <div class="blog-card-content">
                            <a class="article-category" href={post.data.categoryUrl}>{post.data.category}</a>
                            <h3><a href={`/learn/${post.slug}`}>{post.data.title}</a></h3>
                            <p>{post.data.description}</p>
                            <div class="article-meta-small">
                                <span class="author-small">By {post.data.author}</span>
                                <span class="date-small">{post.data.publishDate}</span>
                            </div>
                        </div>
                    </article>
                ))}
            </div>

            {remainingPosts.length > 6 && (
                <div class="load-more-container">
                    <button class="load-more-btn">Load More Articles</button>
                </div>
            )}
        </main>
    </div>
</Layout>
