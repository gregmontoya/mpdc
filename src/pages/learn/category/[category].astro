---
import { getCollection } from 'astro:content';
import Layout from '../../../layouts/Layout.astro';
import '../../../styles/blog-styles.css';

export async function getStaticPaths() {
    const allPosts = await getCollection('blog');
    // Hardcode categories to ensure pages exist even if no posts
    const categories = ['Mindset & Mental Health', 'Divorce Strategy', 'Relationships & Dating', 'Co-Parenting', 'Financial Recovery'];

    return categories.map((cat) => {
        const slug = cat.toLowerCase().replace(/ & /g, '-').replace(/ /g, '-');
        return {
            params: { category: slug },
            props: { categoryName: cat },
        };
    });
}

const { category: categorySlug } = Astro.params;
const { categoryName } = Astro.props;

// Fetch all blog posts for this category
const allPosts = await getCollection('blog');
const categoryPosts = allPosts
    .filter((post) => post.data.category === categoryName)
    .sort((a, b) => new Date(b.data.publishDate).getTime() - new Date(a.data.publishDate).getTime());

// For the sidebar
const categories = ['Mindset & Mental Health', 'Divorce Strategy', 'Relationships & Dating', 'Co-Parenting', 'Financial Recovery'];
const categoryCounts = allPosts.reduce((acc, post) => {
    const cat = post.data.category;
    acc[cat] = (acc[cat] || 0) + 1;
    return acc;
}, {});
---

<Layout title={`${categoryName} | Men's Post-Divorce Coaching`} bodyClass="blog-page">
    <meta slot="head"
        content={`Expert guidance on ${categoryName} for men rebuilding their lives after divorce.`}
        name="description" />

    <header class="blog-index-header">
        <div class="blog-index-header-content">
            <h1>{categoryName}</h1>
            <p class="blog-index-subtitle">Articles and strategies specifically for {categoryName.toLowerCase()}.</p>
        </div>
    </header>

    <div class="blog-index-container">
        <aside class="category-sidebar">
            <div class="category-sticky">
                <h3>Categories</h3>
                <ul class="category-list">
                    <li><a class="category-link" data-category="all" href="/learn">All Articles
                            <span class="count">({allPosts.length})</span></a></li>
                    {categories.map(cat => {
                        const slug = cat.toLowerCase().replace(/ & /g, '-').replace(/ /g, '-');
                        return (
                            <li>
                                <a class={`category-link ${slug === categorySlug ? 'active' : ''}`} 
                                   data-category={cat.toLowerCase().split(' ')[0]} 
                                   href={`/learn/category/${slug}`}>
                                    {cat} <span class="count">({categoryCounts[cat] || 0})</span>
                                </a>
                            </li>
                        );
                    })}
                </ul>
            </div>
        </aside>

        <main class="blog-roll-main">
            <div class="blog-grid">
                {categoryPosts.map(post => (
                    <article class="blog-card" data-category={post.data.category.toLowerCase()}>
                        <div class="blog-card-image">
                            <img alt={post.data.title} src={post.data.image || "/images/blog/rebuild-life.png"} />
                        </div>
                        <div class="blog-card-content">
                            <a class="article-category" href={post.data.categoryUrl}>{post.data.category}</a>
                            <h3><a href={`/learn/${post.slug}`}>{post.data.title}</a></h3>
                            <p>{post.data.description}</p>
                            <div class="article-meta-small">
                                <span class="author-small">By {post.data.author}</span>
                                <span class="date-small">{post.data.publishDate}</span>
                            </div>
                        </div>
                    </article>
                ))}
            </div>
        </main>
    </div>
</Layout>
