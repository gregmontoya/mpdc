---
import { getCollection } from 'astro:content';
export const prerender = true;
import BlogPost from '../../layouts/BlogPost.astro';

// SSR Mode: We don't use getStaticPaths. Instead, we fetch data based on the slug param.
export async function getStaticPaths() {
  const blogEntries = await getCollection('blog');
  return blogEntries.map(entry => ({
    params: { slug: entry.slug },
    props: { entry },
  }));
}

const { slug } = Astro.params;
const { entry } = Astro.props;

if (!slug) {
  return Astro.redirect('/404');
}

// This part is now handled by getStaticPaths/props for build efficiency
/*
const blogEntries = await getCollection('blog');
const entry = blogEntries.find(post => post.slug === slug);

if (!entry) {
  return Astro.redirect('/404');
}
*/

const { Content } = await entry.render();
---

<BlogPost frontmatter={entry.data} slug={entry.slug}>
  <Content />
</BlogPost>
