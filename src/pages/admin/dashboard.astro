    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>MPDC Command Center</title>
    <link href="https://fonts.googleapis.com/css2?family=Anton&family=Inter:wght@300;400;600;800&display=swap"
        rel="stylesheet">
    <script src="https://kit.fontawesome.com/a076d05399.js" crossorigin="anonymous"></script>
    <!-- Ensure FA is loaded -->
    <!-- Supabase Client -->
    <script is:inline src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
    <script is:inline src="https://www.gstatic.com/firebasejs/10.8.0/firebase-app-compat.js"></script>
    <script is:inline src="https://www.gstatic.com/firebasejs/10.8.0/firebase-firestore-compat.js"></script>

    <style>
        :root {
            --color-bg: #0a0a0a;
            --color-card: #141414;
            --color-text: #ffffff;
            --color-text-muted: #888888;
            --color-neon: #a0d6b4;
            /* Reduced intensity neon green */
            --color-accent: #C4613A;
            /* Copper/Orange */
        }

        body {
            font-family: 'Inter', sans-serif;
            background-color: var(--color-bg);
            color: var(--color-text);
            margin: 0;
            padding: 20px;
        }

        .header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 30px;
            padding-bottom: 20px;
            border-bottom: 1px solid #333;
        }

        h1 {
            font-family: 'Anton', sans-serif;
            text-transform: uppercase;
            letter-spacing: 1px;
            margin: 0;
            font-size: 2rem;
        }

        .refresh-btn {
            background: transparent;
            border: 1px solid var(--color-neon);
            color: var(--color-neon);
            padding: 8px 16px;
            cursor: pointer;
            font-weight: bold;
            transition: all 0.3s;
        }

        .refresh-btn:hover {
            background: var(--color-neon);
            color: #000;
        }

        /* KPI Cards */
        .kpi-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 20px;
            margin-bottom: 40px;
        }

        .kpi-card {
            background: var(--color-card);
            padding: 20px;
            border-left: 4px solid var(--color-neon);
            border-radius: 4px;
        }

        .kpi-label {
            color: var(--color-text-muted);
            font-size: 0.85rem;
            text-transform: uppercase;
            letter-spacing: 1px;
            margin-bottom: 10px;
        }

        .kpi-value {
            font-size: 2.5rem;
            font-family: 'Anton', sans-serif;
            color: var(--color-text);
        }

        /* Tables */
        .section-title {
            font-family: 'Anton', sans-serif;
            font-size: 1.5rem;
            margin-bottom: 15px;
            color: var(--color-text);
        }

        .data-table {
            width: 100%;
            border-collapse: collapse;
            background: var(--color-card);
            border-radius: 4px;
            overflow: hidden;
            margin-bottom: 40px;
        }

        .data-table th,
        .data-table td {
            text-align: left;
            padding: 15px;
            border-bottom: 1px solid #222;
        }

        .data-table th {
            background-color: #1a1a1a;
            color: var(--color-text-muted);
            font-size: 0.8rem;
            text-transform: uppercase;
        }

        .data-table tr:hover {
            background-color: #1f1f1f;
        }

        .status-badge {
            padding: 4px 8px;
            border-radius: 4px;
            font-size: 0.75rem;
            font-weight: bold;
            text-transform: uppercase;
        }

        .badge-captured {
            background: rgba(160, 214, 180, 0.2);
            color: var(--color-neon);
        }

        .badge-student {
            background: rgba(196, 97, 58, 0.2);
            color: var(--color-accent);
        }

        #loading {
            text-align: center;
            padding: 40px;
            color: var(--color-text-muted);
        }
    </style>
</head>

<body>

    <div class="header">
        <h1>MPDC Command Center</h1>
        <button class="refresh-btn" onclick="fetchData()">REFRESH DATA</button>
    </div>

    <!-- Metrics -->
    <div class="kpi-grid">
        <div class="kpi-card">
            <div class="kpi-label">Total Leads (Abandonments)</div>
            <div class="kpi-value" id="count-leads">-</div>
        </div>
        <div class="kpi-card" style="border-color: var(--color-accent);">
            <div class="kpi-label">Active Students</div>
            <div class="kpi-value" id="count-students">-</div>
        </div>
        <div class="kpi-card" style="border-color: #fff;">
            <div class="kpi-label">Est. Revenue (Lifetime)</div>
            <div class="kpi-value" id="revenue-est">-</div>
        </div>
    </div>

    <!-- Leads Table -->
    <div>
        <div class="section-title">🛑 Recent Cart Abandonments (Leads)</div>
        <table class="data-table">
            <thead>
                <tr>
                    <th>Date</th>
                    <th>Name</th>
                    <th>Email</th>
                    <th>Status</th>
                </tr>
            </thead>
            <tbody id="leads-body">
                <!-- Data injected here -->
            </tbody>
        </table>
    </div>

    <!-- Students Table -->
    <div>
        <div class="section-title">✅ Recent Enrolled Students</div>
        <table class="data-table">
            <thead>
                <tr>
                    <th>Joined Date</th>
                    <th>Name</th>
                    <th>Email</th>
                    <th>Access Level</th>
                </tr>
            </thead>
            <tbody id="students-body">
                <!-- Data injected here -->
            </tbody>
        </table>
    </div>

    <!-- Authentication Gate (Simple) -->
    <script is:inline>
        // SUPABASE CONFIG (PUBLIC CLIENT)
        const SUPABASE_URL = 'https://vobbqsipyyftscyvxuja.supabase.co';
        const SUPABASE_KEY = 'eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InZvYmJxc2lweXlmdHNjeXZ4dWphIiwicm9sZSI6ImFub24iLCJpYXQiOjE3NzAxMjQyNDgsImV4cCI6MjA4NTcwMDI0OH0.aSxwAUb-qWZBVPQJ-s5FiGIKtu8dBlHGnuV5i0H2QHc';

        // FIX: Use a different name than the library itself
        const sbClient = supabase.createClient(SUPABASE_URL, SUPABASE_KEY);

        // Simple Passcode Gate to prevent random internet access
        // (Note: This is not bank-grade security, but sufficient for hiding a page)
        function checkAuth() {
            if (localStorage.getItem('mpdc_admin_auth') !== 'true') {
                const pass = prompt("Enter Admin Password:");
                if (pass === 'mpdc2026') { // Hardcoded convenient password
                    localStorage.setItem('mpdc_admin_auth', 'true');
                } else {
                    alert("Access Denied");
                    document.body.innerHTML = '<h1 style="text-align:center; margin-top:50px;">ACCESS DENIED</h1>';
                    return false;
                }
            }
            return true;
        }

        // FIREBASE CONFIG
        const firebaseConfig = {
            apiKey: "AIzaSyBSxrgaNnTzRMqo-9C47vZfnTTDRqyyb10",
            authDomain: "mpdc-website-32dae.firebaseapp.com",
            projectId: "mpdc-website-32dae",
            storageBucket: "mpdc-website-32dae.firebasestorage.app",
            messagingSenderId: "210457065303",
            appId: "1:210457065303:web:72882e734aa8054d283012"
        };
        firebase.initializeApp(firebaseConfig);
        const fb_db = firebase.firestore();

        async function fetchData() {
            if (!checkAuth()) return;

            // 1. Fetch Leads (Supabase)
            const { data: leads, error: leadError } = await sbClient
                .from('leads')
                .select('*')
                .order('created_at', { ascending: false })
                .limit(10);

            // 2. Fetch Students (Supabase)
            const { data: profiles, error: profileError } = await sbClient
                .from('profiles')
                .select('*')
                .order('created_at', { ascending: false })
                .limit(10);

            // 3. FETCH FIREBASE DATA (The "Plumbing" Source of Truth)
            let fbActivity = [];
            try {
                const fbProfiles = await fb_db.collection('profiles').orderBy('updatedAt', 'desc').limit(10).get();
                fbProfiles.forEach(doc => {
                    const d = doc.data();
                    fbActivity.push({ ...d, created_at: d.updatedAt ? d.updatedAt.toDate().toISOString() : new Date().toISOString(), type: 'student' });
                });
                const fbProspects = await fb_db.collection('prospects').orderBy('timestamp', 'desc').limit(10).get();
                fbProspects.forEach(doc => {
                    const d = doc.data();
                    fbActivity.push({ ...d, created_at: d.timestamp ? d.timestamp.toDate().toISOString() : new Date().toISOString(), type: 'lead' });
                });
            } catch (fbErr) { console.warn("FB Error:", fbErr); }

            // Merge and Unique
            let allLeads = fbActivity.filter(i => i.type === 'lead');
            if (leads) leads.forEach(l => { if (!allLeads.find(al => al.email === l.email)) allLeads.push(l); });
            
            let allStudents = fbActivity.filter(i => i.type === 'student');
            if (profiles) profiles.forEach(p => { if (!allStudents.find(as => as.email === p.email)) allStudents.push(p); });

            // Sort
            allLeads.sort((a,b) => new Date(b.created_at) - new Date(a.created_at));
            allStudents.sort((a,b) => new Date(b.created_at) - new Date(a.created_at));

            // Update Counts
            document.getElementById('count-leads').innerText = allLeads.length;
            document.getElementById('count-students').innerText = allStudents.length;
            document.getElementById('revenue-est').innerText = '$' + (allStudents.length * 97).toLocaleString();

            const finalLeads = allLeads.slice(0, 10);
            const finalStudents = allStudents.slice(0, 10);

            // Leads Table
            const leadsBody = document.getElementById('leads-body');
            leadsBody.innerHTML = '';
            if (finalLeads) {
                finalLeads.forEach(lead => {
                    const date = new Date(lead.created_at).toLocaleDateString();
                    const row = `
                        <tr>
                            <td>${date}</td>
                            <td style="font-weight:bold;">${lead.name || 'Unknown'}</td>
                            <td>${lead.email}</td>
                            <td><span class="status-badge badge-captured">Abandoned</span></td>
                        </tr>
                    `;
                    leadsBody.insertAdjacentHTML('beforeend', row);
                });
            }

            // Students Table
            const studentsBody = document.getElementById('students-body');
            studentsBody.innerHTML = '';
            if (finalStudents) {
                finalStudents.forEach(student => {
                    const date = new Date(student.created_at).toLocaleDateString();
                    const row = `
                        <tr>
                            <td>${date}</td>
                            <td style="font-weight:bold;">${student.name || 'Unknown'}</td>
                            <td>${student.email}</td>
                            <td><span class="status-badge badge-student">Active</span></td>
                        </tr>
                    `;
                    studentsBody.insertAdjacentHTML('beforeend', row);
                });
            }
        }

        // Initialize
        document.addEventListener('DOMContentLoaded', fetchData);

    </script>
</body>

</html>