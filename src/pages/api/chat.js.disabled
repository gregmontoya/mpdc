export const prerender = false;
import { VertexAI } from '@google-cloud/vertexai';

const project = 'mpdc-website-32dae';
const location = 'us-central1';

export const POST = async ({ request }) => {
    try {
        const rawText = await request.text();

        if (!rawText) {
            return new Response(JSON.stringify({ error: 'Empty request body' }), { status: 400 });
        }

        const body = JSON.parse(rawText);
        const { message, history } = body;

        if (!message) {
            return new Response(JSON.stringify({ error: 'Message is required' }), { status: 400 });
        }

        // Initialize inside the handler to catch auth errors gracefully
        const vertexAI = new VertexAI({ project: project, location: location });
        const generativeModel = vertexAI.getGenerativeModel({
            model: 'gemini-1.5-flash',
            systemInstruction: `You are the AI assistant for Men's Post-Divorce Coaching (MPDC)...` // Truncated for brevity, kept same as before
        });

        const chat = generativeModel.startChat({
            history: history || [],
        });

        const result = await chat.sendMessage(message);
        const responseText = result.response.candidates[0].content.parts[0].text;

        return new Response(JSON.stringify({ response: responseText }), {
            status: 200,
            headers: { 'Content-Type': 'application/json' }
        });

    } catch (error) {
        console.error('--- Chat API Error ---');
        console.error(error.message);

        // ALWAYS return a helpful mock in development if AI fails
        if (process.env.NODE_ENV !== 'production') {
            return new Response(JSON.stringify({
                response: "[DEV MOCK]: I'm active! On the live site, I'll use the Gemini AI brain. Locally, I'm here to test your UI and message flow. What's on your mind?"
            }), {
                status: 200,
                headers: { 'Content-Type': 'application/json' }
            });
        }

        return new Response(JSON.stringify({
            error: 'AI Service Error',
            details: error.message
        }), { status: 500 });
    }
}
