---
import Layout from '../layouts/Layout.astro';
import '../styles/blog-styles.css';

export function getStaticPaths() {
  return [
    { params: { slug: 'mindset' }, props: { name: 'Mindset & Mental Health', description: 'Rebuild your confidence and mental resilience with our expert articles on mindset and mental health after divorce.' } },
    { params: { slug: 'strategy' }, props: { name: 'Divorce Strategy', description: 'Navigate legal challenges and reduce conflict with these strategic frameworks.' } },
    { params: { slug: 'relationships' }, props: { name: 'Relationships & Dating', description: 'Actionable advice on maintaining healthy connections and re-entering the dating world.' } },
    { params: { slug: 'parenting' }, props: { name: 'Co-Parenting', description: 'Proven strategies for co-parenting with strength and clarity.' } },
    { params: { slug: 'finances' }, props: { name: 'Financial Recovery', description: 'Take charge of your finances and build long-term stability.' } },
  ];
}

const { slug } = Astro.params;
const { name, description } = Astro.props;

const allArticles = [
    {
        category: "strategy",
        categoryName: "Divorce Strategy",
        title: "How Divorce Changes a Man",
        url: "/learn/how-divorce-changes-a-man",
        description: "How divorce changes a man is not just emotional — it is neurological, behavioral, physical, and identity-shattering.",
        image: "/images/blog/featured-change.png",
        date: "Feb 2, 2026",
        featured: true
    },
    {
        category: "strategy",
        categoryName: "Divorce Strategy",
        title: "5 Proven Strategies to Rebuild Your Life After Divorce",
        url: "/learn/5-strategies-rebuild-life-divorce",
        description: "Stop the mental replay loop and start your comeback with these actionable steps.",
        image: "/images/blog/rebuild-life.png",
        date: "Feb 2, 2026"
    },
    {
        category: "mindset",
        categoryName: "Mindset & Mental Health",
        title: "How to Stop Overthinking After Divorce as a Man",
        url: "/learn/stop-overthinking-men",
        description: "Break the mental replay loop with these science-backed strategies that actually work.",
        image: "/images/blog/stop-overthinking.png",
        date: "Jan 28, 2026"
    },
    {
        category: "parenting",
        categoryName: "Co-Parenting",
        title: "The Complete Guide to Co-Parenting for Divorced Men",
        url: "/learn/co-parenting-guide-men",
        description: "Navigate co-parenting with confidence and clarity using this comprehensive framework.",
        image: "/images/blog/co-parenting.png",
        date: "Jan 25, 2026"
    },
    {
        category: "relationships",
        categoryName: "Relationships & Dating",
        title: "Building a New Social Circle After Divorce for Men",
        url: "/learn/new-social-circle-men",
        description: "Practical steps to rebuild your network and find your tribe in this new chapter.",
        image: "/images/blog/social-circle.png",
        date: "Jan 22, 2026"
    },
    {
        category: "mindset",
        categoryName: "Mindset & Mental Health",
        title: "Breaking Free from Victim Mentality for Divorced Men",
        url: "/learn/victim-mentality-men",
        description: "Essential steps to stabilize your finances and build a solid foundation post-divorce.",
        image: "/images/blog/victim-mentality.png",
        date: "Jan 20, 2026"
    },
    {
        category: "mindset",
        categoryName: "Mindset & Mental Health",
        title: "Managing Anger and Resentment for Divorced Men",
        url: "/learn/managing-anger-men",
        description: "Practical techniques to process difficult emotions and move forward.",
        image: "/images/blog/managing-anger.png",
        date: "Jan 18, 2026"
    },
    {
        category: "parenting",
        categoryName: "Co-Parenting",
        title: "Setting Boundaries with Your Ex-Wife",
        url: "/learn/boundaries-ex-wife",
        description: "How to establish and maintain healthy boundaries for successful co-parenting.",
        image: "/images/blog/setting-boundaries.png",
        date: "Jan 12, 2026"
    },
    {
        category: "relationships",
        categoryName: "Relationships & Dating",
        title: "When Should Men Start Dating After Divorce",
        url: "/learn/when-start-dating",
        description: "Signs you're ready to date again and how to approach it with confidence.",
        image: "/images/blog/start-dating.png",
        date: "Jan 10, 2026"
    }
];

const categoryArticles = allArticles.filter(article => article.category === slug);
---

<Layout title={`${name} | Men's Post-Divorce Coaching`}>
    <meta slot="head" content={description} name="description" />

    <!-- Blog Index Header -->
    <header class="blog-index-header">
        <div class="blog-index-header-content">
            <p class="category-label">Browsing Category</p>
            <h1>{name}</h1>
            <p class="blog-index-subtitle">{description}</p>
        </div>
    </header>

    <!-- Blog Index Container -->
    <div class="blog-index-container">
        <!-- Category Filter Sidebar -->
        <aside class="category-sidebar">
            <div class="category-sticky">
                <h3>Categories</h3>
                <ul class="category-list">
                    <li><a class="category-link" data-category="all" href="/learn">All Articles</a></li>
                    <li><a class:list={["category-link", { active: slug === 'mindset' }]} data-category="mindset" href="/category-mindset">Mindset & Mental Health</a></li>
                    <li><a class:list={["category-link", { active: slug === 'strategy' }]} data-category="strategy" href="/category-strategy">Divorce Strategy</a></li>
                    <li><a class:list={["category-link", { active: slug === 'relationships' }]} data-category="relationships" href="/category-relationships">Relationships & Dating</a></li>
                    <li><a class:list={["category-link", { active: slug === 'parenting' }]} data-category="parenting" href="/category-parenting">Co-Parenting</a></li>
                    <li><a class:list={["category-link", { active: slug === 'finances' }]} data-category="finances" href="/category-finances">Financial Recovery</a></li>
                </ul>
            </div>
        </aside>

        <!-- Blog Roll Grid -->
        <main class="blog-roll-main">
            {categoryArticles.length > 0 ? (
                <div class="blog-grid">
                    {categoryArticles.map(article => (
                        <article class="blog-card" data-category={article.category}>
                            <div class="blog-card-image">
                                <img alt={article.title} src={article.image} />
                            </div>
                            <div class="blog-card-content">
                                <a class="article-category" data-category={article.category} href={`/category-${article.category}`}>{article.categoryName}</a>
                                <h3><a href={article.url}>{article.title}</a></h3>
                                <p>{article.description}</p>
                                <div class="article-meta-small">
                                    <span class="author-small">By Alex Morgan</span>
                                    <span class="date-small">{article.date}</span>
                                </div>
                            </div>
                        </article>
                    ))}
                </div>
            ) : (
                <div class="no-articles">
                    <p>Coming soon. We are currently preparing expert articles for this category.</p>
                    <a href="/learn" class="mpdc-btn">Back to All Articles</a>
                </div>
            )}
        </main>
    </div>
</Layout>

<style>
    .category-label {
        font-size: 0.85rem;
        text-transform: uppercase;
        letter-spacing: 2px;
        color: var(--color-accent);
        margin-bottom: 0.5rem;
    }
    .no-articles {
        text-align: center;
        padding: 4rem 2rem;
        background: rgba(255,255,255,0.05);
        border: 1px dashed rgba(255,255,255,0.1);
        border-radius: 12px;
    }
    .no-articles p {
        font-size: 1.25rem;
        margin-bottom: 2rem;
        color: var(--color-text-muted);
    }
</style>
