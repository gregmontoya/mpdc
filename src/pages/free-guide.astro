---
import Layout from '../layouts/Layout.astro';
export const prerender = true;
---

<Layout title="Free Recovery Bundle | Men's Post-Divorce Coaching" simpleHeader={true} simpleFooter={true}>
    <section class="ad-landing">
        <!-- 🚀 Hero Content -->
        <div class="hero-container">
            <h1 class="main-headline">
                YOUR MARRIAGE ENDED.<br />
                YOUR NEW LIFE IS JUST STARTING.
            </h1>
            
            <div class="divider"></div>

            <div class="copy-stack">
                <h2 class="sub-headline">THE PROBLEM: YOU ARE STUCK ON REPLAY</h2>
                <p>Most men try to “think” their way out of post-divorce anxiety. It doesn’t work because the problem isn’t logical, it’s biological.</p>
                <p>Your brain is stuck in a fight-or-flight loop.</p>
                
                <h2 class="sub-headline mt-4">THE SOLUTION: A SYSTEM TO RESTART</h2>
                <p>The Restart Roadmap is not therapy. It is a tactical system:</p>
                <p class="download-text">Download for <strong>FREE</strong> below:</p>
            </div>

            <!-- 🧲 Optin Card -->
            <div id="optin" class="optin-card">
                <form id="landing-form">
                    <div class="form-group">
                        <input type="text" id="name" name="name" placeholder="First Name" required />
                    </div>
                    <div class="form-group">
                        <input type="email" id="email" name="email" placeholder="Email" required />
                    </div>
                    <button type="submit" id="submit-btn" class="submit-btn">
                        GET THE RESTART ROADMAP (FREE)
                    </button>
                </form>
                <div id="success-msg" class="hidden">
                    <p>✅ Success! Check your inbox for the Roadmap.</p>
                </div>
            </div>
        </div>

        <!-- 🏛️ Custom Slim Footer -->
        <footer class="slim-footer">
            <div class="footer-top">
                <p>MensPostDivorceCoaching.com — 2025 All Right Reserved</p>
                <div class="secondary-links">
                    <a href="/careers">CAREERS</a>
                    <a href="/privacy">PRIVACY POLICY</a>
                    <a href="/sitemap">SITEMAP</a>
                    <a href="/terms">TERMS</a>
                </div>
            </div>
            <div class="footer-bottom">
                <a href="/cookies">Cookies Policy</a> - <a href="/terms">Terms and Conditions</a> - <a href="/privacy">Privacy Policy</a>
            </div>
        </footer>
    </section>
</Layout>

<style>
    .ad-landing {
        background-color: #2D6A5D; 
        min-height: 100vh;
        color: white;
        font-family: 'Montserrat', sans-serif;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center; /* Center vertically for 'Simple Simple' feel */
        padding: 40px 0;
    }

    /* 🚀 HERO Content */
    .hero-container {
        max-width: 900px;
        margin: 0 auto;
        text-align: center;
        padding: 0 20px;
    }
    .main-headline {
        font-size: 3.8rem;
        font-weight: 900;
        line-height: 1;
        margin-bottom: 30px;
        letter-spacing: -2px;
        text-transform: uppercase;
    }
    .divider {
        width: 60px;
        height: 3px;
        background: #F1883C; /* Switch to orange accent for the divider */
        margin: 0 auto 40px;
    }

    .copy-stack {
        margin-bottom: 40px;
    }
    .sub-headline {
        font-size: 20px;
        font-weight: 800;
        margin-bottom: 15px;
        letter-spacing: 1.5px;
        color: rgba(255,255,255,1);
    }
    .copy-stack p {
        font-size: 17px;
        line-height: 1.6;
        opacity: 0.85;
        margin-bottom: 15px;
        max-width: 640px;
        margin-left: auto;
        margin-right: auto;
    }
    .download-text {
        font-size: 18px;
        margin-top: 20px;
        letter-spacing: 0.5px;
    }
    .mt-4 { margin-top: 40px; }

    /* 🧲 OPTIN CARD */
    .optin-card {
        background: white;
        padding: 40px;
        border-radius: 8px;
        max-width: 500px;
        margin: 0 auto;
        box-shadow: 0 20px 40px rgba(0,0,0,0.2);
    }
    .form-group { margin-bottom: 15px; }
    .form-group input {
        width: 100%;
        padding: 15px;
        border: 1px solid #ddd;
        border-radius: 4px;
        font-family: inherit;
        font-size: 16px;
    }
    .submit-btn {
        width: 100%;
        background-color: #F1883C; /* Match image slightly brighter orange */
        color: white;
        border: none;
        padding: 18px;
        border-radius: 4px;
        font-weight: 800;
        cursor: pointer;
        font-size: 15px;
        transition: transform 0.2s ease;
    }
    .submit-btn:hover { background-color: #d16b25; transform: scale(1.02); }

    /* 🏛️ FOOTER */
    .slim-footer {
        width: 100%;
        background: #1A3D36;
        padding: 40px 20px;
        margin-top: auto;
        font-size: 12px;
        text-align: center;
    }
    .footer-top {
        max-width: 1100px;
        margin: 0 auto 20px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 20px;
    }
    .secondary-links { display: flex; gap: 20px; }
    .secondary-links a, .footer-bottom a { color: white; text-decoration: none; opacity: 0.7; }
    .footer-bottom { border-top: 1px solid rgba(255,255,255,0.1); padding-top: 20px; opacity: 0.6; }

    .hidden { display: none; }
    #success-msg { color: #2D6A5D; font-weight: 700; text-align: center; font-size: 18px; }

    /* MOBILE REDUCTION */
    @media (max-width: 768px) {
        .main-headline { font-size: 2.2rem; }
        .nav-links { display: none; }
        .footer-top { flex-direction: column; }
    }
</style>

<script is:inline>
  const form = document.getElementById('landing-form');
  const submitBtn = document.getElementById('submit-btn');
  const successMsg = document.getElementById('success-msg');

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const name = document.getElementById('name').value;
    const email = document.getElementById('email').value;

    submitBtn.innerText = "SENDING...";
    submitBtn.disabled = true;

    try {
      // 🕵️ Capture attribution from storage
      const attribution = window.getAttributionData ? window.getAttributionData() : {};
      const guestId = localStorage.getItem('mpdc_guest_id');

      const response = await fetch('https://mpdc-webhook-server.vercel.app/capture-lead', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ 
            name, 
            email, 
            guestId, 
            attribution, 
            source: 'ad_landing_page_guide' 
        })
      });

      if (response.ok) {
        form.classList.add('hidden');
        successMsg.classList.remove('hidden');
        // 🔵 Record pixel lead event locally too
        if (typeof fbq !== 'undefined') {
            fbq('track', 'Lead');
        }
      }
    } catch (err) {
      submitBtn.innerText = "ERROR - TRY AGAIN";
      submitBtn.disabled = false;
    }
  });
</script>
