---
import Layout from '../layouts/Layout.astro';
export const prerender = true;
---

<Layout title="Free Recovery Bundle | Men's Post-Divorce Coaching" simpleHeader={true}>
    <section class="ad-landing">
        <!-- 🚀 Hero Content (Aligned Copy) -->
        <div class="hero-container">
            <h1 class="main-headline">
                YOUR MARRIAGE ENDED.<br />
                YOUR NEW LIFE IS JUST STARTING.
            </h1>
            
            <div class="divider"></div>

            <div class="copy-stack">
                <p>Don't let the past own your future. Use the <strong>Worksheet to Resolve Your Past</strong> and our <strong>Free Limiting Beliefs Hypnosis</strong> to stop reacting and start leading.</p>
                <p class="download-text">Download the <strong>Recovery Bundle</strong> for FREE below:</p>
            </div>

            <!-- 🧲 Optin Card -->
            <div id="optin" class="optin-card">
                <form id="landing-form">
                    <div class="form-group">
                        <input type="text" id="name" name="name" placeholder="First Name" required />
                    </div>
                    <div class="form-group">
                        <input type="email" id="email" name="email" placeholder="Email" required />
                    </div>
                    <button type="submit" id="submit-btn" class="submit-btn">
                        ACCESS FREE RECOVERY TOOLS →
                    </button>
                </form>
                <div id="success-msg" class="hidden">
                    <p>✅ Access Granted. Check your email for the bundle.</p>
                </div>
            </div>
        </div>
    </section>
</Layout>

<style>
    .ad-landing {
        background-color: #2D6A5D; 
        min-height: 60vh;
        color: white;
        font-family: 'Montserrat', sans-serif;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        padding: 100px 20px;
    }

    /* 🚀 HERO Content */
    .hero-container {
        max-width: 800px;
        text-align: center;
    }
    .main-headline {
        font-size: 4.5rem; 
        font-weight: 900;
        line-height: 1;
        margin-bottom: 25px;
        letter-spacing: -3px;
        text-transform: uppercase;
    }
    .divider {
        width: 60px;
        height: 6px;
        background: #F1883C; 
        margin: 0 auto 35px;
    }

    .copy-stack {
        margin-bottom: 40px;
    }
    .copy-stack p {
        font-size: 20px;
        line-height: 1.5;
        opacity: 0.95;
        margin-bottom: 20px;
        max-width: 680px;
        margin-left: auto;
        margin-right: auto;
        font-weight: 500;
    }
    .download-text {
        font-size: 20px;
        margin-top: 30px;
        color: #F1883C;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 1px;
    }

    /* 🧲 OPTIN CARD */
    .optin-card {
        background: white;
        padding: 40px;
        border-radius: 8px;
        max-width: 500px;
        margin: 0 auto;
        box-shadow: 0 20px 40px rgba(0,0,0,0.2);
    }
    .form-group { margin-bottom: 15px; }
    .form-group input {
        width: 100%;
        padding: 15px;
        border: 1px solid #ddd;
        border-radius: 4px;
        font-family: inherit;
        font-size: 16px;
        color: #333;
    }
    .submit-btn {
        width: 100%;
        background-color: #F1883C; 
        color: white;
        border: none;
        padding: 18px;
        border-radius: 4px;
        font-weight: 800;
        cursor: pointer;
        font-size: 15px;
        transition: transform 0.2s ease;
    }
    .submit-btn:hover { background-color: #d16b25; transform: scale(1.02); }

    .hidden { display: none; }
    #success-msg { color: #2D6A5D; font-weight: 700; text-align: center; font-size: 18px; }

    /* MOBILE REDUCTION */
    @media (max-width: 768px) {
        .main-headline { font-size: 2.2rem; }
        .nav-links { display: none; }
        .footer-top { flex-direction: column; }
    }
</style>

<script is:inline>
  const form = document.getElementById('landing-form');
  const submitBtn = document.getElementById('submit-btn');
  const successMsg = document.getElementById('success-msg');

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const name = document.getElementById('name').value;
    const email = document.getElementById('email').value;

    submitBtn.innerText = "SENDING...";
    submitBtn.disabled = true;

    try {
      // 🕵️ Capture attribution from storage
      const attribution = window.getAttributionData ? window.getAttributionData() : {};
      const guestId = localStorage.getItem('mpdc_guest_id');

      const response = await fetch('https://webhook-server-xi-nine.vercel.app/capture-lead', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ 
            name, 
            email, 
            guestId, 
            attribution, 
            source: 'ad_landing_page_guide' 
        })
      });

      if (response.ok) {
        form.classList.add('hidden');
        successMsg.innerHTML = `
          <div class="text-center py-10">
            <h3 class="text-3xl font-bold text-white mb-4">THANK YOU!</h3>
            <p class="text-xl text-slate-300">Access Granted. Check your email for the bundle.</p>
            <p class="text-sm text-slate-400 mt-6">Redirecting you to the Next Step...</p>
          </div>
        `;
        successMsg.classList.remove('hidden');
        
        // 🔵 Record pixel lead event locally too
        if (typeof fbq !== 'undefined') {
            fbq('track', 'Lead');
        }

        // 🚀 Redirect to Join Page after 2.5 seconds
        setTimeout(() => {
            window.location.href = '/join';
        }, 2500);
      }
    } catch (err) {
      submitBtn.innerText = "ERROR - TRY AGAIN";
      submitBtn.disabled = false;
    }
  });
</script>
