<style>
    .legal-page {
        padding: 8rem 0;
        background-color: #fff;
        color: #1a1a1a;
        min-height: 100vh;
    }

    .container-narrow {
        max-width: 800px;
        margin: 0 auto;
        padding: 0 2rem;
    }

    .legal-header {
        text-align: center;
        margin-bottom: 5rem;
    }

    .legal-breadcrumb {
        color: var(--color-accent);
        font-weight: 700;
        letter-spacing: 2px;
        text-transform: uppercase;
        font-size: 0.8rem;
        margin-bottom: 1rem;
    }

    h1 {
        font-size: 3.5rem;
        color: var(--color-bg-primary);
        margin-bottom: 1rem;
    }

    .last-updated {
        color: #888;
        font-size: 0.9rem;
    }

    .legal-content h2 {
        color: var(--color-bg-primary);
        font-size: 1.5rem;
        margin-top: 3rem;
        margin-bottom: 1.5rem;
        text-transform: none;
        letter-spacing: 0;
    }

    .legal-content p {
        font-size: 1.1rem;
        line-height: 1.8;
        color: #444;
        margin-bottom: 1.5rem;
    }

    .legal-content ul {
        margin-bottom: 2rem;
        padding-left: 1.5rem;
    }

    .legal-content li {
        margin-bottom: 0.75rem;
        line-height: 1.6;
        color: #444;
    }
</style>
