---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Components & Blocks | MPDC">
    <!-- HERO SECTION -->
    <header id="hero" class="section hero-section"
        style="min-height: 100vh; padding-top: 10rem; padding-bottom: 10rem; position: relative;">
        <div style="max-width: 1100px; margin: 0 auto; padding: 0 2rem; text-align: center;">
            <p
                style="font-size: 1rem; margin-bottom: 2rem; letter-spacing: 3px; text-transform: uppercase; color: var(--color-text-muted);">
                The #1 Resource for Men Reclaiming Their Edge</p>
            <h1 style="font-size: 4rem; line-height: 1.15; margin-bottom: 2.5rem; color: #fff;">
                Your Marriage Ended.<br>
                <span
                    style="color: var(--color-text-muted); border-bottom: 4px solid var(--color-accent); padding-bottom: 0.25rem;">Your
                    Comeback Starts Now.</span>
            </h1>
            <p style="font-size: 1.25rem; line-height: 1.6; margin-bottom: 1rem; color: var(--color-text-muted);">Stop
                the "replay" loop. The problem isn't logical—it's biological.</p>
            <p style="font-size: 1.25rem; line-height: 1.6; margin-bottom: 2.5rem; color: #fff; font-weight: 600;">Get
                the 5-step system to break the cycle and start your comeback.</p>
            <a href="#" class="mpdc-btn mpdc-btn-lg">Explore The System →</a>
            <p
                style="font-size: 0.85rem; margin-top: 1.5rem; letter-spacing: 1px; text-transform: uppercase; color: var(--color-text-muted);">
                Free Instant Access • 100% Private</p>
        </div>
    </header>

    <!-- DEMO SECTION 1: Tan/Beige Background -->
    <section class="section" style="background-color: var(--color-text-muted); padding: 6rem 2rem;">
        <div style="max-width: 1100px; margin: 0 auto; text-align: center;">
            <p
                style="font-size: 1rem; margin-bottom: 1.5rem; letter-spacing: 3px; text-transform: uppercase; color: var(--color-accent);">
                Demo Section</p>
            <h2 style="font-size: 3rem; line-height: 1.2; margin-bottom: 1.5rem; color: var(--color-bg-primary);">
                Tan Background Block
            </h2>
            <p
                style="font-size: 1.25rem; line-height: 1.7; margin-bottom: 2rem; color: var(--color-text-dark); max-width: 800px; margin-left: auto; margin-right: auto;">
                This is a demo content block with a tan/beige background. Great for testimonials, featured content, or
                breaking up the page visually.
            </p>
            <a href="#" class="mpdc-btn">Learn More →</a>
        </div>
    </section>

    <!-- DEMO SECTION 2: White Background -->
    <section class="section" style="background-color: var(--color-text-light); padding: 6rem 2rem;">
        <div style="max-width: 1100px; margin: 0 auto; text-align: center;">
            <p
                style="font-size: 1rem; margin-bottom: 1.5rem; letter-spacing: 3px; text-transform: uppercase; color: var(--color-accent);">
                Demo Section</p>
            <h2 style="font-size: 3rem; line-height: 1.2; margin-bottom: 1.5rem; color: var(--color-bg-primary);">
                White Background Block
            </h2>
            <p
                style="font-size: 1.25rem; line-height: 1.7; margin-bottom: 2rem; color: var(--color-text-dark); max-width: 800px; margin-left: auto; margin-right: auto;">
                This is a demo content block with a clean white background. Perfect for detailed content, feature lists,
                or about sections.
            </p>
            <a href="#" class="mpdc-btn">Discover More →</a>
        </div>
    </section>

    <!-- DEMO SECTION 3: Green Background -->
    <section class="section" style="background-color: var(--color-bg-primary); padding: 6rem 2rem;">
        <div style="max-width: 1100px; margin: 0 auto; text-align: center;">
            <p
                style="font-size: 1rem; margin-bottom: 1.5rem; letter-spacing: 3px; text-transform: uppercase; color: var(--color-text-muted);">
                Demo Section</p>
            <h2 style="font-size: 3rem; line-height: 1.2; margin-bottom: 1.5rem; color: var(--color-text-light);">
                Green Background Block
            </h2>
            <p
                style="font-size: 1.25rem; line-height: 1.7; margin-bottom: 2rem; color: var(--color-text-muted); max-width: 800px; margin-left: auto; margin-right: auto;">
                This is a demo content block with the signature dark green background. Ideal for CTAs, important
                announcements, or highlighting key messages.
            </p>
            <a href="#" class="mpdc-btn">Get Started →</a>
        </div>
    </section>

    <!-- DEMO SECTION 4: Copper/Accent Background -->
    <section class="section" style="background-color: var(--color-accent); padding: 6rem 2rem;">
        <div style="max-width: 1100px; margin: 0 auto; text-align: center;">
            <p
                style="font-size: 1rem; margin-bottom: 1.5rem; letter-spacing: 3px; text-transform: uppercase; color: var(--color-text-light);">
                Demo Section</p>
            <h2 style="font-size: 3rem; line-height: 1.2; margin-bottom: 1.5rem; color: var(--color-text-light);">
                Copper Background Block
            </h2>
            <p
                style="font-size: 1.25rem; line-height: 1.7; margin-bottom: 2rem; color: var(--color-text-light); max-width: 800px; margin-left: auto; margin-right: auto;">
                This is a demo content block with the copper/accent background. Use sparingly for high-impact CTAs or
                special offers.
            </p>
            <a href="#"
                style="background-color: var(--color-bg-primary); color: var(--color-text-light); padding: 1rem 2.5rem; border-radius: 6px; font-weight: 700; text-decoration: none; display: inline-block;">Take
                Action →</a>
        </div>
    </section>

    <!-- SPLIT BLOCK 1: Text Left, Image Right - White Background -->
    <section class="section" style="background-color: var(--color-text-light); padding: 6rem 2rem;">
        <div
            style="max-width: 1100px; margin: 0 auto; display: grid; grid-template-columns: 1fr 1fr; gap: 4rem; align-items: center;">
            <div>
                <p
                    style="font-size: 1rem; margin-bottom: 1rem; letter-spacing: 3px; text-transform: uppercase; color: var(--color-accent);">
                    About Us</p>
                <h2 style="font-size: 2.5rem; line-height: 1.2; margin-bottom: 1.5rem; color: var(--color-bg-primary);">
                    Text Left, Image Right
                </h2>
                <p style="font-size: 1.1rem; line-height: 1.7; margin-bottom: 1.5rem; color: var(--color-text-dark);">
                    This is a traditional split layout with text on the left and an image on the right. Perfect for
                    about sections, feature highlights, or storytelling.
                </p>
                <p style="font-size: 1.1rem; line-height: 1.7; margin-bottom: 2rem; color: var(--color-text-dark);">
                    Use this layout to balance visual content with detailed explanations.
                </p>
                <a href="#" class="mpdc-btn">Learn More →</a>
            </div>
            <div
                style="background-color: var(--color-text-muted); height: 400px; border-radius: 12px; display: flex; align-items: center; justify-content: center; color: var(--color-bg-primary); font-weight: 600;">
                [ Image Placeholder ]
            </div>
        </div>
    </section>

    <!-- SPLIT BLOCK 2: Image Left, Text Right - Tan Background -->
    <section class="section" style="background-color: var(--color-text-muted); padding: 6rem 2rem;">
        <div
            style="max-width: 1100px; margin: 0 auto; display: grid; grid-template-columns: 1fr 1fr; gap: 4rem; align-items: center;">
            <div
                style="background-color: var(--color-bg-primary); height: 400px; border-radius: 12px; display: flex; align-items: center; justify-content: center; color: var(--color-text-light); font-weight: 600;">
                [ Image Placeholder ]
            </div>
            <div>
                <p
                    style="font-size: 1rem; margin-bottom: 1rem; letter-spacing: 3px; text-transform: uppercase; color: var(--color-accent);">
                    Our Method</p>
                <h2 style="font-size: 2.5rem; line-height: 1.2; margin-bottom: 1.5rem; color: var(--color-bg-primary);">
                    Image Left, Text Right
                </h2>
                <p style="font-size: 1.1rem; line-height: 1.7; margin-bottom: 1.5rem; color: var(--color-text-dark);">
                    Alternate the layout to keep the page visually interesting. This version has the image on the left
                    with text on the right.
                </p>
                <p style="font-size: 1.1rem; line-height: 1.7; margin-bottom: 2rem; color: var(--color-text-dark);">
                    Great for step-by-step explanations or showcasing different features.
                </p>
                <a href="#" class="mpdc-btn">Discover More →</a>
            </div>
        </div>
    </section>

    <!-- SPLIT BLOCK 3: Text Left, Image Right - Green Background -->
    <section class="section" style="background-color: var(--color-bg-primary); padding: 6rem 2rem;">
        <div
            style="max-width: 1100px; margin: 0 auto; display: grid; grid-template-columns: 1fr 1fr; gap: 4rem; align-items: center;">
            <div>
                <p
                    style="font-size: 1rem; margin-bottom: 1rem; letter-spacing: 3px; text-transform: uppercase; color: var(--color-text-muted);">
                    Why Choose Us</p>
                <h2 style="font-size: 2.5rem; line-height: 1.2; margin-bottom: 1.5rem; color: var(--color-text-light);">
                    Split on Dark Background
                </h2>
                <p style="font-size: 1.1rem; line-height: 1.7; margin-bottom: 1.5rem; color: var(--color-text-muted);">
                    The split layout also works great on the dark green background. Use lighter text colors for
                    readability.
                </p>
                <p style="font-size: 1.1rem; line-height: 1.7; margin-bottom: 2rem; color: var(--color-text-muted);">
                    This creates a bold, premium feel for important sections.
                </p>
                <a href="#" class="mpdc-btn">Get Started →</a>
            </div>
            <div
                style="background-color: var(--color-text-muted); height: 400px; border-radius: 12px; display: flex; align-items: center; justify-content: center; color: var(--color-bg-primary); font-weight: 600;">
                [ Image Placeholder ]
            </div>
        </div>
    </section>

    <!-- 3-COLUMN GRID: Features/Cards -->
    <section class="section" style="background-color: var(--color-text-light); padding: 6rem 2rem;">
        <div style="max-width: 1100px; margin: 0 auto; text-align: center;">
            <p
                style="font-size: 1rem; margin-bottom: 1rem; letter-spacing: 3px; text-transform: uppercase; color: var(--color-accent);">
                Features</p>
            <h2 style="font-size: 3rem; line-height: 1.2; margin-bottom: 3rem; color: var(--color-bg-primary);">
                Three Column Grid
            </h2>
            <div style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 2rem;">
                <!-- Card 1 -->
                <div
                    style="background-color: var(--color-text-muted); padding: 2.5rem; border-radius: 12px; text-align: left;">
                    <div
                        style="width: 60px; height: 60px; background-color: var(--color-accent); border-radius: 8px; margin-bottom: 1.5rem; display: flex; align-items: center; justify-content: center; color: var(--color-text-light); font-weight: 700;">
                        01</div>
                    <h3 style="font-size: 1.5rem; margin-bottom: 1rem; color: var(--color-bg-primary);">Feature One</h3>
                    <p style="font-size: 1rem; line-height: 1.6; color: var(--color-text-dark);">Description of the
                        first feature. Keep it concise and focused on benefits.</p>
                </div>
                <!-- Card 2 -->
                <div
                    style="background-color: var(--color-text-muted); padding: 2.5rem; border-radius: 12px; text-align: left;">
                    <div
                        style="width: 60px; height: 60px; background-color: var(--color-accent); border-radius: 8px; margin-bottom: 1.5rem; display: flex; align-items: center; justify-content: center; color: var(--color-text-light); font-weight: 700;">
                        02</div>
                    <h3 style="font-size: 1.5rem; margin-bottom: 1rem; color: var(--color-bg-primary);">Feature Two</h3>
                    <p style="font-size: 1rem; line-height: 1.6; color: var(--color-text-dark);">Description of the
                        second feature. Highlight what makes it valuable.</p>
                </div>
                <!-- Card 3 -->
                <div
                    style="background-color: var(--color-text-muted); padding: 2.5rem; border-radius: 12px; text-align: left;">
                    <div
                        style="width: 60px; height: 60px; background-color: var(--color-accent); border-radius: 8px; margin-bottom: 1.5rem; display: flex; align-items: center; justify-content: center; color: var(--color-text-light); font-weight: 700;">
                        03</div>
                    <h3 style="font-size: 1.5rem; margin-bottom: 1rem; color: var(--color-bg-primary);">Feature Three
                    </h3>
                    <p style="font-size: 1rem; line-height: 1.6; color: var(--color-text-dark);">Description of the
                        third feature. End with a strong value proposition.</p>
                </div>
            </div>
        </div>
    </section>

    <!-- TESTIMONIALS GRID -->
    <section class="section" style="background-color: var(--color-bg-primary); padding: 6rem 2rem;">
        <div style="max-width: 1100px; margin: 0 auto; text-align: center;">
            <p
                style="font-size: 1rem; margin-bottom: 1rem; letter-spacing: 3px; text-transform: uppercase; color: var(--color-text-muted);">
                Testimonials</p>
            <h2 style="font-size: 3rem; line-height: 1.2; margin-bottom: 3rem; color: var(--color-text-light);">
                What Our Clients Say
            </h2>
            <div style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 2rem;">
                <!-- Testimonial 1 -->
                <div
                    style="background-color: var(--color-bg-dark); padding: 2.5rem; border-radius: 12px; text-align: left; border-left: 4px solid var(--color-accent);">
                    <p
                        style="font-size: 1.1rem; line-height: 1.7; color: var(--color-text-light); margin-bottom: 1.5rem; font-style: italic;">
                        "This is a testimonial quote. Keep it authentic and impactful."</p>
                    <p
                        style="font-size: 1rem; font-weight: 700; color: var(--color-text-light); margin-bottom: 0.25rem;">
                        — Client Name</p>
                    <p style="font-size: 0.9rem; color: var(--color-text-muted);">Title or Description</p>
                </div>
                <!-- Testimonial 2 -->
                <div
                    style="background-color: var(--color-bg-dark); padding: 2.5rem; border-radius: 12px; text-align: left; border-left: 4px solid var(--color-accent);">
                    <p
                        style="font-size: 1.1rem; line-height: 1.7; color: var(--color-text-light); margin-bottom: 1.5rem; font-style: italic;">
                        "Another testimonial that highlights transformation and results."</p>
                    <p
                        style="font-size: 1rem; font-weight: 700; color: var(--color-text-light); margin-bottom: 0.25rem;">
                        — Client Name</p>
                    <p style="font-size: 0.9rem; color: var(--color-text-muted);">Title or Description</p>
                </div>
                <!-- Testimonial 3 -->
                <div
                    style="background-color: var(--color-bg-dark); padding: 2.5rem; border-radius: 12px; text-align: left; border-left: 4px solid var(--color-accent);">
                    <p
                        style="font-size: 1.1rem; line-height: 1.7; color: var(--color-text-light); margin-bottom: 1.5rem; font-style: italic;">
                        "A third testimonial to build trust and credibility."</p>
                    <p
                        style="font-size: 1rem; font-weight: 700; color: var(--color-text-light); margin-bottom: 0.25rem;">
                        — Client Name</p>
                    <p style="font-size: 0.9rem; color: var(--color-text-muted);">Title or Description</p>
                </div>
            </div>
        </div>
    </section>

    <!-- CTA BANNER -->
    <section class="section" style="background-color: var(--color-accent); padding: 5rem 2rem;">
        <div style="max-width: 900px; margin: 0 auto; text-align: center;">
            <h2 style="font-size: 2.5rem; line-height: 1.2; margin-bottom: 1.5rem; color: var(--color-text-light);">
                Ready to Get Started?
            </h2>
            <p style="font-size: 1.25rem; line-height: 1.6; margin-bottom: 2rem; color: var(--color-text-light);">
                Join hundreds of men who've already transformed their lives.
            </p>
            <a href="#"
                style="background-color: var(--color-bg-primary); color: var(--color-text-light); padding: 1rem 2.5rem; border-radius: 6px; font-weight: 700; text-decoration: none; display: inline-block; font-size: 1.1rem;">Start
                Your Journey →</a>
        </div>
    </section>
</Layout>
