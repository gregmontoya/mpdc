---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Contact Us | DivorcedMen.com">
    <!-- HERO SECTION -->
    <!-- HERO SECTION -->
    <header id="hero" class="section hero-section"
        style="background-color: var(--color-bg-primary); padding: 4rem 2rem 3rem; text-align: center; margin-bottom: 3rem; background-image: linear-gradient(rgba(255, 255, 255, 0.02) 1px, transparent 1px), linear-gradient(90deg, rgba(255, 255, 255, 0.02) 1px, transparent 1px); background-size: 40px 40px;">
        <div style="max-width: 1000px; margin: 0 auto;">
            <h1 style="font-family: var(--font-heading); font-size: 3rem; line-height: 1.2; color: #fff; margin-bottom: 1rem; font-weight: 800;">
                Contact Us
            </h1>
            <p style="font-size: 1.25rem; color: var(--color-text-muted); max-width: 700px; margin: 0 auto;">
                Get in touch with the team.
            </p>
        </div>
    </header>

    <!-- CONTACT FORM SECTION (White Background) -->
    <section class="content-block" style="background-color: var(--color-text-light); padding: 4rem 2rem;">
        <style>
            @media (max-width: 768px) {
                .content-block {
                    padding: 3rem 1.5rem !important;
                }

                .contact-grid {
                    grid-template-columns: 1fr !important;
                    gap: 3rem !important;
                }
            }
        </style>
        <div class="contact-grid"
            style="max-width: 1100px; margin: 0 auto; display: grid; grid-template-columns: 1fr 1fr; gap: 4rem;">

            <!-- Contact Info / Text -->
            <div>
                <h2 style="font-size: 2.5rem; margin-bottom: 1.5rem; color: var(--color-bg-primary);">We're Here to Help
                </h2>
                <p style="font-size: 1.15rem; line-height: 1.7; margin-bottom: 2rem; color: var(--color-text-dark);">
                    Whether you have questions about the program, need technical support, or just want to see if MPDC is
                    right for you, we're ready to listen.
                </p>

                <div style="margin-bottom: 2rem;">
                    <h3 style="font-size: 1.25rem; color: var(--color-accent); margin-bottom: 0.5rem;">Email Us</h3>
                    <p style="color: var(--color-text-dark); font-size: 1.1rem;">hello@menspostdivorcecoaching.com</p>
                </div>

                <div>
                    <h3 style="font-size: 1.25rem; color: var(--color-accent); margin-bottom: 0.5rem;">HQ Address</h3>
                    <p style="color: var(--color-text-dark); font-size: 1.1rem; line-height: 1.6;">
                        Athens NLP Studies, LLC<br>
                        1309 Coffeen Ave Ste 1200<br>
                        Sheridan, WY 82801, US
                    </p>
                </div>
            </div>

            <!-- Contact Form -->
            <div style="background-color: #f9f9f9; padding: 2.5rem; border-radius: 12px; border: 1px solid #eee;">
                <form action="https://formsubmit.co/hello@menspostdivorcecoaching.com" method="POST">
                    <!-- Spam Protection -->
                    <input type="hidden" name="_captcha" value="false">
                    <input type="hidden" name="_next" value="http://menspostdivorcecoaching.com/success">

                    <div class="form-group" style="margin-bottom: 1.5rem;">
                        <label
                            style="display: block; margin-bottom: 0.5rem; color: var(--color-bg-primary); font-weight: 600;">Name</label>
                        <input type="text" name="name" class="form-input" placeholder="Your Name" required
                            style="width: 100%; padding: 1rem; border: 1px solid #ccc; border-radius: 6px; font-size: 1rem;">
                    </div>

                    <div class="form-group" style="margin-bottom: 1.5rem;">
                        <label
                            style="display: block; margin-bottom: 0.5rem; color: var(--color-bg-primary); font-weight: 600;">Email
                            Address</label>
                        <input type="email" name="email" class="form-input" placeholder="helpme@helpme.com" required
                            style="width: 100%; padding: 1rem; border: 1px solid #ccc; border-radius: 6px; font-size: 1rem;">
                    </div>

                    <div class="form-group" style="margin-bottom: 1.5rem;">
                        <label
                            style="display: block; margin-bottom: 0.5rem; color: var(--color-bg-primary); font-weight: 600;">Message</label>
                        <textarea name="message" class="form-input" rows="5" placeholder="How can we help?" required
                            style="width: 100%; padding: 1rem; border: 1px solid #ccc; border-radius: 6px; font-size: 1rem; font-family: inherit;"></textarea>
                    </div>

                    <button type="submit" class="mpdc-btn" style="width: 100%; border: none; cursor: pointer;">Send
                        Message</button>
                </form>
            </div>

        </div>
    </section>
</Layout>
