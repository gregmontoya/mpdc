---
const { hideNav = false } = Astro.props;
---
<style>
    /* Promo Banner Styles */
    #launch-banner {
        background: #1A2329;
        color: #fff;
        padding: 0.75rem 0;
        position: relative;
        z-index: 2000;
        border-bottom: 2px solid #C4613A;
        font-family: 'Montserrat', sans-serif;
    }
    .banner-inner {
        max-width: 1200px;
        margin: 0 auto;
        padding: 0 2rem;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 3rem;
    }
    .banner-branding {
        display: flex;
        align-items: center;
        gap: 12px;
    }
    .banner-badge {
        background: rgba(196, 97, 58, 0.15);
        color: #C4613A;
        border: 1px solid #C4613A;
        font-size: 0.6rem;
        font-weight: 800;
        padding: 2px 8px;
        border-radius: 4px;
        letter-spacing: 1px;
    }
    .banner-title {
        font-size: 1rem;
        font-weight: 800;
        letter-spacing: -0.2px;
    }
    .banner-title .highlight {
        color: #C4613A;
    }
    .banner-timer {
        display: flex;
        gap: 1.25rem;
        align-items: center;
    }
    .timer-unit {
        display: flex;
        flex-direction: column;
        align-items: center;
    }
    .timer-unit span {
        font-size: 1.25rem;
        font-weight: 800;
        line-height: 1;
    }
    .timer-unit .seconds {
        color: #C4613A;
    }
    .timer-unit .unit-label {
        font-size: 0.5rem;
        font-weight: 700;
        opacity: 0.5;
        margin-top: 3px;
        letter-spacing: 1px;
    }
    .banner-cta a {
        background: #d4c5a9;
        color: #0a0c0a;
        padding: 0.6rem 1.75rem;
        border-radius: 4px;
        font-weight: 800;
        font-size: 0.85rem;
        text-decoration: none;
        text-transform: uppercase;
        letter-spacing: 1px;
        transition: all 0.3s ease;
        display: inline-block;
    }
    .banner-cta a:hover {
        background: #fff;
        transform: translateY(-2px);
    }

    @media (max-width: 900px) {
        .banner-inner {
            flex-direction: column;
            gap: 1rem;
            padding: 1rem;
        }
        .banner-branding {
            flex-direction: column;
            gap: 5px;
        }
    }
</style>

<!-- Global Promo Banner -->
<div id="launch-banner">
    <div class="banner-inner">
        <div class="banner-branding">
            <span class="banner-badge">LIMITED LAUNCH PROMO</span>
            <div class="banner-title">50% OFF <span class="highlight">THE SYSTEM</span></div>
        </div>
        <div class="banner-timer">
            <div class="timer-unit"><span id="banner-days">00</span><span class="unit-label">DAYS</span></div>
            <div class="timer-unit"><span id="banner-hours">00</span><span class="unit-label">HRS</span></div>
            <div class="timer-unit"><span id="banner-mins">00</span><span class="unit-label">MIN</span></div>
            <div class="timer-unit"><span id="banner-secs" class="seconds">00</span><span class="unit-label">SEC</span></div>
        </div>
        <div class="banner-cta">
            <a href="/join" class="banner-btn">Claim My 50% Off</a>
        </div>
    </div>
</div>

<script is:inline>
    // Global Header Banner Timer
    (function() {
        const targetDate = new Date('February 14, 2026 23:59:59').getTime();
        
        function updateBannerTimer() {
            const now = new Date().getTime();
            const distance = targetDate - now;

            if (distance < 0) {
                const banner = document.getElementById("launch-banner");
                if(banner) banner.style.display = "none";
                return;
            }

            const days = Math.floor(distance / (1000 * 60 * 60 * 24));
            const hours = Math.floor((distance % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
            const minutes = Math.floor((distance % (1000 * 60 * 60)) / (1000 * 60));
            const seconds = Math.floor((distance % (1000 * 60)) / 1000);

            const dEl = document.getElementById("banner-days");
            const hEl = document.getElementById("banner-hours");
            const mEl = document.getElementById("banner-mins");
            const sEl = document.getElementById("banner-secs");

            if(dEl) dEl.innerText = days < 10 ? "0" + days : days;
            if(hEl) hEl.innerText = hours < 10 ? "0" + hours : hours;
            if(mEl) mEl.innerText = minutes < 10 ? "0" + minutes : minutes;
            if(sEl) sEl.innerText = seconds < 10 ? "0" + seconds : seconds;
        }

        setInterval(updateBannerTimer, 1000);
        updateBannerTimer();
    })();
</script>

