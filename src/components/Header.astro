---
const { hideNav = false } = Astro.props;
---
<nav id="navbar">
    <div class="nav-container">
        <!-- Dev Banner -->
        <!-- 
        <div
            style="position: absolute; top: 0; left: 50%; transform: translateX(-50%); background: #00ff00; color: black; padding: 2px 10px; font-size: 10px; font-weight: bold; border-radius: 0 0 5px 5px; z-index: 2000;">
            DEV SITE: AUTOMATION ACTIVE ✅</div> 
        -->
        <a href="/" class="logo">
            MEN'S POST<br>DIVORCE <span>COACHING</span>
        </a>
        {!hideNav && <div class="nav-menu nav-menu-left">
            <a href="/" class="nav-link">Home</a>
            <a href="/services" class="nav-link">Community</a>
            <a href="/about" class="nav-link">About Us</a>
            <div class="nav-item-dropdown">
                <span class="nav-link" style="cursor: pointer;">Courses</span>
                <div class="mega-dropdown" style="width: 250px; left: 0; min-width: 200px;">
                    <div class="mega-dropdown-inner" style="flex-direction: column; padding: 1rem;">
                        <a href="/join" class="mega-link-title" style="margin-bottom: 0;">The System</a>
                        <p class="mega-desc" style="font-size: 0.8rem; margin-top: 0.25rem;">Our Core 5-Step Protocol</p>
                    </div>
                </div>
            </div>

            <div class="nav-item-dropdown">
                <a href="/learn" class="nav-link">Resources</a>
                <div class="mega-dropdown">
                    <div class="mega-dropdown-inner">
                        <div class="mega-left">
                            <div class="mega-accent-bar"></div>
                            <h2>Learn</h2>
                            <p>Expert guidance and proven strategies to help you rebuild your life after divorce.
                            </p>
                            <a href="/learn" class="mega-cta-btn">View All Resources</a>
                        </div>
                        <div class="mega-right">
                            <div class="mega-column">
                                <a href="/learn/mindset-mental-health" class="mega-link-title">Mindset & Mental Health</a>
                                <p class="mega-desc">Recover your focus and mental strength.</p>
                            </div>
                            <div class="mega-column">
                                <a href="/learn/divorce-strategy" class="mega-link-title">Divorce Strategy</a>
                                <p class="mega-desc">Navigate the legal and logistical challenges.</p>
                            </div>
                            <div class="mega-column">
                                <a href="/learn/relationships-dating" class="mega-link-title">Relationships & Dating</a>
                                <p class="mega-desc">Approach new connections with confidence.</p>
                            </div>
                            <div class="mega-column">
                                <a href="/learn/co-parenting" class="mega-link-title">Co-Parenting</a>
                                <p class="mega-desc">Lead your children through the transition.</p>
                            </div>
                            <div class="mega-column">
                                <a href="/learn/financial-recovery" class="mega-link-title">Financial Recovery</a>
                                <p class="mega-desc">Rebuild abundance and financial stability.</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <a href="/clarity-call" class="nav-link nav-link-accent">Clarity Call</a>
            <a href="/contact" class="nav-link">Contact</a>
        </div>}
        <a href="/system/login" class="nav-btn-login">Member Login</a>
        {!hideNav && <a href="/join" class="nav-btn">GET STARTED</a>}
        <button class="mobile-toggle" id="mobile-toggle" style="margin-left: 1rem;">
            <span></span>
            <span></span>
            <span></span>
        </button>
    </div>
</nav>

<!-- MOBILE MENU OVERLAY -->
<div class="mobile-menu" id="mobile-menu">
    {!hideNav && <div class="mobile-nav-links">
        <div class="mobile-nav-item">
            <a href="/" class="mobile-nav-link no-arrow">Home</a>
        </div>
        <div class="mobile-nav-item">
            <a href="#" class="mobile-nav-link has-submenu" data-submenu="about">About Us</a>
            <div class="mobile-submenu" id="submenu-about">
                <a href="/about">Learn More</a>
                <a href="#">Our Leadership</a>
                <a href="#">How it Works</a>
                <a href="/mission">Our Values</a>
                <a href="#">Press</a>
                <a href="#">Investors</a>
                <a href="/contact">Contact Us</a>
                <a href="#">Inclusive Culture</a>
                <a href="#">Careers</a>
            </div>
        </div>
        <div class="mobile-nav-item">
            <a href="#" class="mobile-nav-link has-submenu" data-submenu="courses">Courses</a>
            <div class="mobile-submenu" id="submenu-courses">
                <a href="/join">The System</a>
            </div>
        </div>

        <div class="mobile-nav-item">
            <a href="#" class="mobile-nav-link has-submenu" data-submenu="resources">Resources</a>
            <div class="mobile-submenu" id="submenu-resources">
                <a href="/learn">All Articles</a>
                <a href="/learn/mindset-mental-health">Mindset & Mental Health</a>
                <a href="/learn/divorce-strategy">Divorce Strategy</a>
                <a href="/learn/relationships-dating">Relationships & Dating</a>
                <a href="/learn/co-parenting">Co-Parenting</a>
                <a href="/learn/financial-recovery">Financial Recovery</a>
            </div>
        </div>
        <div class="mobile-nav-item">
            <a href="/services" class="mobile-nav-link no-arrow">Community</a>
        </div>
        <div class="mobile-nav-item">
            <a href="/clarity-call" class="mobile-nav-link no-arrow" style="color: var(--color-accent);">Book Clarity Call</a>
        </div>
        <div class="mobile-nav-item">
            <a href="/contact" class="mobile-nav-link no-arrow">Contact</a>
        </div>
    </div>}
    <div class="mobile-menu-footer">
        <a href="/system/login" class="mobile-menu-btn mobile-menu-btn-outline">Member Login</a>
        {!hideNav && <a href="/join" class="mobile-menu-btn">GET STARTED</a>}
    </div>
</div>
