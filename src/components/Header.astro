                <span>Courses</span>
                <i class="chevron-icon"></i>
            </button>
            <div class="mobile-submenu" id="submenu-courses">
                <a href="/join">The System (Core Protocol)</a>
            </div>
        </div>

        <div class="mobile-nav-item">
            <button class="mobile-nav-toggle" data-submenu="resources">
                <span>Resources</span>
                <i class="chevron-icon"></i>
            </button>
            <div class="mobile-submenu" id="submenu-resources">
                <a href="/learn" style="font-weight: 800; color: var(--color-bg-primary);">View All Articles</a>
                <a href="/category/mindset-mental-health">Mindset & Mental Health</a>
                <a href="/category/divorce-strategy">Divorce Strategy</a>
                <a href="/category/relationships-dating">Relationships & Dating</a>
                <a href="/category/co-parenting">Co-Parenting</a>
                <a href="/category/financial-recovery">Financial Recovery</a>
            </div>
        </div>

        <div class="mobile-nav-item">
            <a href="/about" class="mobile-nav-link">About Alex</a>
        </div>
        <div class="mobile-nav-item">
            <a href="/services" class="mobile-nav-link no-arrow">Community</a>
        </div>
        <div class="mobile-nav-item">
            <a href="/clarity-call" class="mobile-nav-link no-arrow" style="color: var(--color-accent);">Book Clarity Call</a>
        </div>
        <div class="mobile-nav-item">
            <a href="/contact" class="mobile-nav-link no-arrow">Contact</a>
        </div>
    </div>}
    <div class="mobile-menu-footer">
        <a href="/system/login" class="mobile-menu-btn mobile-menu-btn-outline">Member Login</a>
        {!hideNav && <a href="/join" class="mobile-menu-btn">GET STARTED</a>}
    </div>
</div>

<script is:inline>
    // Unified Mobile Menu Script
    (function() {
        const mobileToggle = document.getElementById('mobile-toggle');
        const mobileMenu = document.getElementById('mobile-menu');
        const navToggles = document.querySelectorAll('.mobile-nav-toggle');

        if(mobileToggle && mobileMenu){
            mobileToggle.addEventListener('click', () => {
                mobileToggle.classList.toggle('active');
                mobileMenu.classList.toggle('active');
                // Prevent body scroll when menu is open
                document.body.style.overflow = mobileMenu.classList.contains('active') ? 'hidden' : '';
            });
        }

        // Accordion Logic
        navToggles.forEach(toggle => {
            toggle.addEventListener('click', () => {
                const submenuId = toggle.getAttribute('data-submenu');
                const submenu = document.getElementById(`submenu-${submenuId}`);
                
                // Toggle active class on button and submenu
                toggle.classList.toggle('active');
                submenu.classList.toggle('active');

                // Close other submenus if open (Optional, but cleaner)
                navToggles.forEach(otherToggle => {
                    if (otherToggle !== toggle) {
                        otherToggle.classList.remove('active');
                        const otherSub = document.getElementById(`submenu-${otherToggle.getAttribute('data-submenu')}`);
                        if(otherSub) otherSub.classList.remove('active');
                    }
                });
            });
        });
    })();
</script>
