---
/**
 * KnowledgeGraph.astro
 * Establishes the core entities (Organization & Person) for search engines.
 * This is the foundation for AEO (Answer Engine Optimization).
 */

const siteUrl = "https://menspostdivorcecoaching.com";
const brandName = "Men's Post-Divorce Coaching";
const legalName = "Athens NLP Studies, LLC";
const personName = "Alex Morgan";
const logoUrl = `${siteUrl}/images/social-preview.png`; // Using social preview as fallback logo

const organizationSchema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  "@id": `${siteUrl}/#organization`,
  "name": brandName,
  "legalName": legalName,
  "url": siteUrl,
  "logo": {
    "@type": "ImageObject",
    "url": logoUrl,
    "width": "512",
    "height": "512"
  },
  "address": {
    "@type": "PostalAddress",
    "streetAddress": "1309 Coffeen Ave Ste 1200",
    "addressLocality": "Sheridan",
    "addressRegion": "WY",
    "postalCode": "82801",
    "addressCountry": "US"
  },
  "founder": {
    "@id": `${siteUrl}/#person`
  },
  "sameAs": [
    "https://www.skool.com/the-post-divorce-advantage-8284",
    "https://www.linkedin.com/company/mpdc",
    "https://twitter.com/mpdc_official"
  ],
  "contactPoint": {
    "@type": "ContactPoint",
    "contactType": "customer support",
    "url": `${siteUrl}/contact`
  }
};

const personSchema = {
  "@context": "https://schema.org",
  "@type": "Person",
  "@id": `${siteUrl}/#person`,
  "name": personName,
  "url": `${siteUrl}/about`,
  "image": {
    "@type": "ImageObject",
    "@id": `${siteUrl}/#personImage`,
    "url": `${siteUrl}/images/alex-morgan.png`
  },
  "description": "Alex Morgan is a specialist in divorce recovery for men, focusing on logic-first mindset shifts and practical life rebuilding.",
  "jobTitle": "Founder & NLP Master Trainer",
  "worksFor": {
    "@id": `${siteUrl}/#organization`
  },
  "sameAs": [
    "https://www.skool.com/the-post-divorce-advantage-8284",
    "https://www.linkedin.com/in/alexmorgan",
    "https://www.amazon.com/stores/Alex-Morgan/author/B085RW9QLB"
  ],
  "knowsAbout": [
    {
      "@type": "Thing",
      "name": "Neuro-linguistic programming",
      "sameAs": "https://www.wikidata.org/wiki/Q191483"
    },
    {
      "@type": "Thing",
      "name": "Hypnosis",
      "sameAs": "https://www.wikidata.org/wiki/Q182228"
    },
    {
      "@type": "Thing",
      "name": "Divorce Recovery",
      "sameAs": "https://www.wikidata.org/wiki/Q93190"
    },
    {
      "@type": "Thing",
      "name": "Masculinity",
      "sameAs": "https://www.wikidata.org/wiki/Q1076509"
    }
  ]
};

const websiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "@id": `${siteUrl}/#website`,
  "url": siteUrl,
  "name": brandName,
  "publisher": {
    "@id": `${siteUrl}/#organization`
  },
  "potentialAction": {
    "@type": "SearchAction",
    "target": {
      "@type": "EntryPoint",
      "urlTemplate": `${siteUrl}/learn?s={search_term_string}`
    },
    "query-input": "required name=search_term_string"
  }
};
---

<script type="application/ld+json" is:inline set:html={JSON.stringify(organizationSchema)} />
<script type="application/ld+json" is:inline set:html={JSON.stringify(personSchema)} />
<script type="application/ld+json" is:inline set:html={JSON.stringify(websiteSchema)} />
