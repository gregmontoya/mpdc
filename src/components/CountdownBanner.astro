---
---
<div id="launch-banner">
    <div class="banner-inner">
        <!-- Logo/Title Section -->
        <div class="banner-branding">
            <span class="banner-badge">LIMITED LAUNCH PROMO</span>
            <div class="banner-title">
                50% OFF <span class="highlight">THE SYSTEM</span>
            </div>
        </div>

        <!-- Countdown -->
        <div class="banner-timer">
            <div class="timer-unit">
                <span id="banner-days">00</span>
                <label>DAYS</label>
            </div>
            <div class="timer-unit">
                <span id="banner-hours">00</span>
                <label>HRS</label>
            </div>
            <div class="timer-unit">
                <span id="banner-mins">00</span>
                <label>MIN</label>
            </div>
            <div class="timer-unit">
                <span id="banner-secs" class="seconds">00</span>
                <label>SEC</label>
            </div>
        </div>

        <!-- CTA -->
        <div class="banner-cta">
            <a href="/join" class="banner-btn">Claim My 50% Off</a>
        </div>
    </div>
</div>

<style>
    #launch-banner {
        background: #1a2329;
        color: #fff;
        padding: 0.75rem 0;
        position: relative;
        z-index: 2000;
        border-bottom: 2px solid var(--color-accent, #C4613A);
        font-family: 'Montserrat', sans-serif;
    }

    .banner-inner {
        max-width: 1000px;
        margin: 0 auto;
        padding: 0 2rem;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 3rem;
    }

    .banner-branding {
        display: flex;
        align-items: center;
        gap: 12px;
        flex-shrink: 0;
    }

    .banner-badge {
        background: rgba(196, 97, 58, 0.15);
        color: var(--color-accent, #C4613A);
        border: 1px solid var(--color-accent, #C4613A);
        font-size: 0.6rem;
        font-weight: 800;
        padding: 2px 8px;
        border-radius: 4px;
        letter-spacing: 1px;
    }

    .banner-title {
        font-size: 1rem;
        font-weight: 800;
        letter-spacing: -0.2px;
    }

    .banner-title .highlight {
        color: var(--color-accent, #C4613A);
    }

    /* Timer Styles */
    .banner-timer {
        display: flex;
        gap: 1.25rem;
        align-items: center;
    }

    .timer-unit {
        display: flex;
        flex-direction: column;
        align-items: center;
    }

    .timer-unit span {
        font-size: 1.25rem;
        font-weight: 800;
        line-height: 1;
    }

    .timer-unit .seconds {
        color: var(--color-accent, #C4613A);
    }

    .timer-unit label {
        font-size: 0.5rem;
        font-weight: 700;
        opacity: 0.5;
        margin-top: 3px;
        letter-spacing: 1px;
    }

    /* CTA Button */
    .banner-btn {
        background: #D4C5A9; /* High-contrast Tan */
        color: #0A0C0A; /* Dark text for readability */
        padding: 0.6rem 1.75rem;
        border-radius: 4px;
        font-weight: 800;
        font-size: 0.85rem;
        text-decoration: none;
        text-transform: uppercase;
        letter-spacing: 1px;
        transition: all 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);
        box-shadow: 0 4px 15px rgba(212, 197, 169, 0.2);
        animation: banner-pulse 3s infinite;
    }

    @keyframes banner-pulse {
        0% { transform: scale(1); box-shadow: 0 4px 15px rgba(212, 197, 169, 0.2); }
        50% { transform: scale(1.03); box-shadow: 0 4px 25px rgba(212, 197, 169, 0.4); }
        100% { transform: scale(1); box-shadow: 0 4px 15px rgba(212, 197, 169, 0.2); }
    }

    .banner-btn:hover {
        background: #fff;
        transform: translateY(-2px) scale(1.05);
        box-shadow: 0 6px 30px rgba(212, 197, 169, 0.6);
        animation: none;
    }

    @media (max-width: 800px) {
        .banner-inner {
            flex-direction: column;
            gap: 1rem;
            padding: 1rem;
        }
        .banner-branding {
            flex-direction: column;
            gap: 5px;
        }
        .banner-btn {
            width: 100%;
            text-align: center;
        }
    }

</style>

<script is:inline>
    (function() {
        const target = new Date('February 14, 2026 23:59:59').getTime();

        function update() {
            const now = new Date().getTime();
            const diff = target - now;

            if (diff <= 0) {
                const banner = document.getElementById('launch-banner');
                if (banner) banner.style.display = 'none';
                return;
            }

            const d = Math.floor(diff / (1000 * 60 * 60 * 24));
            const h = Math.floor((diff % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
            const m = Math.floor((diff % (1000 * 60 * 60)) / (1000 * 60));
            const s = Math.floor((diff % (1000 * 60)) / 1000);

            const dEl = document.getElementById('banner-days');
            const hEl = document.getElementById('banner-hours');
            const mEl = document.getElementById('banner-mins');
            const sEl = document.getElementById('banner-secs');

            if (dEl) dEl.innerText = String(d).padStart(2, '0');
            if (hEl) hEl.innerText = String(h).padStart(2, '0');
            if (mEl) mEl.innerText = String(m).padStart(2, '0');
            if (sEl) sEl.innerText = String(s).padStart(2, '0');
        }

        setInterval(update, 1000);
        update();
    })();
</script>
