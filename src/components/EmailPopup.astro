---

<div id="email-popup-overlay" class="popup-overlay hidden">
  <div class="popup-container">
    <button id="popup-close" class="popup-close">&times;</button>
    <div class="popup-content">
      <div class="popup-left">
        <div class="popup-header" id="popup-header-text">GET THE EDGE</div>
        <h2 class="popup-title" id="popup-title-text">DELETE LIMITING BELIEFS.</h2>
        <p class="popup-text" id="popup-body-text">
          Don't let the past own your future. Use the <strong>Worksheet to Resolve Your Past</strong> and our <strong>Free Limiting Beliefs Hypnosis</strong> to stop reacting and start leading. 100% FREE.
        </p>
        
        <form id="popup-form" class="popup-form">
          <div class="input-group">
            <input type="text" id="popup-name" placeholder="First Name" required />
            <i class="fa-solid fa-user input-icon"></i>
          </div>
          <div class="input-group">
            <input type="email" id="popup-email" placeholder="Email Address" required />
            <i class="fa-solid fa-envelope input-icon"></i>
          </div>
          <button type="submit" class="popup-submit-btn" id="popup-submit-text">ACCESS FREE TOOLS →</button>
        </form>
        
        <p class="popup-disclaimer">
          By entering your info, you'll become an MPDC Insider - with FREE access to exclusive insights. 
          Unsub anytime in a click.
        </p>
      </div>
      <div class="popup-right" id="popup-image-container">
        <!-- Image background set in CSS -->
      </div>
    </div>
  </div>
</div>

<style>
  /* 🎨 RESTORED MARIE'S ORIGINAL DESIGN SYSTEM */
  .popup-overlay {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(0, 0, 0, 0.85);
    z-index: 10000;
    display: flex;
    justify-content: center;
    align-items: center;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.4s ease;
    backdrop-filter: blur(5px);
  }

  .popup-overlay.visible {
    opacity: 1;
    pointer-events: auto;
  }

  .popup-overlay.hidden {
    display: none;
  }

  .popup-container {
    background: #1a1a1a;
    width: 900px;
    max-width: 95vw;
    height: 600px;
    max-height: 90vh;
    display: flex;
    position: relative;
    box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.5);
    border: 1px solid #333;
    animation: slideUp 0.5s ease-out;
    overflow: hidden;
  }

  @keyframes slideUp {
    from { transform: translateY(50px); opacity: 0; }
    to { transform: translateY(0); opacity: 1; }
  }

  .popup-close {
    position: absolute;
    top: 15px;
    right: 15px;
    background: white;
    border: none;
    color: #1a1a1a;
    font-size: 24px;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    cursor: pointer;
    z-index: 100;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: transform 0.2s;
  }

  .popup-close:hover {
    transform: scale(1.1);
  }

  .popup-content {
    display: flex;
    width: 100%;
    height: 100%;
  }

  .popup-left {
    flex: 1;
    padding: 60px 50px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    color: white;
    text-align: left;
  }

  .popup-right {
    flex: 1;
    background-image: url('/images/free-download.png'); /* 🖼️ New Asset Installed */
    background-size: cover;
    background-position: center;
    position: relative;
  }

  .popup-right::after {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 50%;
    height: 100%;
    background: linear-gradient(to right, #1a1a1a, transparent);
  }

  .popup-header {
    font-family: 'Montserrat', sans-serif;
    font-weight: 700;
    letter-spacing: 2px;
    font-size: 14px;
    margin-bottom: 20px;
    color: #fff;
    text-transform: uppercase;
  }

  .popup-title {
    font-family: 'Montserrat', sans-serif;
    font-size: 42px;
    line-height: 1.1;
    margin-bottom: 25px;
    color: #fff;
    font-weight: 700;
  }

  .popup-text {
    font-size: 16px;
    line-height: 1.6;
    margin-bottom: 40px;
    color: #ccc;
  }

  .popup-form {
    display: flex;
    flex-direction: column;
    gap: 15px;
    width: 100%;
  }

  .input-group {
    position: relative;
  }

  .popup-form input {
    width: 100%;
    padding: 16px 20px 16px 45px;
    border: 2px solid #fff;
    background: #fff;
    color: #333;
    font-size: 16px;
    outline: none;
    transition: all 0.3s;
  }
  
  .popup-form input:focus {
    border-color: #8A2BE2;
  }

  .input-icon {
    position: absolute;
    left: 18px;
    top: 50%;
    transform: translateY(-50%);
    color: #888;
    pointer-events: none;
  }

  .popup-submit-btn {
    background: #C4613A; /* � MPDC Burnt Copper Orange */
    color: white;
    border: none;
    padding: 18px;
    font-weight: 700;
    font-size: 16px;
    letter-spacing: 1px;
    cursor: pointer;
    text-transform: uppercase;
    transition: transform 0.2s, box-shadow 0.2s;
    margin-top: 10px;
  }

  .popup-submit-btn:hover {
    transform: translateY(-2px);
    box-shadow: 0 10px 20px rgba(196, 97, 58, 0.4);
    background: #d46f48;
  }

  .popup-disclaimer {
    margin-top: 25px;
    font-size: 11px;
    color: #666;
    line-height: 1.4;
  }

  @media (max-width: 768px) {
    .popup-container {
      flex-direction: column;
      height: auto;
      max-height: 95vh;
      width: 95%;
    }
    .popup-right { display: none; }
    .popup-left { padding: 40px 30px; }
    .popup-title { font-size: 32px; }
  }
</style>

<script>
  // 🚀 KEEPING THE BULLETPROOF LOGIC FROM v2.1.11
  const overlay = document.getElementById('email-popup-overlay');
  const closeBtn = document.getElementById('popup-close');
  const form = document.getElementById('popup-form') as HTMLFormElement;
  const nameInput = document.getElementById('popup-name') as HTMLInputElement;
  const emailInput = document.getElementById('popup-email') as HTMLInputElement;
  const submitBtn = document.querySelector('.popup-submit-btn') as HTMLButtonElement;

  const STORAGE_KEY = 'mpdc_lead_captured';

  // 🚀 INTELLIGENT PAGE LOGIC
  const currentPath = window.location.pathname;
  const isResourcePage = currentPath.includes('/resources/') || currentPath.includes('/free-guide');
  const isJoinPage = currentPath.includes('/join');
  
  // 1. COMPLETELY DISABLE on Resource/Success pages
  if (isResourcePage) {
    console.log('🔇 Popup disabled for resource page');
    overlay?.remove(); // Remove from DOM entirely
  } else {
    // 2. SELECTIVE PRODUCTION MODE
    const DEBUG_MODE = false; 

    function showPopup() {
      if (!DEBUG_MODE && localStorage.getItem(STORAGE_KEY)) return;
      overlay?.classList.remove('hidden');
      void overlay?.offsetWidth;
      overlay?.classList.add('visible');
    }

    // 3. EXIT INTENT TRIGGER (Active on Join Page + Rest of Site)
    let exitIntentTriggered = false;
    document.addEventListener('mouseleave', (e) => {
      if (e.clientY <= 0 && !exitIntentTriggered) {
        exitIntentTriggered = true;
        showPopup();
      }
    });

    // 4. BACKUP TIMER (ONLY on Non-Sales Pages)
    if (!isJoinPage) {
      setTimeout(() => { if (!exitIntentTriggered) showPopup(); }, 20000); // ⏱️ 20 Second Sweet Spot
    }
  }

  function closePopup(permanent = true) {
    overlay?.classList.remove('visible');
    setTimeout(() => {
      overlay?.classList.add('hidden');
      if (permanent) localStorage.setItem(STORAGE_KEY, 'true');
    }, 400);
  }

  closeBtn?.addEventListener('click', () => closePopup(true));
  overlay?.addEventListener('click', (e) => { if (e.target === overlay) closePopup(true); });

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const name = nameInput.value;
    const email = emailInput.value;
    if (!name || !email) return;

    submitBtn.innerText = "CAPTURING...";
    submitBtn.disabled = true;

    try {
      const attribution = (window as any).getAttributionData ? (window as any).getAttributionData() : {};
      const guestId = localStorage.getItem('mpdc_guest_id');

      const response = await fetch('https://webhook-server-xi-nine.vercel.app/capture-lead', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ name, email, guestId, attribution, source: 'maries_popup_restored' })
      });

      if (response.ok) {
        submitBtn.innerText = "THANK YOU!";
        submitBtn.style.background = "#2ecc71";
        
        // 🚀 Redirect to Join Page after a short delay
        setTimeout(() => {
          closePopup(true);
          window.location.href = '/join';
        }, 1500);
      } else { throw new Error('Failed'); }
    } catch (error) {
      submitBtn.innerText = "ERROR - TRY AGAIN";
      submitBtn.disabled = false;
    }
  });
</script>
