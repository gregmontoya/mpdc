---
---

<div id="email-popup-overlay" class="popup-overlay hidden">
  <div class="popup-container">
    <button id="popup-close" class="popup-close">&times;</button>
    <div class="popup-content">
      <div class="popup-left">
        <div class="popup-header">WAIT!</div>
        <h2 class="popup-title">Rebuild your life with confidence & success.</h2>
        <p class="popup-text">
          Join our exclusive community and get weekly strategies to master your mindset, finances, and relationships after divorce.
        </p>
        
        <form id="popup-form" class="popup-form">
          <div class="input-group">
            <input type="text" id="popup-name" placeholder="First Name" required />
            <i class="fa-solid fa-user input-icon"></i>
          </div>
          <div class="input-group">
            <input type="email" id="popup-email" placeholder="Email Address" required />
            <i class="fa-solid fa-envelope input-icon"></i>
          </div>
          <button type="submit" class="popup-submit-btn">JOIN THE BROTHERHOOD</button>
        </form>
        
        <p class="popup-disclaimer">
          By entering your info, you'll become an MPDC Insider - with FREE access to exclusive insights. 
          Unsub anytime in a click.
        </p>
      </div>
      <div class="popup-right">
        <!-- Image background set in CSS or via inline style if dynamic -->
      </div>
    </div>
  </div>
</div>

<style>
  /* Overlay */
  .popup-overlay {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(0, 0, 0, 0.85); /* Dark overlay */
    z-index: 9999;
    display: flex;
    justify-content: center; /* Center horizontally */
    align-items: center; /* Center vertically */
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.4s ease;
    backdrop-filter: blur(5px);
  }

  .popup-overlay.visible {
    opacity: 1;
    pointer-events: auto;
  }

  .popup-overlay.hidden {
    display: none;
  }

  /* Container */
  .popup-container {
    background: #1a1a1a; /* Dark background */
    width: 900px;
    max-width: 95vw;
    height: 600px;
    max-height: 90vh;
    display: flex;
    position: relative;
    box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.5);
    border: 1px solid #333;
    animation: slideUp 0.5s ease-out;
    overflow: hidden; /* Ensure image doesn't overflow corners */
  }

  @keyframes slideUp {
    from { transform: translateY(50px); opacity: 0; }
    to { transform: translateY(0); opacity: 1; }
  }

  /* Close Button */
  .popup-close {
    position: absolute;
    top: 15px;
    right: 15px;
    background: white;
    border: none;
    color: #1a1a1a;
    font-size: 24px;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    cursor: pointer;
    z-index: 10;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: transform 0.2s;
  }

  .popup-close:hover {
    transform: scale(1.1);
  }

  /* Layout */
  .popup-content {
    display: flex;
    width: 100%;
    height: 100%;
  }

  .popup-left {
    flex: 1;
    padding: 60px 50px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    color: white;
    text-align: left;
  }

  .popup-right {
    flex: 1;
    background-image: url('/images/popup-man.png');
    background-size: cover;
    background-position: center;
    position: relative;
  }

  /* Add a gradient overlay to the image to make it blend */
  .popup-right::after {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 50%;
    height: 100%;
    background: linear-gradient(to right, #1a1a1a, transparent);
  }

  /* Typography */
  .popup-header {
    font-family: 'Montserrat', sans-serif;
    font-weight: 700;
    letter-spacing: 2px;
    font-size: 14px;
    margin-bottom: 20px;
    color: #fff;
    text-transform: uppercase;
  }

  .popup-title {
    font-family: 'Bebas Neue', sans-serif; /* Or serif if preferred */
    font-size: 56px;
    line-height: 1;
    margin-bottom: 25px;
    color: #fff;
    font-weight: 400; /* Bebas is bold by default */
  }

  .popup-text {
    font-family: 'Open Sans', sans-serif;
    font-size: 16px;
    line-height: 1.6;
    margin-bottom: 40px;
    color: #ccc;
  }

  /* Form */
  .popup-form {
    display: flex;
    flex-direction: column;
    gap: 15px;
    width: 100%;
  }

  .input-group {
    position: relative;
  }

  .popup-form input {
    width: 100%;
    padding: 16px 20px 16px 45px; /* Space for icon */
    border: 2px solid #fff;
    background: #fff;
    color: #333;
    font-family: 'Open Sans', sans-serif;
    font-size: 16px;
    outline: none;
    transition: all 0.3s;
  }
  
  .popup-form input:focus {
    border-color: #d4af37; /* Gold accent */
  }

  .input-icon {
    position: absolute;
    left: 18px;
    top: 50%;
    transform: translateY(-50%);
    color: #888;
    pointer-events: none;
  }

  .popup-submit-btn {
    background: linear-gradient(90deg, #8A2BE2, #4B0082); /* Purple gradient like Marie's */
    color: white;
    border: none;
    padding: 18px;
    font-family: 'Montserrat', sans-serif;
    font-weight: 700;
    font-size: 16px;
    letter-spacing: 1px;
    cursor: pointer;
    text-transform: uppercase;
    transition: transform 0.2s, box-shadow 0.2s;
    margin-top: 10px;
  }

  .popup-submit-btn:hover {
    transform: translateY(-2px);
    box-shadow: 0 10px 20px rgba(138, 43, 226, 0.4);
  }

  .popup-disclaimer {
    margin-top: 25px;
    font-size: 11px;
    color: #666;
    line-height: 1.4;
  }

  /* Responsive */
  @media (max-width: 768px) {
    .popup-container {
      flex-direction: column;
      height: auto;
      max-height: 95vh;
      width: 95%;
    }

    .popup-right {
      display: none; /* Hide image on mobile to save space */
    }

    .popup-left {
      padding: 40px 30px;
    }

    .popup-title {
      font-size: 36px;
    }
  }
</style>

<script>
  import { db } from '../lib/firebase';
  import { collection, addDoc, serverTimestamp } from 'firebase/firestore';
  import { getAttributionData } from '../lib/attribution.js';

  // Logic
  const overlay = document.getElementById('email-popup-overlay');
  const closeBtn = document.getElementById('popup-close');
  const form = document.getElementById('popup-form');
  const nameInput = document.getElementById('popup-name') as HTMLInputElement;
  const emailInput = document.getElementById('popup-email') as HTMLInputElement;
  const submitBtn = document.querySelector('.popup-submit-btn') as HTMLButtonElement;

  const POPUP_STORAGE_KEY = 'mpdc_popup_dismissed';

  // Show Popup Function
  function showPopup() {
    if (localStorage.getItem(POPUP_STORAGE_KEY)) {
      return; // Already dismissed or subscribed
    }
    
    // Remove hidden class first to ensure display:flex is applied
    overlay?.classList.remove('hidden');
    // Force reflow
    void overlay?.offsetWidth;
    // Add visible class for opacity transition
    overlay?.classList.add('visible');
  }

  // Close Popup Function
  function closePopup(permanent = false) {
    overlay?.classList.remove('visible');
    
    setTimeout(() => {
      overlay?.classList.add('hidden');
      if (permanent) {
        localStorage.setItem(POPUP_STORAGE_KEY, 'true');
      } else {
        // Session dismissal - maybe show again next visit? 
        // For now, let's treat "closed" as permanent to not annoy users
        localStorage.setItem(POPUP_STORAGE_KEY, 'true');
      }
    }, 400); // Match transition duration
  }

  // Triggers
  // 1. Time delay
  setTimeout(() => {
    showPopup();
  }, 5000); // 5 seconds

  // Event Listeners
  closeBtn?.addEventListener('click', () => closePopup(true));
  
  // Close on outside click
  overlay?.addEventListener('click', (e) => {
    if (e.target === overlay) {
      closePopup(true);
    }
  });

  // Form Submit
  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    
    const name = nameInput?.value;
    const email = emailInput?.value;

    if (!name || !email) return;

    // Loading state
    const originalBtnText = submitBtn.innerText;
    submitBtn.innerText = "JOINING...";
    submitBtn.disabled = true;

    try {
      // Get Attribution
      const attr = getAttributionData();

      // Add to Firestore
      await addDoc(collection(db, "subscribers"), {
        name: name,
        email: email,
        source: 'popup',
        createdAt: serverTimestamp(),
        ...attr
      });

      // Success
      submitBtn.innerText = "WELCOME BROTHER!";
      submitBtn.style.background = "#2ecc71"; // Green
      
      setTimeout(() => {
        closePopup(true);
        // Reset form
        form.reset();
        submitBtn.innerText = originalBtnText;
        submitBtn.disabled = false;
        submitBtn.style.background = ""; // Reset to gradient
      }, 2000);

    } catch (error) {
      console.error("Error adding subscriber: ", error);
      submitBtn.innerText = "ERROR, TRY AGAIN";
      submitBtn.style.background = "#e74c3c"; // Red
      
      setTimeout(() => {
        submitBtn.innerText = originalBtnText;
        submitBtn.disabled = false;
        submitBtn.style.background = ""; // Reset
      }, 3000);
    }
  });
</script>
