---
---

<div id="email-popup-overlay" class="popup-overlay hidden">
  <div class="popup-container">
    <button id="popup-close" class="popup-close">&times;</button>
    <div class="popup-content">
      <div class="popup-left">
        <div class="popup-header">DON'T LEAVE IN THE FOG</div>
        <h2 class="popup-title">Reclaim Your Focus. <span class="highlight">Now.</span></h2>
        <p class="popup-text">
          Grab the <strong>7-Minute Fog-Clearance Protocol</strong>. Stop reacting to the stress and start leading your life again. (Free Action Guide Download)
        </p>
        
        <form id="popup-form" class="popup-form">
          <div class="input-group">
            <input type="text" id="popup-name" placeholder="First Name" required />
            <i class="fa-solid fa-user input-icon"></i>
          </div>
          <div class="input-group">
            <input type="email" id="popup-email" placeholder="Email Address" required />
            <i class="fa-solid fa-envelope input-icon"></i>
          </div>
          <button type="submit" class="popup-submit-btn">SEND ME THE PROTOCOL →</button>
        </form>
        
        <p class="popup-disclaimer">
          By joining, you'll receive the protocol plus exclusive MPDC mental programming insights. Unsubscribe any time.
        </p>
      </div>
      <div class="popup-right">
        <!-- Background image set in CSS -->
      </div>
    </div>
  </div>
</div>

<style>
  /* Overlay */
  .popup-overlay {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(11, 59, 54, 0.95); /* Deep Steel Green tinted overlay */
    z-index: 10000;
    display: flex;
    justify-content: center;
    align-items: center;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.4s ease;
    backdrop-filter: blur(8px);
  }

  .popup-overlay.visible {
    opacity: 1;
    pointer-events: auto;
  }

  .popup-overlay.hidden {
    display: none;
  }

  /* Container */
  .popup-container {
    background: #ffffff;
    width: 900px;
    max-width: 95vw;
    height: 600px;
    max-height: 90vh;
    display: flex;
    position: relative;
    box-shadow: 0 40px 100px -20px rgba(0, 0, 0, 0.5);
    border-radius: 12px;
    overflow: hidden;
    animation: popupAppear 0.5s cubic-bezier(0.165, 0.84, 0.44, 1);
  }

  @keyframes popupAppear {
    from { transform: scale(0.9) translateY(40px); opacity: 0; }
    to { transform: scale(1) translateY(0); opacity: 1; }
  }

  /* Close Button */
  .popup-close {
    position: absolute;
    top: 20px;
    right: 20px;
    background: #f4f4f4;
    border: none;
    color: #0b3b36;
    font-size: 28px;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    cursor: pointer;
    z-index: 100;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.3s;
    line-height: 1;
  }

  .popup-close:hover {
    background: #eee;
    transform: rotate(90deg);
  }

  /* Layout */
  .popup-content {
    display: flex;
    width: 100%;
    height: 100%;
  }

  .popup-left {
    flex: 1.2;
    padding: 60px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    background: #ffffff;
    color: #1a1a1a;
  }

  .popup-right {
    flex: 1;
    background-image: url('/images/popup-man.png');
    background-size: cover;
    background-position: center;
    position: relative;
  }

  .popup-right::after {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: linear-gradient(to right, #ffffff, transparent 40%);
  }

  /* Typography */
  .popup-header {
    font-weight: 800;
    letter-spacing: 3px;
    font-size: 13px;
    margin-bottom: 20px;
    color: var(--color-accent, #C4613A);
    text-transform: uppercase;
  }

  .popup-title {
    font-family: 'Montserrat', sans-serif;
    font-size: 48px;
    line-height: 1.1;
    margin-bottom: 25px;
    color: #0b3b36;
    font-weight: 900;
    text-transform: uppercase;
  }

  .highlight {
    color: var(--color-accent, #C4613A);
  }

  .popup-text {
    font-size: 18px;
    line-height: 1.6;
    margin-bottom: 35px;
    color: #444;
  }

  /* Form */
  .popup-form {
    display: flex;
    flex-direction: column;
    gap: 12px;
    width: 100%;
  }

  .input-group {
    position: relative;
  }

  .popup-form input {
    width: 100%;
    padding: 16px 20px 16px 50px;
    border: 2px solid #e2e8f0;
    background: #f8fafc;
    color: #0b3b36;
    font-size: 16px;
    border-radius: 8px;
    outline: none;
    transition: all 0.3s;
    font-family: inherit;
  }
  
  .popup-form input:focus {
    border-color: #C4613A;
    background: #fff;
  }

  .input-icon {
    position: absolute;
    left: 20px;
    top: 50%;
    transform: translateY(-50%);
    color: #94a3b8;
    pointer-events: none;
  }

  .popup-submit-btn {
    background: #C4613A;
    color: white;
    border: none;
    padding: 20px;
    border-radius: 8px;
    font-weight: 800;
    font-size: 16px;
    letter-spacing: 2px;
    cursor: pointer;
    text-transform: uppercase;
    transition: all 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);
    margin-top: 10px;
    box-shadow: 0 10px 20px rgba(196, 97, 58, 0.3);
  }

  .popup-submit-btn:hover {
    transform: translateY(-3px);
    box-shadow: 0 15px 30px rgba(196, 97, 58, 0.4);
    background: #d46f48;
  }

  .popup-disclaimer {
    margin-top: 25px;
    font-size: 11px;
    color: #94a3b8;
    line-height: 1.6;
    text-align: center;
  }

  /* Responsive */
  @media (max-width: 768px) {
    .popup-container {
      flex-direction: column;
      height: auto;
      max-height: 95vh;
      width: 92%;
    }

    .popup-right {
      height: 180px;
      flex: none;
      background-position: center 20%;
    }
    
    .popup-right::after {
        background: linear-gradient(to top, #ffffff, transparent 60%);
        width: 100%;
        height: 100%;
    }

    .popup-left {
      padding: 35px 25px;
      flex: none;
    }

    .popup-title {
      font-size: 32px;
    }
    
    .popup-text {
        font-size: 16px;
        margin-bottom: 25px;
    }
  }
</style>

<script>
  import { getAttributionData } from '../lib/attribution.js';

  const overlay = document.getElementById('email-popup-overlay');
  const closeBtn = document.getElementById('popup-close');
  const form = document.getElementById('popup-form') as HTMLFormElement;
  const nameInput = document.getElementById('popup-name') as HTMLInputElement;
  const emailInput = document.getElementById('popup-email') as HTMLInputElement;
  const submitBtn = document.querySelector('.popup-submit-btn') as HTMLButtonElement;

  const STORAGE_KEY = 'mpdc_lead_captured';

  function showPopup() {
    if (localStorage.getItem(STORAGE_KEY)) return;
    
    overlay?.classList.remove('hidden');
    void overlay?.offsetWidth;
    overlay?.classList.add('visible');
  }

  function closePopup(permanent = true) {
    overlay?.classList.remove('visible');
    setTimeout(() => {
      overlay?.classList.add('hidden');
      if (permanent) localStorage.setItem(STORAGE_KEY, 'true');
    }, 400);
  }

  // 🚀 EXIT INTENT TRIGGER
  let exitIntentTriggered = false;
  document.addEventListener('mouseleave', (e) => {
    // Only trigger if mouse leaves through the top of the viewport
    if (e.clientY <= 0 && !exitIntentTriggered) {
      exitIntentTriggered = true;
      showPopup();
    }
  });

  // Backup: Show after 45 seconds anyway if they are engaged
  setTimeout(() => {
    if (!exitIntentTriggered) showPopup();
  }, 45000);

  closeBtn?.addEventListener('click', () => closePopup(true));
  overlay?.addEventListener('click', (e) => {
    if (e.target === overlay) closePopup(true);
  });

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    
    const name = nameInput.value;
    const email = emailInput.value;
    if (!name || !email) return;

    submitBtn.innerText = "SENDING PROTOCOL...";
    submitBtn.disabled = true;

    try {
      const attribution = (window as any).getAttributionData ? (window as any).getAttributionData() : {};
      const guestId = localStorage.getItem('mpdc_guest_id');

      const response = await fetch('https://mpdc-webhook-server.vercel.app/capture-lead', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          name,
          email,
          guestId,
          attribution,
          source: 'exit_intent_popup'
        })
      });

      if (response.ok) {
        submitBtn.innerText = "CHECK YOUR EMAIL!";
        submitBtn.style.background = "#0b3b36";
        
        setTimeout(() => {
          closePopup(true);
        }, 2500);
      } else {
        throw new Error('Failed to capture lead');
      }
    } catch (error) {
      console.error("Popup Error:", error);
      submitBtn.innerText = "ERROR, TRY AGAIN";
      submitBtn.style.background = "#e74c3c";
      submitBtn.disabled = false;
    }
  });
</script>
