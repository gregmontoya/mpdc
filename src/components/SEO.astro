---
export interface Props {
  title: string;
  description: string;
  image?: string;
  url?: string;
  type?: string;
}

import seoConfig from '../data/seo-config.json';

const {
  title: defaultTitle,
  description: defaultDescription,
  image = '/images/social-share.jpg', // Default image if not provided
  url = Astro.url,
  type = 'website',
} = Astro.props;

import KnowledgeGraph from './KnowledgeGraph.astro';

// 🕵️‍♂️ Dynamic Lookup (Self-Healing SEO)
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const config = (seoConfig as any)[path] || {};

const title = config.title || defaultTitle;
const description = config.description || defaultDescription;

// 🗺️ Server-Side Breadcrumb Logic
const parts = path.split('/').filter(p => p);
const breadcrumbs = [
  {
    "@type": "ListItem",
    "position": 1,
    "name": "Home",
    "item": "https://menspostdivorcecoaching.com/"
  }
];

let builtPath = "https://menspostdivorcecoaching.com/";
parts.forEach((part, index) => {
  builtPath += part + "/";
  const name = part.charAt(0).toUpperCase() + part.slice(1).replace(/-/g, ' ');
  breadcrumbs.push({
    "@type": "ListItem",
    "position": index + 2,
    "name": name,
    "item": builtPath.replace(/\/$/, '')
  });
});

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": breadcrumbs
};
---

<KnowledgeGraph />

<!-- 🚀 Speculation Rules API (Instant Load) -->
<script type="speculationrules" is:inline>
{
  "prerender": [
    {
      "source": "list",
      "urls": ["/join", "/learn"]
    },
    {
      "source": "document",
      "where": {
        "and": [
          { "href_matches": "/*" },
          { "not": { "href_matches": "/crm/*" } },
          { "not": { "href_matches": "/admin/*" } }
        ]
      },
      "eagerness": "moderate"
    }
  ]
}
</script>

<!-- 🗺️ Automated BreadcrumbList Schema -->
<script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} is:inline />

<!-- Global Metadata -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<meta name="generator" content={Astro.generator} />

<!-- Primary Meta Tags -->
<title>{title}</title>
<meta name="title" content={title} />
<meta name="description" content={description} />
<link rel="canonical" href={url} />

<!-- Open Graph / Facebook -->
<meta property="og:type" content={type} />
<meta property="og:url" content={url} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={new URL(image, Astro.url)} />

<!-- Twitter -->
<meta property="twitter:card" content="summary_large_image" />
<meta property="twitter:url" content={url} />
<meta property="twitter:title" content={title} />
<meta property="twitter:description" content={description} />
<meta property="twitter:image" content={new URL(image, Astro.url)} />

<!-- 🕵️‍♂️ MPDC Global Attribution Tracker -->
<script is:inline src="/js/global-attribution.js" defer></script>

<!-- 📊 Google Analytics & FB Pixel (CWV Optimized Delayed Load) -->
<script is:inline>
