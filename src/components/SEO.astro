  window.dataLayer = window.dataLayer || [];
  function gtag(){dataLayer.push(arguments);}
  
  // Set default consent to 'denied' for tracking but allowed for functionality
  // This allows GA4 to track anonymous 'pings' even before consent
  const consentCookie = document.cookie.split('; ').find(row => row.startsWith('cookie_consent='));
  let initialPrefs = null;
  if (consentCookie) {
    try {
      initialPrefs = JSON.parse(decodeURIComponent(consentCookie.split('=')[1]));
    } catch (e) {}
  }

  gtag('consent', 'default', {
    'ad_storage': initialPrefs?.marketing ? 'granted' : 'denied',
    'ad_user_data': initialPrefs?.marketing ? 'granted' : 'denied',
    'ad_personalization': initialPrefs?.marketing ? 'granted' : 'denied',
    'analytics_storage': initialPrefs?.analytics ? 'granted' : 'denied',
    'wait_for_update': 500
