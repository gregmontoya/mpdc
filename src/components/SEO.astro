    if (window.analyticsLoaded) return;

    // 🍪 Check Cookie Preferences
    const consentCookie = document.cookie.split('; ').find(row => row.startsWith('cookie_consent='));
    let prefs = null;
    
    if (consentCookie) {
      try {
        prefs = JSON.parse(decodeURIComponent(consentCookie.split('=')[1]));
      } catch (e) {}
    }

    // If no preference yet, don't load (wait for interaction)
    if (!prefs) {
        console.log('🍪 Waiting for cookie consent before loading analytics...');
        return;
    }

