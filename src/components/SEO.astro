---
export interface Props {
  title: string;
  description: string;
  image?: string;
  url?: string;
  type?: string;
}

import seoConfig from '../data/seo-config.json';

const {
  title: propTitle,
  description: propDescription,
  image = '/images/social-share.jpg',
  url,
  type = 'website',
} = Astro.props;

import KnowledgeGraph from './KnowledgeGraph.astro';

// 🕵️‍♂️ Dynamic Lookup (Self-Healing SEO)
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const config = (seoConfig as any)[path] || {};

// 🏷️ Metadata Resolution (Priority: Prop > JSON Config > Global Default)
const title = propTitle || config.title || "Men's Post-Divorce Coaching";
const description = propDescription || config.description || "Elite recovery systems and tactical mindset training for men after divorce.";

// 🔗 Canonical Normalization (Force no trailing slash to match sitemap)
const canonicalURL = url || new URL(path, Astro.site);

// 🗺️ Server-Side Breadcrumb Logic
const parts = path.split('/').filter(p => p);
const breadcrumbs = [
  {
    "@type": "ListItem",
    "position": 1,
    "name": "Home",
    "item": "https://menspostdivorcecoaching.com/"
  }
];

let builtPath = "https://menspostdivorcecoaching.com/";
parts.forEach((part, index) => {
  builtPath += part + "/";
  const name = part.charAt(0).toUpperCase() + part.slice(1).replace(/-/g, ' ');
  breadcrumbs.push({
    "@type": "ListItem",
    "position": index + 2,
    "name": name,
    "item": builtPath.replace(/\/$/, '')
  });
});

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": breadcrumbs
};
---

<KnowledgeGraph />

<!-- 🚀 Speculation Rules API (Instant Load) -->
<script type="speculationrules" is:inline>
{
  "prerender": [
    {
      "source": "list",
      "urls": ["/join", "/learn"]
    },
    {
      "source": "document",
      "where": {
        "and": [
          { "href_matches": "/*" },
          { "not": { "href_matches": "/crm/*" } },
          { "not": { "href_matches": "/admin/*" } }
        ]
      },
      "eagerness": "moderate"
    }
  ]
}
</script>

<!-- 🗺️ Automated BreadcrumbList Schema -->
<script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} is:inline />

<!-- Global Metadata -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<meta name="generator" content={Astro.generator} />

<!-- Primary Meta Tags -->
<title>{title}</title>
<meta name="title" content={title} />
<meta name="description" content={description} />
<link rel="canonical" href={canonicalURL} />

<!-- Open Graph / Facebook -->
<meta property="og:type" content={type} />
<meta property="og:url" content={canonicalURL} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={new URL(image, Astro.url)} />

<!-- Twitter -->
<meta property="twitter:card" content="summary_large_image" />
<meta property="twitter:url" content={canonicalURL} />
<meta property="twitter:title" content={title} />
<meta property="twitter:description" content={description} />
<meta property="twitter:image" content={new URL(image, Astro.url)} />

<!-- 🕵️‍♂️ MPDC Global Attribution Tracker -->
<script is:inline src="/js/global-attribution.js" defer></script>

<!-- 📊 Google Analytics & FB Pixel (CWV Optimized Delayed Load) -->
<!-- 📊 Google Analytics & FB Pixel (Partytown Optimized) -->
<script type="text/partytown" is:inline>
  window.dataLayer = window.dataLayer || [];
  function gtag(){dataLayer.push(arguments);}
  
  // Set default consent
  const consentCookie = document.cookie.split('; ').find(row => row.startsWith('cookie_consent='));
  let initialPrefs = null;
  if (consentCookie) {
    try {
      initialPrefs = JSON.parse(decodeURIComponent(consentCookie.split('=')[1]));
    } catch (e) {}
  }

  gtag('consent', 'default', {
    'ad_storage': initialPrefs?.marketing ? 'granted' : 'denied',
    'ad_user_data': initialPrefs?.marketing ? 'granted' : 'denied',
    'ad_personalization': initialPrefs?.marketing ? 'granted' : 'denied',
    'analytics_storage': initialPrefs?.analytics ? 'granted' : 'denied'
  });

  gtag('js', new Date());
</script>

<script type="text/partytown" src="https://www.googletagmanager.com/gtag/js?id=G-T26PKTMJB1"></script>

<script type="text/partytown" is:inline define:vars={{ isStealth, isUS }}>
  // 1. GA4 Configuration
  if (isStealth) {
    gtag('config', 'G-T26PKTMJB1', { 'developer_mode': true });
  } else {
    gtag('config', 'G-T26PKTMJB1');
  }

  // 2. Load heavy trackers if consent exists or US auto-grant applies
  const consentCookie = document.cookie.split('; ').find(row => row.startsWith('cookie_consent='));
  let prefs = null;
  if (consentCookie) {
    try { prefs = JSON.parse(decodeURIComponent(consentCookie.split('=')[1])); } catch (e) {}
  }
  
  if (!prefs && isUS) {
    prefs = { analytics: true, marketing: true };
  }

  if (prefs?.marketing && !isStealth) {
    // Facebook Pixel
    !function(f,b,e,v,n,t,s)
    {if(f.fbq)return;n=f.fbq=function(){n.callMethod?
    n.callMethod.apply(n,arguments):n.queue.push(arguments)};
    if(!f._fbq)f._fbq=n;n.push=n;n.loaded=!0;n.version='2.0';
    n.queue=[];t=b.createElement(e);t.async=!0;
    t.src=v;s=b.getElementsByTagName(e)[0];
    s.parentNode.insertBefore(t,s)}(window, document,'script',
    'https://connect.facebook.net/en_US/fbevents.js');
    
    fbq('init', '1524876641955362'); 
    fbq('track', 'PageView');
  }

  if (prefs?.analytics && !isStealth) {
    // Microsoft Clarity
    (function(c,l,a,r,i,t,y){
        c[a]=c[a]||function(){(c[a].q=c[a].q||[]).push(arguments)};
        t=l.createElement(r);t.async=1;t.src="https://www.clarity.ms/tag/"+i;
        y=l.getElementsByTagName(r)[0];y.parentNode.insertBefore(t,y);
    })(window, document, "clarity", "script", "vdb5xxjl6u");
  }
</script>

<script is:inline>
  // PostHog and Event Listeners (Main Thread for UI responsiveness)
  window.addEventListener('cookie-consent-updated', (event) => {
      const prefs = event.detail;
      if (window.gtag) {
        gtag('consent', 'update', {
          'ad_storage': prefs.marketing ? 'granted' : 'denied',
          'ad_user_data': prefs.marketing ? 'granted' : 'denied',
          'ad_personalization': prefs.marketing ? 'granted' : 'denied',
          'analytics_storage': prefs.analytics ? 'granted' : 'denied'
        });
      }
      // Re-trigger Partytown script if needed
      window.dispatchEvent(new CustomEvent('pt-reload'));
  });
</script>

<noscript>
  <img height="1" width="1" style="display:none" src="https://www.facebook.com/tr?id=1524876641955362&ev=PageView&noscript=1" />
</noscript>
