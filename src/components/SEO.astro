---
export interface Props {
  title: string;
  description: string;
  image?: string;
  url?: string;
  type?: string;
}

import seoConfig from '../data/seo-config.json';

const {
  title: defaultTitle,
  description: defaultDescription,
  image = '/images/social-share.jpg', // Default image if not provided
  url = Astro.url,
  type = 'website',
} = Astro.props;

import KnowledgeGraph from './KnowledgeGraph.astro';

// 🕵️‍♂️ Dynamic Lookup (Self-Healing SEO)
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const config = (seoConfig as any)[path] || {};

const title = config.title || defaultTitle;
const description = config.description || defaultDescription;

// 🗺️ Server-Side Breadcrumb Logic
const parts = path.split('/').filter(p => p);
const breadcrumbs = [
  {
    "@type": "ListItem",
    "position": 1,
    "name": "Home",
    "item": "https://menspostdivorcecoaching.com/"
  }
];

let builtPath = "https://menspostdivorcecoaching.com/";
parts.forEach((part, index) => {
  builtPath += part + "/";
  const name = part.charAt(0).toUpperCase() + part.slice(1).replace(/-/g, ' ');
  breadcrumbs.push({
    "@type": "ListItem",
    "position": index + 2,
    "name": name,
    "item": builtPath.replace(/\/$/, '')
  });
});

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": breadcrumbs
};
---

<KnowledgeGraph />

<!-- 🚀 Speculation Rules API (Instant Load) -->
<script type="speculationrules" is:inline>
{
  "prerender": [
    {
      "source": "list",
      "urls": ["/join", "/learn"]
    },
    {
      "source": "document",
      "where": {
        "and": [
          { "href_matches": "/*" },
          { "not": { "href_matches": "/crm/*" } },
          { "not": { "href_matches": "/admin/*" } }
        ]
      },
      "eagerness": "moderate"
    }
  ]
}
</script>

<!-- 🗺️ Automated BreadcrumbList Schema -->
<script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} is:inline />

<!-- Global Metadata -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<meta name="generator" content={Astro.generator} />

<!-- Primary Meta Tags -->
<title>{title}</title>
<meta name="title" content={title} />
<meta name="description" content={description} />
<link rel="canonical" href={url} />

<!-- Open Graph / Facebook -->
<meta property="og:type" content={type} />
<meta property="og:url" content={url} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={new URL(image, Astro.url)} />

<!-- Twitter -->
<meta property="twitter:card" content="summary_large_image" />
<meta property="twitter:url" content={url} />
<meta property="twitter:title" content={title} />
<meta property="twitter:description" content={description} />
<meta property="twitter:image" content={new URL(image, Astro.url)} />

<!-- 🕵️‍♂️ MPDC Global Attribution Tracker -->
<script is:inline src="/js/global-attribution.js" defer></script>

<!-- 📊 Google Analytics & FB Pixel (CWV Optimized Delayed Load) -->
<script is:inline>
  function loadAnalytics() {
    if (window.analyticsLoaded) return;
    window.analyticsLoaded = true;

    // 🛡️ Global Stealth Mode Check (Internal Traffic Exclusion)
    const isDev = window.location.hostname === 'localhost' || window.location.hostname.includes('127.0.0.1');
    const isPortugal = Intl.DateTimeFormat().resolvedOptions().timeZone.includes('Lisbon') || 
                       Intl.DateTimeFormat().resolvedOptions().timeZone.includes('Madeira') ||
                       Intl.DateTimeFormat().resolvedOptions().timeZone.includes('Azores');
    const isStealth = isDev || isPortugal;

    if (isStealth) console.log('🕵️ Stealth Mode Active: Internal tracking paused.');

    // 1. Load Google Analytics (GA4)
    const gaScript = document.createElement('script');
    gaScript.async = true;
    gaScript.src = "https://www.googletagmanager.com/gtag/js?id=G-T26PKTMJB1";
    document.head.appendChild(gaScript);

    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());

    if (isStealth) {
      gtag('config', 'G-T26PKTMJB1', { 'developer_mode': true });
    } else {
      gtag('config', 'G-T26PKTMJB1');
    }
    console.log('📊 GA4: Initialized (Delayed)');

    // 2. Load Facebook Pixel
    if (!isStealth) {
      !function(f,b,e,v,n,t,s)
      {if(f.fbq)return;n=f.fbq=function(){n.callMethod?
      n.callMethod.apply(n,arguments):n.queue.push(arguments)};
      if(!f._fbq)f._fbq=n;n.push=n;n.loaded=!0;n.version='2.0';
      n.queue=[];t=b.createElement(e);t.async=!0;
      t.src=v;s=b.getElementsByTagName(e)[0];
      s.parentNode.insertBefore(t,s)}(window, document,'script',
      'https://connect.facebook.net/en_US/fbevents.js');
      
      fbq('init', '1524876641955362'); 
      fbq('track', 'PageView');
      console.log('🔵 FB Pixel: Initialized (Delayed)');
    } else {
      console.log('🔵 FB Pixel: Bypassed for Stealth Mode');
    }
  }

  // Fire on 3s delay OR first interaction to protect Core Web Vitals
  window.addEventListener('load', () => {
    setTimeout(loadAnalytics, 3000);
  });
  window.addEventListener('scroll', loadAnalytics, { once: true, passive: true });
  window.addEventListener('mousedown', loadAnalytics, { once: true });
</script>

<noscript>
  <img height="1" width="1" style="display:none" src="https://www.facebook.com/tr?id=1524876641955362&ev=PageView&noscript=1" />
</noscript>
</noscript>
