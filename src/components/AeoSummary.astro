---
interface Props {
    title?: string;
    text: string;
}

const { title = "Expert Summary", text } = Astro.props;
---

<div class="aeo-summary-box">
    <span class="aeo-badge">{title}</span>
    <p class="aeo-text">
        <slot />
        {text}
    </p>
</div>

<style>
    .aeo-summary-box {
        background: rgba(196, 97, 58, 0.05);
        border: 1px solid rgba(196, 97, 58, 0.2);
        border-radius: 8px;
        padding: 1.5rem;
        margin: 2rem 0;
        position: relative;
        text-align: left;
    }
    .aeo-badge {
        position: absolute;
        top: -10px;
        left: 20px;
        background: #C4613A; /* Burnt Copper */
        color: #fff;
        font-size: 0.65rem;
        font-weight: 800;
        padding: 2px 8px;
        border-radius: 4px;
        text-transform: uppercase;
        letter-spacing: 1px;
        font-family: 'Montserrat', sans-serif;
    }
    .aeo-text {
        color: #475569;
        font-size: 0.95rem;
        line-height: 1.6;
        font-weight: 500;
        margin: 0;
        font-family: 'Open Sans', sans-serif;
    }
    :global(.aeo-text strong) {
        color: #0b3b36;
        font-weight: 700;
    }
</style>
