rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // User Profiles - Users can only read/write their own profile
    match /profiles/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if request.auth != null && request.auth.uid == userId;
      // Allow server-side writes from Cloud Functions
      allow write: if request.auth == null;
    }
    
    // Support Tickets - Users can create and read their own tickets
    match /support_tickets/{ticketId} {
      allow create: if request.auth != null;
      allow read: if request.auth != null && resource.data.userId == request.auth.uid;
    }
    
    // Leads - Allow creation only (for marketing forms)
    match /leads/{leadId} {
      allow create: if true; // Public form submission
      allow read: if true; // Dashboard needs to show live feed
      allow update, delete: if false; 
    }

    // Video Events - Analytics tracking
    match /video_events/{eventId} {
      allow create: if true; // Public tracking
      allow read: if true; // Dashboard reading
    }
    
    // Schema Injections - CMS settings
    match /schema_injections/{nodeId} {
      allow read: if true; // Public can see active schemas
      allow write: if false; 
    }
    
    // Default: Deny all access to any other collections
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
