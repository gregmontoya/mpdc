RewriteEngine On

# 1. Redirect /index.html to /
RewriteCond %{THE_REQUEST} /index\.html [NC]
RewriteRule ^(.*?)index\.html$ /$1 [L,R=301,NC,NE]

# 2. Redirect .html requests to clean URLs (e.g. /about.html -> /about)
# Only redirect if it's not a real file that exists (like images mapping to something else)
# or if it's one of the main pages we know we've migrated.
RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s([^.]+)\.html [NC]
RewriteRule ^ %1 [R=301,L]

# 3. Internally route clean URLs to the Astro folder structure
# Astro with build.format 'directory' creates:
# /about -> /about/index.html
# /contact -> /contact/index.html

# If the request is for a clean URL (no extension), and a corresponding folder/index.html exists:
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{DOCUMENT_ROOT}/%1/index.html -f [OR]
RewriteCond %{REQUEST_FILENAME}/index.html -f
RewriteRule ^(.*)$ $1/index.html [L]

# 4. Handle files that might still be legacy but we want to keep
# If a file exists, just serve it
RewriteCond %{REQUEST_FILENAME} -f
RewriteRule . - [L]
