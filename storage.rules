rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Allow public read for the streaming and hypnosis folders
    match /streaming/{allPaths=**} {
      allow read: if true;
    }
    match /hypnosis/{allPaths=**} {
      allow read: if true;
    }
    // Masters should remain private
    match /masters/{allPaths=**} {
      allow read: if request.auth != null;
    }
    // Fallback for everything else
    match /{allPaths=**} {
      allow read, write: if request.auth != null;
    }
  }
}

